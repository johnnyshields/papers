import SkewCornerDescent.SimpleExtensionConstants
import SkewCornerDescent.Matrix.ResidueGeneratorDerivation

/-!
# The ordinary coefficient field of one surviving original generator

Supports `shields-2026-skew-corner-descent.tex` (`prop:normal-interface`).
All other surviving indices, including higher ones, generate the coefficient
field. The actual partial derivative has exactly this kernel, and the omitted
generator is transcendental over it. Sorry-free.
-/

namespace SkewCornerDescent.Matrix

/-- The coefficient field contains every surviving original generator except
one distinguished index, including indices above it. -/
noncomputable def residueGeneratorCoefficientField (N : ℕ+) (j : {j : ℕ+ // j ≠ N}) :
    Subfield (OtherField N) :=
  Subfield.closure (residueGenerator N '' {k | k ≠ j})

/-- Every coefficient-field fraction is fixed by the original partial derivative. -/
theorem residueGeneratorCoefficientField_fixed (N : ℕ+) (j : {j : ℕ+ // j ≠ N})
    (f : residueGeneratorCoefficientField N j) :
    residueGeneratorDeriv N j (f : OtherField N) = 0 := by
  have hle : residueGeneratorCoefficientField N j ≤
      derivationConstantField (residueGeneratorDeriv N j) := by
    apply Subfield.closure_le.mpr
    rintro x ⟨k, hkj, rfl⟩
    change residueGeneratorDeriv N j (residueGenerator N k) = 0
    rw [residueGeneratorDeriv_generator, ite_eq_right hkj]
  exact hle f.property

/-- The full actual residue fraction field is generated by this coefficient
field and the omitted original generator. -/
theorem residueGeneratorCoefficientField_adjoin (N : ℕ+) (j : {j : ℕ+ // j ≠ N}) :
    IntermediateField.adjoin (residueGeneratorCoefficientField N j) {residueGenerator N j} = ⊤ := by
  classical
  let B := residueGeneratorCoefficientField N j
  let L := IntermediateField.adjoin B {residueGenerator N j}
  have hg (k : {k : ℕ+ // k ≠ N}) : residueGenerator N k ∈ L := by
    by_cases hk : k = j
    · rw [hk]
      exact IntermediateField.subset_adjoin B _ (Set.mem_singleton _)
    · have hb : residueGenerator N k ∈ B := Subfield.subset_closure ⟨k, hk, rfl⟩
      exact L.algebraMap_mem ⟨residueGenerator N k, hb⟩
  have hp (p : OtherPolynomial N) : algebraMap (OtherPolynomial N) (OtherField N) p ∈ L := by
    induction p using MvPolynomial.induction_on with
    | C q =>
      rw [show algebraMap (OtherPolynomial N) (OtherField N) (MvPolynomial.C q) =
          algebraMap ℚ (OtherField N) q from
        RingHom.map_rat_algebraMap (algebraMap (OtherPolynomial N) (OtherField N)) q]
      exact SubfieldClass.ratCast_mem L.toSubfield q
    | add p q hp hq =>
      rw [map_add]
      exact L.add_mem hp hq
    | mul_X p k hp =>
      rw [map_mul]
      exact L.mul_mem hp (hg k)
  change L = ⊤
  apply top_unique
  intro f _
  obtain ⟨p, q, _, rfl⟩ := IsFractionRing.div_surjective (OtherPolynomial N) f
  exact L.div_mem (hp p) (hp q)

/-- The omitted generator remains transcendental even over all other surviving
generators, not just those of smaller index. -/
theorem residueGeneratorCoefficientField_transcendental (N : ℕ+)
    (j : {j : ℕ+ // j ≠ N}) :
    Transcendental (residueGeneratorCoefficientField N j) (residueGenerator N j) := by
  let : Algebra ℚ (OtherField N) := OreLocalization.instAlgebra
  let s := residueGenerator N '' {k | k ≠ j}
  have he : residueGeneratorCoefficientField N j =
      (IntermediateField.adjoin ℚ s).toSubfield := by
    apply le_antisymm
    · exact Subfield.closure_le.mpr (IntermediateField.subset_adjoin ℚ s)
    · apply IntermediateField.adjoin_le_subfield
      · rintro x ⟨q, rfl⟩
        have hrat : algebraMap ℚ (OtherField N) = Rat.castHom (OtherField N) :=
          Subsingleton.elim _ _
        rw [hrat]
        exact SubfieldClass.ratCast_mem (residueGeneratorCoefficientField N j) q
      · exact Subfield.subset_closure
  rw [he]
  exact IntermediateField.transcendental_adjoin_iff.mpr
    ((residue_generators_independent N).transcendental_adjoin
      (s := {k | k ≠ j}) (i := j) (by simp))

/-- The kernel is exactly the standard coefficient field, not merely the field
of generators strictly below the distinguished index. -/
theorem residueGeneratorDeriv_eq_zero_iff (N : ℕ+) (j : {j : ℕ+ // j ≠ N})
    (f : OtherField N) : residueGeneratorDeriv N j f = 0 ↔
      f ∈ residueGeneratorCoefficientField N j := by
  constructor
  · intro hf
    exact simple_extension_derivation_constants (residueGeneratorDeriv N j)
      (residueGeneratorCoefficientField N j) (residueGeneratorCoefficientField_fixed N j)
      (residueGenerator N j) f (by simp)
      (by rw [residueGeneratorCoefficientField_adjoin]; trivial) hf
  · intro hf
    exact residueGeneratorCoefficientField_fixed N j ⟨f, hf⟩

end SkewCornerDescent.Matrix
