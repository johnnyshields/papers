import SkewCornerDescent.Matrix.RegularResidue
import SkewCornerDescent.RationalPoles
import Mathlib.RingTheory.AlgebraicIndependent.AlgebraicClosure
import Mathlib.Algebra.Algebra.Rat

/-!
# Protected original generators in the residue field

Supports `shields-2026-skew-corner-descent.tex`, «Equal windows and the determinant defect»
(`sec:normal-chart`, `lem:residue-classifier`). Original generators other than the selected
top remain independent after taking the actual residue. Full rational lower corrections and
nonzero lower divisors preserve the protected top. Sorry-free.
-/

namespace SkewCornerDescent.Matrix

noncomputable local instance (N : ℕ+) : Algebra ℚ (OtherField N) := OreLocalization.instAlgebra

/-- The surviving original generator in the actual residue coefficient field. -/
noncomputable def residueGenerator (N : ℕ+) (j : {j : ℕ+ // j ≠ N}) : OtherField N :=
  algebraMap (OtherPolynomial N) (OtherField N) (MvPolynomial.X j)

/-- The complete rational field generated by surviving original indices below the top. -/
noncomputable def residueLowerField (N K : ℕ+) : Subfield (OtherField N) :=
  (IntermediateField.adjoin ℚ
    (residueGenerator N '' {j : {j : ℕ+ // j ≠ N} | j.1 < K})).toSubfield

/-- The residue has imposed only the selected prime relation, not relations among the
remaining original generators. -/
theorem residue_generators_independent (N : ℕ+) :
    AlgebraicIndependent ℚ (residueGenerator N) := by
  let f : OtherPolynomial N →ₐ[ℚ] OtherField N :=
    { algebraMap (OtherPolynomial N) (OtherField N) with
      commutes' := RingHom.map_rat_algebraMap (algebraMap _ _) }
  exact (MvPolynomial.algebraicIndependent_X {j : ℕ+ // j ≠ N} ℚ).map'
    (f := f) (IsFractionRing.injective _ _)

/-- A surviving original top is transcendental over all strictly lower residue fractions. -/
theorem residue_generator_transcendental (N : ℕ+) (j : {j : ℕ+ // j ≠ N}) :
    Transcendental (residueLowerField N j.1) (residueGenerator N j) := by
  have h := (residue_generators_independent N).transcendental_adjoin
    (s := {k : {k : ℕ+ // k ≠ N} | k.1 < j.1}) (i := j) (by simp)
  exact IntermediateField.transcendental_adjoin_iff.mpr h

/-- The protected top survives its full rational lower correction and cap quotient. -/
theorem residue_triangular_quotient_transcendental (N : ℕ+)
    (j : {j : ℕ+ // j ≠ N}) (A F : OtherField N)
    (hA : A ∈ residueLowerField N j.1) (hF : F ∈ residueLowerField N j.1) (hF0 : F ≠ 0) :
    Transcendental (residueLowerField N j.1) ((residueGenerator N j + A) / F) := by
  let a : residueLowerField N j.1 := ⟨A, hA⟩
  let f : residueLowerField N j.1 := ⟨F, hF⟩
  have hf : f ≠ 0 := fun h => hF0 (congrArg Subtype.val h)
  have hfi : f⁻¹ ≠ 0 := inv_ne_zero hf
  have h := (residue_generator_transcendental N j).aeval
    (Polynomial.C f⁻¹ * Polynomial.X + Polynomial.C (a / f))
    (by rw [Polynomial.natDegree_linear hfi]; exact one_ne_zero)
    (by rw [Polynomial.leadingCoeff_linear hfi]; exact mem_nonZeroDivisors_of_ne_zero hfi)
  have he : Polynomial.aeval (residueGenerator N j)
      (Polynomial.C f⁻¹ * Polynomial.X + Polynomial.C (a / f)) =
      (residueGenerator N j + A) / F := by
    simp only [Polynomial.aeval_add, Polynomial.aeval_mul, Polynomial.aeval_C,
      Polynomial.aeval_X, map_inv₀, map_div₀, Subfield.algebraMap_ofSubfield]
    change F⁻¹ * residueGenerator N j + A / F = (residueGenerator N j + A) / F
    ring
  rwa [he] at h

namespace SelectedCoordinate

open SkewGluing

variable {D : Diagram} {hD : IsConnectedSkew D} (c : SelectedCoordinate D hD)

/-- This protected variable is the residue of the actual original generator. -/
theorem residue_original_generator_transcendental (j : ℕ+) (hj : j ≠ c.top) :
    Transcendental (residueLowerField c.top j) (c.residueMap (MvPolynomial.X j)) := by
  rw [c.residueMap_other j hj]
  exact residue_generator_transcendental c.top ⟨j, hj⟩

end SelectedCoordinate
end SkewCornerDescent.Matrix
