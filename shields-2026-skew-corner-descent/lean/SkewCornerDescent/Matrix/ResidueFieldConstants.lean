import SkewCornerDescent.Matrix.ResiduePlaneIrreducibility
import SkewCornerDescent.PlanePolynomialAffine

/-!
# Rational constant field of the complete actual residue

Supports `shields-2026-skew-corner-descent.tex`, «Actual responses and residue classes»
(`sec:normal-chart`, `lem:residue-classifier`). The full actual residue field is generated
by the surviving original generators. Their algebraic independence excludes new
algebraic constants, also before restricting to a protected lower field.

Sorry-free.
-/

namespace SkewCornerDescent.Matrix

open MvPolynomial

noncomputable local instance fullResidueConstantsRatAlgebra (N : ℕ+) :
    Algebra ℚ (OtherField N) := OreLocalization.instAlgebra

/-- Every actual residue fraction lies in the field generated by its surviving variables. -/
theorem residueField_mem_adjoin_generators (N : ℕ+) (z : OtherField N) :
    z ∈ IntermediateField.adjoin ℚ (Set.range (residueGenerator N)) := by
  let S := IntermediateField.adjoin ℚ (Set.range (residueGenerator N))
  have hpoly (p : OtherPolynomial N) : algebraMap (OtherPolynomial N) (OtherField N) p ∈ S := by
    induction p using MvPolynomial.induction_on with
    | C c =>
      have he := map_ratCast
        ((algebraMap (OtherPolynomial N) (OtherField N)).comp MvPolynomial.C) c
      change algebraMap (OtherPolynomial N) (OtherField N) (C c) = (c : OtherField N) at he
      rw [he]
      exact SubfieldClass.ratCast_mem S c
    | add p q hp hq =>
      rw [map_add]
      exact S.add_mem hp hq
    | mul_X p j hp =>
      rw [map_mul]
      exact S.mul_mem hp (IntermediateField.subset_adjoin ℚ _ ⟨j, rfl⟩)
  obtain ⟨p, q, _, hz⟩ := IsFractionRing.div_surjective (OtherPolynomial N) z
  rw [← hz]
  exact S.div_mem (hpoly p) (hpoly q)

/-- The actual full residue field has precisely the rational algebraic constants. -/
theorem residueField_algebraic_constants (N : ℕ+) (z : OtherField N)
    (hz : IsAlgebraic ℚ z) : ∃ c : ℚ, algebraMap ℚ (OtherField N) c = z :=
  algebraic_constant_of_mem_adjoin (residue_generators_independent N)
    (residueField_mem_adjoin_generators N z) hz

/-- Rational irreducibility survives in the complete actual residue field. -/
theorem residueField_irreducible_map (N : ℕ+) {p : Polynomial ℚ}
    (hp : p.Monic) (hirr : Irreducible p) :
    Irreducible (p.map (algebraMap ℚ (OtherField N))) :=
  irreducible_map_of_algebraic_constants (residueField_algebraic_constants N) hp hirr

/-- A genuine cap-scaled rational plane factor stays irreducible over the actual residue field. -/
theorem residueField_clearedPlane_irreducible (N : ℕ+) {p : Polynomial ℚ}
    (hp : p.Monic) (hirr : Irreducible p) (A F : OtherField N) (hF : F ≠ 0) :
    Irreducible (clearedPlanePolynomial p A F) :=
  clearedPlanePolynomial_irreducible A F hF (residueField_irreducible_map N hp hirr)

end SkewCornerDescent.Matrix
