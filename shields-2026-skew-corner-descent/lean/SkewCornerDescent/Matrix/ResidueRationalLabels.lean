import SkewCornerDescent.Matrix.ResidueProtectedGenerator
import SkewCornerDescent.TranscendentalConstants

/-!
# Rational labels in the actual lower residue field

Supports `shields-2026-skew-corner-descent.tex`, «Actual responses and residue classes»
(`sec:normal-chart`, `lem:residue-classifier`). Roots of rational irreducible plane
polynomials in the actual lower generator field are rational, and their polynomials
have degree one. No independent response variables are introduced.

Sorry-free.
-/

namespace SkewCornerDescent.Matrix

noncomputable local instance rationalLabelRatAlgebra (N : ℕ+) :
    Algebra ℚ (OtherField N) := OreLocalization.instAlgebra

/-- The actual lower field is generated by a genuinely independent surviving family. -/
theorem residue_lower_generators_independent (N K : ℕ+) :
    AlgebraicIndependent ℚ
      (fun j : {j : {j : ℕ+ // j ≠ N} // j.val < K} => residueGenerator N j.val) :=
  (residue_generators_independent N).comp Subtype.val Subtype.val_injective

/-- An algebraic label in the complete actual lower field is a rational constant. -/
theorem residueLowerField_algebraic_constant (N K : ℕ+) {z : OtherField N}
    (hz : z ∈ residueLowerField N K) (ha : IsAlgebraic ℚ z) :
    ∃ c : ℚ, (c : OtherField N) = z := by
  have hz' : z ∈ IntermediateField.adjoin ℚ
      (Set.range (fun j : {j : {j : ℕ+ // j ≠ N} // j.val < K} =>
        residueGenerator N j.val)) := by
    have hs : residueGenerator N '' {j : {j : ℕ+ // j ≠ N} | j.val < K} =
        Set.range (fun j : {j : {j : ℕ+ // j ≠ N} // j.val < K} =>
          residueGenerator N j.val) := by
      ext y
      constructor
      · rintro ⟨j, hj, rfl⟩
        exact ⟨⟨j, hj⟩, rfl⟩
      · rintro ⟨j, rfl⟩
        exact ⟨j.val, j.prop, rfl⟩
    change z ∈ IntermediateField.adjoin ℚ
      (residueGenerator N '' {j : {j : ℕ+ // j ≠ N} | j.val < K}) at hz
    exact hs ▸ hz
  obtain ⟨c, hc⟩ :=
    algebraic_constant_of_mem_adjoin (residue_lower_generators_independent N K) hz' ha
  refine ⟨c, ?_⟩
  exact (map_ratCast (algebraMap ℚ (OtherField N)) c).symm.trans hc

/-- A rational irreducible plane factor with a root in the actual lower field is linear. -/
theorem residueLowerField_irreducible_root (N K : ℕ+) {z : OtherField N}
    (hz : z ∈ residueLowerField N K) {p : Polynomial ℚ}
    (hp : Irreducible p) (hr : Polynomial.aeval z p = 0) :
    p.natDegree = 1 ∧ ∃ c : ℚ, (c : OtherField N) = z ∧ p.IsRoot c := by
  obtain ⟨c, hc⟩ := residueLowerField_algebraic_constant N K hz ⟨p, hp.ne_zero, hr⟩
  have hmap : algebraMap ℚ (OtherField N) c = z :=
    (map_ratCast (algebraMap ℚ (OtherField N)) c).trans hc
  have hroot : p.IsRoot c :=
    Polynomial.isRoot_of_aeval_algebraMap_eq_zero (hmap.symm ▸ hr)
  exact ⟨Polynomial.natDegree_eq_of_degree_eq_some
    (Polynomial.degree_eq_one_of_irreducible_of_root hp hroot), c, hc, hroot⟩

/-- A linear response divisor forces a rational plane label and a full correction identity.
The root and the degree-one conclusion are derived from divisibility, not carried as inputs. -/
theorem residue_plane_linear_divisor (N K : ℕ+) {A B F : OtherField N}
    (hA : A ∈ residueLowerField N K) (hB : B ∈ residueLowerField N K)
    (hF : F ∈ residueLowerField N K) (hF0 : F ≠ 0) {p : Polynomial ℚ}
    (hp : Irreducible p)
    (hd : Polynomial.X + Polynomial.C B ∣
      (p.map (algebraMap ℚ (OtherField N))).comp
        ((Polynomial.X + Polynomial.C A) * Polynomial.C F⁻¹)) :
    p.natDegree = 1 ∧ ∃ c : ℚ, p.IsRoot c ∧ B = A - (c : OtherField N) * F := by
  have hz : (A - B) / F ∈ residueLowerField N K :=
    (residueLowerField N K).div_mem ((residueLowerField N K).sub_mem hA hB) hF
  have hr : Polynomial.aeval ((A - B) / F) p = 0 := by
    have h := Polynomial.eval_eq_zero_of_dvd_of_eval_eq_zero (x := -B) hd
      (by simp only [Polynomial.eval_add, Polynomial.eval_X, Polynomial.eval_C,
        neg_add_cancel])
    simpa only [Polynomial.eval_comp, Polynomial.eval_mul, Polynomial.eval_add,
      Polynomial.eval_X, Polynomial.eval_C, Polynomial.eval_map, ← Polynomial.aeval_def,
      neg_add_eq_sub, div_eq_mul_inv] using h
  obtain ⟨hdeg, c, hc, hroot⟩ := residueLowerField_irreducible_root N K hz hp hr
  refine ⟨hdeg, c, hroot, ?_⟩
  have hcF : (c : OtherField N) * F = A - B := (eq_div_iff hF0).mp hc
  rw [hcF]
  ring

end SkewCornerDescent.Matrix
