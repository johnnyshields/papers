import SkewBase.BandGeometry
import SkewBase.ForwardGeneration

/-!
# Searches S and B: `def:searches`, `thm:searches`

Formalizes `shields-2026-skew-base-computational.tex`, «The geometry of a chart and two complete
searches» (`sec:roots`): the two searches of `def:searches` and the first two sentences of the
proof of `thm:searches`: each search returns exactly the proper charts of `F`.

`F` is a connected skew diagram with `sw F = (0, 0)` (the paper translates `F` so that its least
content is `0`), `N_F = span F`, and a chart is a pair of an outer `D` and a marked inner `ω`.
The returned charts are in normalized position: `sw D = (0, 0)` and `sw E = (0, 0)`, the position
in which the generation of `lem:heights` and the subdiagram `S ⊆ F` translated to the origin
produce them.  Every proper chart of a translate of `F` is a translate of a returned chart
(`exists_searchS_of_isChartOf`, `exists_searchB_of_isChartOf`).

* `SearchS F`: every connected skew subdiagram `S ⊆ F` with `|S| ≥ 2`, `E` its translate to the
  origin, every legal mark of `E` whose period `q` divides `N_F - N_E` with
  `N_D = (N_F - N_E) / q + 1 ≥ 2`, the heights of `eq:private` required to agree for all `w'`, and
  every connected `D` generated by `lem:heights` from those heights, keeping `D ∘_ω E = F`.
* `SearchB F`: every `q ∈ [2, ⌊N_F / 2⌋]` with `w = N_F mod q` and `N_D = ⌊N_F / q⌋`, the two
  differences of `eq:private` independent of `w'`, the inner `E` formed from the bottom and top
  bands, the legal marks of `E` of period `q`, the outer of `cor:outer` in cases (a) and (b), and,
  in cases (c) and (d), every copy `E + t v ± k e` inside `F` and every connected `D` with the
  heights of `eq:private`, keeping `D ∘_ω E = F`.

Sorry-free.
-/

namespace SkewBase

open SkewGluing

/-! ### The private heights and rows -/

/-- The heights of the outer read off `F` at the private content `t q + w` (`eq:private`):
`H_F(t q + w) - H_F(w) + 1`. -/
def privateHeight (F : Diagram) (q w t : ℤ) : ℤ := height F (t * q + w) - height F w + 1

/-- The offsets `κ_t - κ_0` read off `F` (`eq:private`): `a_F(t q + w) - a_F(w)`. -/
def privateRow (F : Diagram) (q w t : ℤ) : ℤ := diagLo F (t * q + w) - diagLo F w

/-- The height difference of `eq:private` is independent of `w' ∈ [w, q - 1]`, for `t < N`. -/
def PrivateHeightsAgree (F : Diagram) (q w N : ℤ) : Prop :=
  ∀ t w' : ℤ, 0 ≤ t → t < N → w ≤ w' → w' ≤ q - 1 →
    height F (t * q + w') - height F w' = height F (t * q + w) - height F w

/-- The row difference of `eq:private` is independent of `w' ∈ [w, q - 1]`, for `t < N`. -/
def PrivateRowsAgree (F : Diagram) (q w N : ℤ) : Prop :=
  ∀ t w' : ℤ, 0 ≤ t → t < N → w ≤ w' → w' ≤ q - 1 →
    diagLo F (t * q + w') - diagLo F w' = diagLo F (t * q + w) - diagLo F w

/-- The outers generated by `lem:heights` from the private heights: the connected skew diagrams
of the recursion with `N` contents. -/
def heightCandidates (F : Diagram) (q w N : ℤ) : Set Diagram :=
  {D | IsConnectedSkew D ∧ HeightRecursion N.toNat (privateHeight F q w) D}

/-! ### Search S -/

/-- The number of contents of the outer in search S: `N_D = (N_F - N_E) / q + 1`. -/
def outerSpanS (F : Diagram) (ω : MarkedInner) : ℤ :=
  ((span F : ℤ) - span ω.E) / ω.period + 1

/-- **Search S** (`def:searches`).  The charts `(D, ω)` found by running over the connected skew
subdiagrams `S ⊆ F` with at least two cells, `E` the translate of `S` to the origin, the legal
marks of `E` of period `q` dividing `N_F - N_E` with `N_D = (N_F - N_E) / q + 1 ≥ 2`, the heights
of `eq:private` (required to agree for all `w'`), and the connected `D` generated from them by
`lem:heights`; those with `D ∘_ω E = F` are kept. -/
def SearchS (F : Diagram) : Set Chart :=
  {χ | (∃ S, S ⊆ F ∧ IsConnectedSkew S ∧ 2 ≤ S.card ∧ χ.ω.E = normalize S) ∧
    χ.ω.IsLegal ∧ χ.ω.period ∣ (span F : ℤ) - span χ.ω.E ∧ 2 ≤ outerSpanS F χ.ω ∧
    PrivateHeightsAgree F χ.ω.period χ.ω.width (outerSpanS F χ.ω) ∧
    χ.D ∈ heightCandidates F χ.ω.period χ.ω.width (outerSpanS F χ.ω) ∧ χ.parent = F}

/-! ### Search B -/

/-- The least cell on content `c` of `F`. -/
def leastCell (F : Diagram) (c : ℤ) : ℤ × ℤ := (diagLo F c, diagLo F c + c)

/-- The cells of `F` on the contents `[0, q - 1]`. -/
def bottomBand (F : Diagram) (q : ℤ) : Diagram :=
  F.filter fun x => 0 ≤ content x ∧ content x < q

/-- The cells of `F` on the contents `[N_F - q, N_F - 1]`, translated so that content `N_F - q`
falls on content `w = N_F mod q`, with its least cell on the least cell of `F` there. -/
def topBand (F : Diagram) (q : ℤ) : Diagram :=
  translate (leastCell F ((span F : ℤ) % q) - leastCell F ((span F : ℤ) - q))
    (F.filter fun x => (span F : ℤ) - q ≤ content x)

/-- The inner `E` of search B: the union of the two bands. -/
def bandInner (F : Diagram) (q : ℤ) : Diagram := bottomBand F q ∪ topBand F q

/-- The two bands agree on the contents `[w, q - 1]`. -/
def BandsAgree (F : Diagram) (q : ℤ) : Prop :=
  ∀ x : ℤ × ℤ, (span F : ℤ) % q ≤ content x → content x ≤ q - 1 →
    (x ∈ bottomBand F q ↔ x ∈ topBand F q)

/-- The outer of `cor:outer` in case (a): the rows `[ℓ_t, ℓ_t + H_t - 1]` with
`ℓ_t = (κ_t - κ_0) - t v₁`. -/
def corOuterA (F : Diagram) (q w N v₁ : ℤ) : Diagram :=
  diagramOfRows N.toNat (fun t => privateRow F q w t - t * v₁)
    (fun t => privateRow F q w t - t * v₁ + privateHeight F q w t - 1)

/-- The outer of `cor:outer` in case (b): the rows `[u_t - H_t + 1, u_t]` with
`u_t = t v₁ - (κ_t - κ_0)`. -/
def corOuterB (F : Diagram) (q w N v₁ : ℤ) : Diagram :=
  diagramOfRows N.toNat (fun t => t * v₁ - privateRow F q w t - privateHeight F q w t + 1)
    (fun t => t * v₁ - privateRow F q w t)

/-- The pruning of cases (c) and (d): every copy `E + t v + k e` (case (c)), respectively
`E + t v - k e` (case (d)), `0 ≤ k < H_t`, lies in `F`.  The inner `E` sits on its lowest band, so
the offset `s₀` of the paper is `0`. -/
def CopiesInF (F : Diagram) (ω : MarkedInner) (q w N : ℤ) : Prop :=
  ∀ t k : ℤ, 0 ≤ t → t < N → 0 ≤ k → k < privateHeight F q w t →
    translate (t • ω.v + (if ω.case = .c then k else -k) • eCell) ω.E ⊆ F

/-- The outer of search B for the mark `ω`: that of `cor:outer` in cases (a) and (b); in cases (c)
and (d), any connected `D` with the heights of `eq:private`, once every copy lies in `F`. -/
def SearchBOuter (F : Diagram) (ω : MarkedInner) (q w N : ℤ) (D : Diagram) : Prop :=
  match ω.case with
  | .a => D = corOuterA F q w N ω.v.1
  | .b => D = corOuterB F q w N ω.v.1
  | .c => CopiesInF F ω q w N ∧ D ∈ heightCandidates F q w N
  | .d => CopiesInF F ω q w N ∧ D ∈ heightCandidates F q w N

/-- **Search B at period `q`** (`def:searches`). -/
def SearchBAt (F : Diagram) (q : ℤ) : Set Chart :=
  {χ | χ.ω.period = q ∧
    PrivateHeightsAgree F q ((span F : ℤ) % q) ((span F : ℤ) / q) ∧
    PrivateRowsAgree F q ((span F : ℤ) % q) ((span F : ℤ) / q) ∧
    BandsAgree F q ∧ χ.ω.E = bandInner F q ∧ IsConnectedSkew χ.ω.E ∧ χ.ω.IsLegal ∧
    SearchBOuter F χ.ω q ((span F : ℤ) % q) ((span F : ℤ) / q) χ.D ∧
    IsConnectedSkew χ.D ∧ χ.parent = F}

/-- **Search B** (`def:searches`): the charts found for `q = 2, …, ⌊N_F / 2⌋`. -/
def SearchB (F : Diagram) : Set Chart :=
  {χ | ∃ q : ℤ, 2 ≤ q ∧ q ≤ (span F : ℤ) / 2 ∧ χ ∈ SearchBAt F q}

/-! ### Soundness -/

theorem span_le_card (D : Diagram) : span D ≤ D.card := Finset.card_image_le

/-- The outer of a chart whose composite has span `N_F` has span `(N_F - N_E) / q + 1`. -/
theorem outerSpanS_eq {ω : MarkedInner} (hω : ω.IsLegal) {D : Diagram} (hD : IsConnectedSkew D) :
    outerSpanS (ω.compose D) ω = span D := by
  have h1 := span_compose_eq hω hD
  have h2 := span_inner_eq hω
  have hq := period_pos hω
  unfold outerSpanS
  have : (span (ω.compose D) : ℤ) - span ω.E = (span D - 1 : ℤ) * ω.period := by
    rw [h1, h2]; ring
  rw [this, Int.mul_ediv_cancel _ hq.ne']
  ring

/-- Two cells of the inner give at least two contents: `|E| ≥ 2` for a legal mark with period at
least two. -/
theorem two_le_card_of_two_le_period {ω : MarkedInner} (hω : ω.IsLegal) (hq : 2 ≤ ω.period) :
    2 ≤ ω.E.card := by
  have h := span_inner_eq hω
  have hw : (0 : ℤ) ≤ ω.width := by positivity
  have := span_le_card ω.E
  omega

/-- **Search S is sound.**  Every chart returned by search S is a proper chart of `F`. -/
theorem searchS_sound {F : Diagram} {χ : Chart} (h : χ ∈ SearchS F) :
    χ.IsProperLegal ∧ χ.parent = F := by
  obtain ⟨⟨S, -, -, hS2, hE⟩, hω, -, h2, -, ⟨hD, -⟩, hP⟩ := h
  refine ⟨⟨hD, ?_, ?_, hω⟩, hP⟩
  · have hP' : χ.ω.compose χ.D = F := hP
    rw [← hP', outerSpanS_eq hω hD] at h2
    have := span_le_card χ.D
    omega
  · rw [hE]
    unfold normalize translate
    rw [Finset.card_image_of_injective _ (add_left_injective _)]
    exact hS2

/-- **Search B is sound.**  Every chart returned by search B is a proper chart of `F`. -/
theorem searchB_sound {F : Diagram} {χ : Chart} (h : χ ∈ SearchB F) :
    χ.IsProperLegal ∧ χ.parent = F := by
  obtain ⟨q, hq2, hq, hq', -, -, -, -, hE, hω, -, hD, hP⟩ := h
  refine ⟨⟨hD, ?_, ?_, hω⟩, hP⟩
  · have hP' : χ.ω.compose χ.D = F := hP
    have := (width_eq_span_mod hω hD).2
    rw [hP'] at this
    have hqpos : 0 < χ.ω.period := period_pos hω
    have h2 : 2 ≤ (span F : ℤ) / χ.ω.period := by
      rw [hq']
      exact (Int.le_ediv_iff_mul_le (by omega)).mpr (by omega)
    have := span_le_card χ.D
    omega
  · exact two_le_card_of_two_le_period hω (by omega)

end SkewBase
