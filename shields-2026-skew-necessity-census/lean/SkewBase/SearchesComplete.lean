import SkewBase.Searches

/-!
# Completeness of the searches S and B

Formalizes `shields-2026-skew-base-computational.tex`, «The geometry of a chart and two complete
searches» (`sec:roots`): the proof of `thm:searches` that every proper chart of `F` is returned
by search S and by search B.

For a chart `(D, ω)` with `sw D = (0, 0)` and `sw E = (0, 0)`, `eq:private` reads the heights
and offsets of the outer off the composite (`privateHeight_eq_height`, `privateRow_eq`), so that
search S meets the subdiagram `E ⊆ F` and generates `D` by `lem:heights`
(`searchS_complete`).  Search B reconstructs `E` from the bottom and top bands of `F`
(`bandInner_eq`) and `D` from `cor:outer` or from its copies (`searchB_complete`).

Sorry-free.
-/

namespace SkewBase

open SkewGluing

variable {ω : MarkedInner} {D : Diagram}

theorem mem_contents_of_lt (hD : IsConnectedSkew D) (hD0 : minContent D = 0) {t : ℤ}
    (h0 : 0 ≤ t) (h1 : t < span D) : t ∈ contents D := by
  have hs := isConnectedSkew_iff_diagonal.mp hD
  have hsp := span_eq_of_isConnectedSkew hD
  rw [hs.mem_contents_iff]
  omega

theorem normalize_of_sw_zero {X : Diagram} (h : sw X = 0) : normalize X = X := by
  unfold normalize
  rw [h, neg_zero, translate_zero]

/-- The inner translated by the origin of the least cell of the outer is a part of the
composite; with `sw D = (0, 0)` that is the inner itself. -/
theorem E_subset_compose (hD : IsConnectedSkew D) (hsw : sw D = 0) :
    ω.E ⊆ ω.compose D := by
  obtain ⟨-, hlo, hhi⟩ := sw_zero_facts hD hsw
  intro x hx
  refine (MarkedInner.mem_compose hD.2.1).mpr (Or.inl ⟨0, ?_, ?_⟩)
  · rw [← hsw]; exact sw_mem hD.2.1
  · rw [origin_zero ω hlo hhi]; exact mem_translate.mpr (by simpa using hx)

theorem width_lt_period (hω : ω.IsLegal) : (ω.width : ℤ) ≤ ω.period - 1 := by
  have := hω.2.2.1.2
  omega

theorem privateHeight_eq_height (hω : ω.IsLegal) (hE0 : minContent ω.E = 0)
    (hD : IsConnectedSkew D) (hD0 : minContent D = 0) {t : ℤ} (h0 : 0 ≤ t) (h1 : t < span D) :
    privateHeight (ω.compose D) ω.period ω.width t = height D t := by
  have hw0 : (0 : ℤ) ≤ ω.width := by positivity
  have := private_height_eq hω hE0 hD hD0 (mem_contents_of_lt hD hD0 h0 h1) (le_refl _)
    (width_lt_period hω)
  unfold privateHeight
  omega

theorem privateRow_eq (hω : ω.IsLegal) (hE0 : minContent ω.E = 0)
    (hD : IsConnectedSkew D) (hD0 : minContent D = 0) {t : ℤ} (h0 : 0 ≤ t) (h1 : t < span D) :
    privateRow (ω.compose D) ω.period ω.width t = originRowLo ω D t - originRowLo ω D 0 := by
  have := private_row_eq hω hE0 hD hD0 (mem_contents_of_lt hD hD0 h0 h1) (le_refl _)
    (width_lt_period hω)
  exact this

theorem privateHeightsAgree_compose (hω : ω.IsLegal) (hE0 : minContent ω.E = 0)
    (hD : IsConnectedSkew D) (hD0 : minContent D = 0) :
    PrivateHeightsAgree (ω.compose D) ω.period ω.width (span D) := by
  intro t w' h0 h1 hw1 hw2
  have ht := mem_contents_of_lt hD hD0 h0 h1
  have a := private_height_eq hω hE0 hD hD0 ht hw1 hw2
  have b := private_height_eq hω hE0 hD hD0 ht (le_refl _) (width_lt_period hω)
  omega

theorem privateRowsAgree_compose (hω : ω.IsLegal) (hE0 : minContent ω.E = 0)
    (hD : IsConnectedSkew D) (hD0 : minContent D = 0) :
    PrivateRowsAgree (ω.compose D) ω.period ω.width (span D) := by
  intro t w' h0 h1 hw1 hw2
  have ht := mem_contents_of_lt hD hD0 h0 h1
  have a := private_row_eq hω hE0 hD hD0 ht hw1 hw2
  have b := private_row_eq hω hE0 hD hD0 ht (le_refl _) (width_lt_period hω)
  omega

/-- The outer is generated by `lem:heights` from the private heights. -/
theorem mem_heightCandidates (hω : ω.IsLegal) (hE0 : minContent ω.E = 0)
    (hD : IsConnectedSkew D) (hsw : sw D = 0) :
    D ∈ heightCandidates (ω.compose D) ω.period ω.width (span D) := by
  have hD0 := (sw_zero_facts hD hsw).1
  refine ⟨hD, ?_⟩
  rw [Int.toNat_natCast]
  exact heightRecursion_of_isConnectedSkew hD hsw fun c h0 h1 =>
    privateHeight_eq_height hω hE0 hD hD0 h0 h1

/-- **Search S is complete.**  Every proper chart of `F` in normalized position is returned by
search S. -/
theorem searchS_complete {F : Diagram} {χ : Chart} (h : χ.IsProperLegal) (hP : χ.parent = F)
    (hswD : sw χ.D = 0) (hswE : sw χ.ω.E = 0) : χ ∈ SearchS F := by
  obtain ⟨hD, hD2, hE2, hω⟩ := h
  have hE0 := (sw_zero_facts hω.1.1 hswE).1
  have hD0 := (sw_zero_facts hD hswD).1
  have hP' : χ.ω.compose χ.D = F := hP
  subst hP'
  have hspan := outerSpanS_eq hω hD
  have hD2' : 2 ≤ span χ.D := two_le_span_of_two_le_card hD hD2
  refine ⟨⟨χ.ω.E, E_subset_compose hD hswD, hω.1.1, hE2, (normalize_of_sw_zero hswE).symm⟩,
    hω, ?_, by omega, ?_, ?_, rfl⟩
  · have h1 := span_compose_eq hω hD
    have h2 := span_inner_eq hω
    exact ⟨span χ.D - 1, by rw [h1, h2]; ring⟩
  · rw [hspan]; exact privateHeightsAgree_compose hω hE0 hD hD0
  · rw [hspan]; exact mem_heightCandidates hω hE0 hD hswD

/-! ### Search B: the bands -/

/-- With `minContent D = 0`, the span of the outer is `M + 1`. -/
theorem span_eq_max_add_one (hD : IsConnectedSkew D) (hD0 : minContent D = 0) :
    (span D : ℤ) = maxContent D + 1 := by
  have := span_eq_of_isConnectedSkew hD
  omega

/-- The row of the origin of the cell on the greatest content of the outer is `κ_M`. -/
theorem origin_ne_fst (ω : MarkedInner) (hD : IsConnectedSkew D) :
    (ω.origin D (ne D)).1 = originRowLo ω D (maxContent D) := by
  have hs := isConnectedSkew_iff_diagonal.mp hD
  have hsing : diagLo D (maxContent D) = diagHi D (maxContent D) :=
    hs.2.2.2.2 _ (maxContent_mem hs.1) (Or.inr (fun hm => by have := le_maxContent hm; omega))
  rw [origin_fst_eq, content_ne hD.2.1]
  unfold originShift originRowLo originShiftLo
  cases ω.case <;> simp [ne, content, hsing]

/-- The translation of the top band of the composite onto the bottom is the inverse of the origin
of the cell on the greatest content of the outer. -/
theorem topShift_eq (hω : ω.IsLegal) (hE0 : minContent ω.E = 0) (hD : IsConnectedSkew D)
    (hsw : sw D = 0) :
    leastCell (ω.compose D) ((span (ω.compose D) : ℤ) % ω.period) -
        leastCell (ω.compose D) ((span (ω.compose D) : ℤ) - ω.period) =
      -ω.origin D (ne D) := by
  obtain ⟨hD0, hlo, hhi⟩ := sw_zero_facts hD hsw
  have hq := period_pos hω
  have hw0 : (0 : ℤ) ≤ ω.width := by positivity
  have hwq := width_lt_period hω
  have hmod := (width_eq_span_mod hω hD).1.symm
  have hspan := span_compose_eq hω hD
  have hM := span_eq_max_add_one hD hD0
  have hMc : maxContent D ∈ contents D := maxContent_mem hD.2.1
  have h0c : (0 : ℤ) ∈ contents D := by rw [← hD0]; exact minContent_mem hD.2.1
  have e1 : (span (ω.compose D) : ℤ) - ω.period = maxContent D * ω.period + ω.width := by
    rw [hspan, hM]; ring
  have a1 := diagLo_private hω hE0 hD h0c (le_refl _) hwq
  have a2 := diagLo_private hω hE0 hD hMc (le_refl _) hwq
  rw [zero_mul, zero_add, originRowLo_zero ω hlo hhi, add_zero] at a1
  rw [hmod, e1]
  have hrow := origin_ne_fst ω hD
  have hc : content (ω.origin D (ne D)) = maxContent D * ω.period := by
    rw [MarkedInner.content_origin, content_ne hD.2.1]
  have hc' : (ω.origin D (ne D)).2 - (ω.origin D (ne D)).1 = maxContent D * ω.period := hc
  ext
  · simp only [leastCell, Prod.fst_sub, Prod.fst_neg]
    rw [a1, a2, hrow]; ring
  · simp only [leastCell, Prod.snd_sub, Prod.snd_neg]
    rw [a1, a2]
    have : (ω.origin D (ne D)).2 = (ω.origin D (ne D)).1 + maxContent D * ω.period := by omega
    rw [this, hrow]; ring

/-- The bottom band of the composite is the part of `E` below the content `q`. -/
theorem bottomBand_eq (hω : ω.IsLegal) (hE0 : minContent ω.E = 0) (hD : IsConnectedSkew D)
    (hsw : sw D = 0) :
    bottomBand (ω.compose D) ω.period = ω.E.filter fun x => content x < ω.period := by
  ext x
  simp only [bottomBand, Finset.mem_filter]
  constructor
  · rintro ⟨hx, -, h2⟩
    exact ⟨(mem_compose_lower_iff hω hE0 hD hsw h2).mp hx, h2⟩
  · rintro ⟨hx, h2⟩
    exact ⟨(mem_compose_lower_iff hω hE0 hD hsw h2).mpr hx, (content_bounds_E hω hE0 x hx).1, h2⟩

/-- The top band of the composite, moved onto the bottom, is the part of `E` from the content
`w` up. -/
theorem topBand_eq (hω : ω.IsLegal) (hE0 : minContent ω.E = 0) (hD : IsConnectedSkew D)
    (hsw : sw D = 0) :
    topBand (ω.compose D) ω.period = ω.E.filter fun x => (ω.width : ℤ) ≤ content x := by
  obtain ⟨hD0, -, -⟩ := sw_zero_facts hD hsw
  have hq := period_pos hω
  have hspan := span_compose_eq hω hD
  have hM := span_eq_max_add_one hD hD0
  have e1 : (span (ω.compose D) : ℤ) - ω.period = maxContent D * ω.period + ω.width := by
    rw [hspan, hM]; ring
  unfold topBand
  rw [topShift_eq hω hE0 hD hsw]
  ext y
  simp only [mem_translate, Finset.mem_filter, sub_neg_eq_add, e1, content_add,
    MarkedInner.content_origin, content_ne hD.2.1]
  constructor
  · rintro ⟨hy, h2⟩
    have := (mem_compose_upper_iff hω hE0 hD (x := y + ω.origin D (ne D))
      (by rw [content_add, MarkedInner.content_origin, content_ne hD.2.1]; omega)).mp hy
    rw [add_sub_cancel_right] at this
    exact ⟨this, by linarith⟩
  · rintro ⟨hy, h2⟩
    refine ⟨(mem_compose_upper_iff hω hE0 hD (x := y + ω.origin D (ne D))
      (by rw [content_add, MarkedInner.content_origin, content_ne hD.2.1]; omega)).mpr ?_,
      by linarith⟩
    rwa [add_sub_cancel_right]

/-- The inner is recovered from the two bands of the composite. -/
theorem bandInner_eq (hω : ω.IsLegal) (hE0 : minContent ω.E = 0) (hD : IsConnectedSkew D)
    (hsw : sw D = 0) : bandInner (ω.compose D) ω.period = ω.E := by
  have hwq := width_lt_period hω
  unfold bandInner
  rw [bottomBand_eq hω hE0 hD hsw, topBand_eq hω hE0 hD hsw]
  ext x
  simp only [Finset.mem_union, Finset.mem_filter]
  constructor
  · rintro (⟨h, -⟩ | ⟨h, -⟩) <;> exact h
  · intro hx
    by_cases h : content x < ω.period
    · exact Or.inl ⟨hx, h⟩
    · exact Or.inr ⟨hx, by omega⟩

/-- The two bands of the composite agree on the contents `[w, q - 1]`. -/
theorem bandsAgree_compose (hω : ω.IsLegal) (hE0 : minContent ω.E = 0) (hD : IsConnectedSkew D)
    (hsw : sw D = 0) : BandsAgree (ω.compose D) ω.period := by
  have hmod := (width_eq_span_mod hω hD).1.symm
  intro x h1 h2
  rw [hmod] at h1
  rw [bottomBand_eq hω hE0 hD hsw, topBand_eq hω hE0 hD hsw]
  simp only [Finset.mem_filter]
  constructor
  · rintro ⟨h, -⟩; exact ⟨h, h1⟩
  · rintro ⟨h, -⟩; exact ⟨h, by omega⟩

/-! ### Search B: the outer -/

theorem width_eq_mod (hω : ω.IsLegal) (hD : IsConnectedSkew D) :
    (span (ω.compose D) : ℤ) % ω.period = ω.width ∧
      (span (ω.compose D) : ℤ) / ω.period = span D :=
  ⟨(width_eq_span_mod hω hD).1.symm, (width_eq_span_mod hω hD).2.symm⟩

/-- **`cor:outer`, case (a).**  The outer is determined by the composite and the marked inner. -/
theorem eq_corOuterA (hω : ω.IsLegal) (hE0 : minContent ω.E = 0) (hD : IsConnectedSkew D)
    (hsw : sw D = 0) (hc : ω.case = .a) :
    D = corOuterA (ω.compose D) ω.period ω.width (span D) ω.v.1 := by
  obtain ⟨hD0, hlo, hhi⟩ := sw_zero_facts hD hsw
  unfold corOuterA
  rw [Int.toNat_natCast]
  refine (eq_diagramOfRows hD hD0).trans (diagramOfRows_congr fun t h0 h1 => ?_)
  have hr := privateRow_eq hω hE0 hD hD0 h0 h1
  have hh := privateHeight_eq_height hω hE0 hD hD0 h0 h1
  rw [originRowLo_zero ω hlo hhi] at hr
  have : originRowLo ω D t = t * ω.v.1 + diagLo D t := by
    simp [originRowLo, originShiftLo, hc]
  have hlen : height D t = diagHi D t - diagLo D t + 1 := rfl
  constructor <;> omega

/-- **`cor:outer`, case (b).**  The outer is determined by the composite and the marked inner. -/
theorem eq_corOuterB (hω : ω.IsLegal) (hE0 : minContent ω.E = 0) (hD : IsConnectedSkew D)
    (hsw : sw D = 0) (hc : ω.case = .b) :
    D = corOuterB (ω.compose D) ω.period ω.width (span D) ω.v.1 := by
  obtain ⟨hD0, hlo, hhi⟩ := sw_zero_facts hD hsw
  unfold corOuterB
  rw [Int.toNat_natCast]
  refine (eq_diagramOfRows hD hD0).trans (diagramOfRows_congr fun t h0 h1 => ?_)
  have hr := privateRow_eq hω hE0 hD hD0 h0 h1
  have hh := privateHeight_eq_height hω hE0 hD hD0 h0 h1
  rw [originRowLo_zero ω hlo hhi] at hr
  have : originRowLo ω D t = t * ω.v.1 - diagHi D t := by
    simp [originRowLo, originShiftLo, hc, sub_eq_add_neg]
  have hlen : height D t = diagHi D t - diagLo D t + 1 := rfl
  constructor <;> omega

/-- In cases (c) and (d), every copy `E + t v ± k e` with `k < H_t` lies in the composite. -/
theorem copiesInF_compose (hω : ω.IsLegal) (hE0 : minContent ω.E = 0) (hD : IsConnectedSkew D)
    (hsw : sw D = 0) (hc : ω.case = .c ∨ ω.case = .d) :
    CopiesInF (ω.compose D) ω ω.period ω.width (span D) := by
  obtain ⟨hD0, -, -⟩ := sw_zero_facts hD hsw
  intro t k h0 h1 hk0 hk1
  have ht := mem_contents_of_lt hD hD0 h0 h1
  rw [privateHeight_eq_height hω hE0 hD hD0 h0 h1] at hk1
  have key : ∀ k' : ℤ, (∃ d ∈ D, content d = t ∧ ω.origin D d = t • ω.v + k' • eCell) →
      translate (t • ω.v + k' • eCell) ω.E ⊆ ω.compose D := by
    rintro k' ⟨d, hd, -, ho⟩ x hx
    refine (MarkedInner.mem_compose hD.2.1).mpr (Or.inl ⟨d, hd, ?_⟩)
    rwa [ho]
  rcases hc with hc | hc
  · simp only [hc, ite_true]
    exact key k ((origin_mem_iff_c hD ht hc k).mpr ⟨hk0, by omega⟩)
  · have hne : ¬ (ω.case = .c) := by rw [hc]; decide
    simp only [hne, ite_false]
    have := key (-k) ((origin_mem_iff_d hD ht hc (-k)).mpr ⟨by omega, by omega⟩)
    exact this

/-- **Search B is complete.**  Every proper chart of `F` in normalized position is returned by
search B. -/
theorem searchB_complete {F : Diagram} {χ : Chart} (h : χ.IsProperLegal) (hP : χ.parent = F)
    (hswD : sw χ.D = 0) (hswE : sw χ.ω.E = 0) : χ ∈ SearchB F := by
  obtain ⟨D, ω⟩ := χ
  obtain ⟨hD, hD2, hE2, hω⟩ := h
  change ω.compose D = F at hP
  change sw D = 0 at hswD
  change sw ω.E = 0 at hswE
  change IsConnectedSkew D at hD
  change 2 ≤ D.card at hD2
  change 2 ≤ ω.E.card at hE2
  change ω.IsLegal at hω
  subst hP
  have hE0 := (sw_zero_facts hω.1.1 hswE).1
  have hD0 := (sw_zero_facts hD hswD).1
  have hD2' : 2 ≤ span D := two_le_span_of_two_le_card hD hD2
  have hq2 : 2 ≤ ω.period := two_le_period (χ := ⟨D, ω⟩) ⟨hD, hD2, hE2, hω⟩
  obtain ⟨hmod, hdiv⟩ := width_eq_mod hω hD
  have hspan := span_compose_eq hω hD
  have hw0 : (0 : ℤ) ≤ ω.width := by positivity
  have h2q : 2 * ω.period ≤ (span (ω.compose D) : ℤ) := by
    have : (2 : ℤ) ≤ span D := by exact_mod_cast hD2'
    rw [hspan]; nlinarith
  refine ⟨ω.period, hq2, by omega, ?_⟩
  change ω.period = ω.period ∧ _
  rw [hmod, hdiv]
  refine ⟨rfl, privateHeightsAgree_compose hω hE0 hD hD0, privateRowsAgree_compose hω hE0 hD hD0,
    bandsAgree_compose hω hE0 hD hswD, (bandInner_eq hω hE0 hD hswD).symm, hω.1.1, hω, ?_, hD, rfl⟩
  change SearchBOuter (ω.compose D) ω ω.period ω.width (span D) D
  unfold SearchBOuter
  cases hcase : ω.case
  · exact eq_corOuterA hω hE0 hD hswD hcase
  · exact eq_corOuterB hω hE0 hD hswD hcase
  · exact ⟨copiesInF_compose hω hE0 hD hswD (Or.inl hcase), mem_heightCandidates hω hE0 hD hswD⟩
  · exact ⟨copiesInF_compose hω hE0 hD hswD (Or.inr hcase), mem_heightCandidates hω hE0 hD hswD⟩

end SkewBase
