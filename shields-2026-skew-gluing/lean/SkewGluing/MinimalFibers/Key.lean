import SkewGluing.MinimalFibers.LeastPeriod

/-!
# Component keys

Formalizes `shields-2026-skew-gluing.tex`, «Component keys» (`eq:component-key`,
`prop:component-key`) and the gauge-necessity example.

The key `Chart.key χ = [(χ.ω, s_{χ.D})]`, with its identifications `KeyStep` by translation,
transported rotation and the legal ordinary gauge `(ω_a, Q) ∼ (ω_b, ι Q)`, is defined in
`SkewGluing.NecessityReduction.Statements`; the key `K(F)` of a rooted diagram is the key of a
source-minimal chart.

* `Chart.key_eq_iff`: equal keys are the equivalence relation generated by `KeyStep`;
  `fiberClass_eq_of_key_eq`: equal keys give equal fibers.
* `Chart.key_eq_of_period_eq`: two proper charts of one diagram with equal periods have equal keys
  (the proof of `lem:gluing-equal`: the inner is reconstructed from the two windows, the only other
  alternative is the ordinary gauge, and fixed-chart injectivity identifies the outer).
* `Chart.IsSourceMinimal.key_eq` (`prop:component-key`, independence of the chart).
* `component_key_iff` (`prop:component-key`): for rooted diagrams `F`, `H` of one connected Schur
  class, `K(F) = K(H)` exactly when `F`, `H` lie in one component of `Γ(P)`.
* `gauge_necessity`: the gauge-necessity example `E = (4,4,2)/(2)`.

The Olson-Harris composition theorem is the hypothesis `hOH` (only for the direction
`K(F) = K(H) ⟸ same component`), discharged by `olsonHarrisComposition` in
`SkewGluing.MainTheorems`.

Sorry-free.
-/

namespace SkewGluing

theorem Chart.key_eq_iff {χ χ' : Chart} :
    χ.key = χ'.key ↔
      Relation.EqvGen KeyStep (χ.ω, cellSchur χ.D) (χ'.ω, cellSchur χ'.D) :=
  ⟨Quot.eqvGen_exact, Quot.eqvGen_sound⟩

theorem KeyStep.eqvGen {a b : MarkedInner × Lambda} (h : KeyStep a b) :
    Relation.EqvGen KeyStep a b :=
  Relation.EqvGen.rel _ _ h

/-- Each step preserves the fiber `𝓕(ω, Q)` (read up to translation). -/
theorem KeyStep.fiberClass_eq {a b : MarkedInner × Lambda} (h : KeyStep a b) :
    fiberClass cellSchur a.1 a.2 = fiberClass cellSchur b.1 b.2 := by
  cases h with
  | translate u ω Q => exact (fiberClass_cellSchur_translate_inner u ω Q).symm
  | rotate ω Q => exact (fiberClass_rotate_inner cellSchur ω Q).symm
  | gauge Q hE ha hb hv hla hlb => exact fiberClass_gauge hE ha hb hv Q

/-- **Equal keys give equal fibers.**  Every identification of the key preserves the fiber
`𝓕(ω, Q)`, read up to translation. -/
theorem fiberClass_eq_of_eqvGen {a b : MarkedInner × Lambda}
    (h : Relation.EqvGen KeyStep a b) :
    fiberClass cellSchur a.1 a.2 = fiberClass cellSchur b.1 b.2 := by
  induction h with
  | rel _ _ h => exact h.fiberClass_eq
  | refl _ => rfl
  | symm _ _ _ ih => exact ih.symm
  | trans _ _ _ _ _ ih₁ ih₂ => exact ih₁.trans ih₂

theorem fiberClass_eq_of_key_eq {χ χ' : Chart} (h : χ.key = χ'.key) :
    fiberClass cellSchur χ.ω (cellSchur χ.D) = fiberClass cellSchur χ'.ω (cellSchur χ'.D) :=
  fiberClass_eq_of_eqvGen (Chart.key_eq_iff.mp h)

/-! ### Equal periods give equal keys -/

/-- **Two proper charts of one diagram with equal periods have equal keys** (`lem:gluing-equal`,
`eq:component-key`).  The marked inners agree up to translation, with equal outer functions, or
form the ordinary double of cases (a), (b), with outer functions exchanged by `ι`, which is the
ordinary gauge. -/
theorem Chart.key_eq_of_period_eq {F : Diagram} {χ₁ χ₂ : Chart} (h₁ : χ₁.IsProperLegal)
    (h₂ : χ₂.IsProperLegal) (c₁ : χ₁.IsChartOf F) (c₂ : χ₂.IsChartOf F)
    (hq : χ₁.period = χ₂.period) : χ₁.key = χ₂.key := by
  obtain ⟨δ, hδ, hcases⟩ := Chart.IsProperLegal.equal_periods_cases h₁ h₂ c₁ c₂ hq
  rw [Chart.key_eq_iff]
  have hstep : Relation.EqvGen KeyStep (χ₁.ω, cellSchur χ₁.D)
      (χ₁.ω.translate δ, cellSchur χ₁.D) :=
    (KeyStep.translate δ χ₁.ω (cellSchur χ₁.D)).eqvGen
  have hlt : (χ₁.ω.translate δ).IsLegal := MarkedInner.isLegal_translate δ h₁.2.2.2
  rcases hcases with ⟨hω, hs⟩ | ⟨-, ⟨ha, hb, hv⟩ | ⟨ha, hb, hv⟩, hs⟩
  · rw [hω, hs]
    exact hstep
  · refine Relation.EqvGen.trans _ _ _ hstep ?_
    rw [hs]
    exact (KeyStep.gauge (ωa := χ₁.ω.translate δ) (ωb := χ₂.ω) (cellSchur χ₁.D) hδ.symm ha hb hv hlt
      h₂.2.2.2).eqvGen
  · refine Relation.EqvGen.trans _ _ _ hstep ?_
    have hg := (KeyStep.gauge (ωa := χ₂.ω) (ωb := χ₁.ω.translate δ) (cellSchur χ₂.D) hδ hb ha
      hv h₂.2.2.2 hlt).eqvGen
    have hι : schurInvolution (cellSchur χ₂.D) = cellSchur χ₁.D := by
      rw [hs, schurInvolution_involutive]
    rw [hι] at hg
    exact Relation.EqvGen.symm _ _ hg

/-- **`prop:component-key`, independence of the chart.**  The key `K(F)` does not depend on the
source-minimal chart chosen: equal minimum scores at one source give equal periods. -/
theorem Chart.IsSourceMinimal.key_eq {F : Diagram} {χ χ' : Chart} (h : χ.IsSourceMinimal F)
    (h' : χ'.IsSourceMinimal F) : χ.key = χ'.key := by
  have hs : χ.score = χ'.score := le_antisymm (h.2.2 χ' h'.1 h'.2.1) (h'.2.2 χ h.1 h.2.1)
  exact Chart.key_eq_of_period_eq h.1 h'.1 h.2.1 h'.2.1
    (h.1.period_eq_of_score_eq h'.1 h.2.1 h'.2.1 hs)

/-! ### The key classifies the component -/

/-- Transfer of a chart through a fiber: if `G` lies in the fiber of a proper chart `χ`, then `G`
has a proper chart with the marked inner `χ.ω` or `χ.ω*`, the same outer function, and the
same period. -/
theorem exists_transfer_chart {χ : Chart} (h : χ.IsProperLegal) {G : Diagram}
    (hG : G ∈ fiberClass cellSchur χ.ω (cellSchur χ.D)) :
    ∃ χ' : Chart, χ'.IsProperLegal ∧ χ'.IsChartOf G ∧ (χ'.ω = χ.ω ∨ χ'.ω = χ.ω.rotate) ∧
      cellSchur χ'.D = cellSchur χ.D ∧ χ'.period = χ.period := by
  obtain ⟨χ', h', c', hω, hs⟩ := exists_chart_of_mem_fiberClass h.2.2.2 h.2.2.1 hG
  refine ⟨χ', h', c', hω, hs, ?_⟩
  rcases hω with e | e
  · change χ'.ω.period = χ.ω.period
    rw [e]
  · change χ'.ω.period = χ.ω.period
    rw [e]
    exact MarkedInner.period_rotate _

/-- **`prop:component-key`.**  For rooted diagrams `F`, `H` in one connected Schur class `P`, with
source-minimal charts `χF`, `χH`: `K(F) = K(H)` exactly when `F` and `H` lie in the same component
of `Γ(P)`, the common-factor graph on the connected class.

The Olson-Harris composition theorem is the hypothesis `hOH`. -/
theorem component_key_iff (hOH : OlsonHarrisComposition) {P : Lambda} {F H : Diagram}
    (hF : connectedClass P F) (hH : connectedClass P H) {χF χH : Chart}
    (hχF : χF.IsSourceMinimal F) (hχH : χH.IsSourceMinimal H) :
    χF.key = χH.key ↔
      (classGraph (connectedClass P)).Reachable (classOf ⟨F, hF⟩) (classOf ⟨H, hH⟩) := by
  have hspan : span F = span H := span_eq_of_cellSchur_eq hF.1 hH.1 (hF.2.trans hH.2.symm)
  constructor
  · -- equal keys give one fiber, hence one component
    intro hk
    have hfib := fiberClass_eq_of_key_eq hk
    have hFmem := hχF.1.mem_fiberClass_parent hχF.2.1
    have hHmem := hχH.1.mem_fiberClass_parent hχH.2.1
    rw [hfib] at hFmem
    by_cases heq : classOf (⟨F, hF⟩ : {F : Diagram // connectedClass P F}) =
        classOf (⟨H, hH⟩ : {F : Diagram // connectedClass P F})
    · rw [heq]
    · refine SimpleGraph.Adj.reachable ?_
      rw [classGraph_adj_iff]
      refine fiberClass_hasCommonFinalFactor hχH.1.2.2.2 hχH.1.2.2.1 hFmem hHmem ?_
      rintro ⟨t, ht⟩
      exact heq (classOf_eq_iff.mpr ⟨t, ht⟩)
  · intro hr
    have hcl := gluing_connectedClass_componentsAreCliques hOH P
    by_cases heq : classOf (⟨F, hF⟩ : {F : Diagram // connectedClass P F}) =
        classOf (⟨H, hH⟩ : {F : Diagram // connectedClass P F})
    · -- translates: both are source-minimal at `H`
      obtain ⟨t, ht⟩ := classOf_eq_iff.mp heq
      have hF' : χF.IsSourceMinimal H := by
        have := (Chart.isSourceMinimal_translate_iff χF F t).mpr hχF
        rwa [← ht] at this
      exact hF'.key_eq hχH
    · have hadj := hcl.adj_of_reachable hr heq
      rw [classGraph_adj_iff] at hadj
      -- `H ∈ 𝓕_{χF}` and `F ∈ 𝓕_{χH}`: transfer the charts
      obtain ⟨χ₁, h₁, c₁, hHmem⟩ := hadj.symm.exists_chart_fiber
      obtain ⟨χ₂, h₂, c₂, hFmem⟩ := hadj.exists_chart_fiber
      have hHF := hχF.fiber_subset hOH h₁ c₁ hHmem
      have hFH := hχH.fiber_subset hOH h₂ c₂ hFmem
      obtain ⟨χs, hs, cs, hωs, hDs, hps⟩ := exists_transfer_chart hχF.1 hHF
      obtain ⟨χt, ht, ct, hωt, hDt, hpt⟩ := exists_transfer_chart hχH.1 hFH
      -- the transferred charts have the scores of the originals
      have hscs : χs.score = χF.score := by
        rw [hs.score_eq cs, hχF.1.score_eq hχF.2.1, hps, hspan]
      have hsct : χt.score = χH.score := by
        rw [ht.score_eq ct, hχH.1.score_eq hχH.2.1, hpt, ← hspan]
      have hle₁ : χF.score ≤ χH.score := hsct ▸ hχF.2.2 χt ht ct
      have hle₂ : χH.score ≤ χF.score := hscs ▸ hχH.2.2 χs hs cs
      have hscore : χt.score = χF.score := by rw [hsct]; exact le_antisymm hle₂ hle₁
      have hper := ht.period_eq_of_score_eq hχF.1 ct hχF.2.1 hscore
      have k₁ : χt.key = χF.key := Chart.key_eq_of_period_eq ht hχF.1 ct hχF.2.1 hper
      have k₂ : χt.key = χH.key := by
        rw [Chart.key_eq_iff, hDt]
        rcases hωt with e | e
        · rw [e]
          exact Relation.EqvGen.refl _
        · rw [e]
          exact Relation.EqvGen.symm _ _ (KeyStep.rotate χH.ω _).eqvGen
      exact k₁.symm.trans k₂

/-! ### The gauge cannot be omitted -/

section GaugeNecessity

open MvPolynomial

/-- The row `(2)` as a profile. -/
def rowTwoProfile : Profile 0 where
  r := ![2]
  g := Fin.elim0
  r_pos := by decide
  g_lt_castSucc := by decide
  g_lt_succ := by decide

/-- The column `(1, 1)` as a profile. -/
def columnTwoProfile : Profile 1 where
  r := ![1, 1]
  g := ![0]
  r_pos := by decide
  g_lt_castSucc := by decide
  g_lt_succ := by decide

theorem schur_rowTwo : rowTwoProfile.schur = X 2 := by
  have h1 : rowTwoProfile.xi 0 = 2 := by decide
  have h2 : rowTwoProfile.zeta 0 = 0 := by decide
  have e2 : hh 2 = X 2 := by simpa using hh_pnat 2
  rw [Profile.schur, Matrix.det_succ_row_zero]
  simp [h1, h2, e2]

theorem schur_columnTwo : columnTwoProfile.schur = X 1 ^ 2 - X 2 := by
  have h1 : columnTwoProfile.xi 0 = 2 := by decide
  have h2 : columnTwoProfile.xi 1 = 1 := by decide
  have h3 : columnTwoProfile.zeta 0 = 1 := by decide
  have h4 : columnTwoProfile.zeta 1 = 0 := by decide
  have e1 : hh 1 = X 1 := by simpa using hh_pnat 1
  have e2 : hh 2 = X 2 := by simpa using hh_pnat 2
  rw [Profile.schur, Matrix.det_fin_two]
  simp [h1, h2, h3, h4, e1, e2]
  ring

/-- `s_{(2)} = h₂` on cells. -/
theorem cellSchur_rowTwo : cellSchur (skewOf [2] []) = X 2 := by
  have : skewOf [2] [] = translate (0, 0) rowTwoProfile.cells := by decide
  rw [this, cellSchur_translate, cellSchur_cells, schur_rowTwo]

/-- `s_{(1,1)} = e₂ = h₁² - h₂` on cells. -/
theorem cellSchur_columnTwo : cellSchur (skewOf [1, 1] []) = X 1 ^ 2 - X 2 := by
  have : skewOf [1, 1] [] = translate (0, -1) columnTwoProfile.cells := by decide
  rw [this, cellSchur_translate, cellSchur_cells, schur_columnTwo]

/-- `h₂ ≠ e₂`: the two outer functions of the gauge example differ. -/
theorem cellSchur_rowTwo_ne_columnTwo :
    cellSchur (skewOf [2] []) ≠ cellSchur (skewOf [1, 1] []) := by
  intro h
  have := numRows_eq_of_cellSchur_eq (by decide +kernel) (by decide +kernel) h
  revert this
  decide +kernel

/-- **The involution in the key cannot be omitted** (the example after `prop:component-key`).  Let
`E = (4,4,2)/(2)` with the two legal width-two, period-four ordinary marks `ω_a`, `ω_b` of the
paper.  The charts `((2), ω_a)` and `((1,1), ω_b)` are proper legal charts of one diagram,
`(2) ∘_{ω_a} E = (1,1) ∘_{ω_b} E` (up to translation), of equal period four and width two; the
outer functions are `h₂` and `e₂ = h₁² - h₂ = ι(h₂)`, which are not equal; and the two charts have
the same key, thanks to the gauge `(ω_a, h₂) ∼ (ω_b, ι h₂)`, and the same fiber. -/
theorem gauge_necessity :
    (Chart.IsProperLegal ⟨skewOf [2] [], gaugeInnerA⟩ ∧
      Chart.IsProperLegal ⟨skewOf [1, 1] [], gaugeInnerB⟩) ∧
    (Chart.IsChartOf ⟨skewOf [1, 1] [], gaugeInnerB⟩
      (Chart.parent ⟨skewOf [2] [], gaugeInnerA⟩)) ∧
    (gaugeInnerA.period = 4 ∧ gaugeInnerB.period = 4 ∧ gaugeInnerA.width = 2 ∧
      gaugeInnerB.width = 2) ∧
    (cellSchur (skewOf [2] []) = X 2 ∧ cellSchur (skewOf [1, 1] []) = X 1 ^ 2 - X 2 ∧
      cellSchur (skewOf [1, 1] []) = schurInvolution (cellSchur (skewOf [2] [])) ∧
      cellSchur (skewOf [2] []) ≠ cellSchur (skewOf [1, 1] [])) ∧
    (Chart.mk (skewOf [2] []) gaugeInnerA).key = (Chart.mk (skewOf [1, 1] []) gaugeInnerB).key ∧
    fiberClass cellSchur gaugeInnerA (cellSchur (skewOf [2] [])) =
      fiberClass cellSchur gaugeInnerB (cellSchur (skewOf [1, 1] [])) := by
  have hι : cellSchur (skewOf [1, 1] []) = schurInvolution (cellSchur (skewOf [2] [])) := by
    have : skewOf [1, 1] [] = translate (1, 0) (antitranspose (skewOf [2] [])) := by decide +kernel
    rw [this, cellSchur_translate, cellSchur_antitranspose]
  have hA : Chart.IsProperLegal ⟨skewOf [2] [], gaugeInnerA⟩ :=
    ⟨by decide +kernel, by decide +kernel, by decide +kernel, by decide +kernel⟩
  have hB : Chart.IsProperLegal ⟨skewOf [1, 1] [], gaugeInnerB⟩ :=
    ⟨by decide +kernel, by decide +kernel, by decide +kernel, by decide +kernel⟩
  have hC : Chart.IsChartOf ⟨skewOf [1, 1] [], gaugeInnerB⟩
      (Chart.parent ⟨skewOf [2] [], gaugeInnerA⟩) :=
    ⟨(-1, 3), by decide +kernel⟩
  refine ⟨⟨hA, hB⟩, hC, ⟨by decide, by decide, by decide +kernel, by decide +kernel⟩,
    ⟨cellSchur_rowTwo, cellSchur_columnTwo, hι, cellSchur_rowTwo_ne_columnTwo⟩, ?_, ?_⟩
  · refine Chart.key_eq_of_period_eq hA hB (F := Chart.parent ⟨skewOf [2] [], gaugeInnerA⟩)
      ⟨0, by simp [translate_zero]⟩ hC (by decide)
  · rw [hι]
    exact fiberClass_gauge (by decide) rfl rfl (by decide) _

end GaugeNecessity

end SkewGluing
