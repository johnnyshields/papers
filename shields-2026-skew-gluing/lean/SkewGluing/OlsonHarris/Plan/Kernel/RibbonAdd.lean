import SkewGluing.OlsonHarris.Plan.MurnaghanNakayama
import SkewGluing.OlsonHarris.Plan.Kernel.Ferrers
import SkewGluing.OlsonHarris.Plan.Kernel.Homogeneity

/-!
# Adding a ribbon to a Young diagram

Formalizes `shields-2026-skew-gluing.tex`, «Charts and the common-factor graph»
(`sec:gluing`, `def:gluing-graph`): thesis §5.1.3 (`OlsonHarris2024HopfApplications`), the
Murnaghan–Nakayama rule for one power sum in the multiplication form, as a finite sum.

`ribbonAdds ρ m` is the finite set of Young diagrams `σ ⊇ ρ` such that `σ / ρ` is a ribbon with
`m` cells, and `pPoly_mul_ferrersSchur` restates `pPoly_mul_cellSchur_ferrers` as a sum over it.
The Ferrers Schur functions `s_σ` of the Young diagrams of one size span the graded pieces
generated by the products `p_ν`.

Uses `pPoly_mul_cellSchur_ferrers`.

Sorry-free.
-/

namespace SkewGluing

namespace Plan

namespace KernelAux

open MvPolynomial Shields

/-- The Schur function `s_σ` of a Young diagram. -/
noncomputable def ferrersSchur (sigma : YoungDiagram) : Lambda := cellSchur (skewDiagram sigma ⊥)

theorem ferrersSchur_bot : ferrersSchur ⊥ = 1 := by
  have : skewDiagram ⊥ ⊥ = ∅ := by
    ext x
    rw [mem_skewDiagram_iff]
    simp
  rw [ferrersSchur, this, cellSchur_empty]

theorem card_bot_young : (⊥ : YoungDiagram).card = 0 := rfl

theorem ferrersSchur_homogeneous (sigma : YoungDiagram) :
    IsWeightedHomogeneous degWeight (ferrersSchur sigma) sigma.card := by
  have h := isWeightedHomogeneous_cellSchur (isSkew_skewDiagram_bot sigma)
  have hc := card_skewDiagram (bot_le : (⊥ : YoungDiagram) ≤ sigma)
  rw [card_bot_young] at hc
  rw [add_zero] at hc
  rwa [hc] at h

theorem finite_young_card (N : ℕ) : {sigma : YoungDiagram | sigma.card = N}.Finite := by
  have hsub : ∀ sigma : YoungDiagram, sigma.card = N →
      sigma.cells ∈ ((Finset.range N ×ˢ Finset.range N).powerset : Finset (Finset (ℕ × ℕ))) := by
    intro sigma hN
    rw [Finset.mem_powerset]
    rintro ⟨i, j⟩ hc
    have hmem : (i, j) ∈ sigma := hc
    have h1 : i < sigma.colLen 0 := YoungDiagram.mem_iff_lt_colLen.mp
      (sigma.up_left_mem le_rfl (Nat.zero_le j) hmem)
    have h2 : j < sigma.rowLen 0 := YoungDiagram.mem_iff_lt_rowLen.mp
      (sigma.up_left_mem (Nat.zero_le i) le_rfl hmem)
    have h3 : sigma.colLen 0 ≤ sigma.card := by
      rw [YoungDiagram.colLen_eq_card]
      exact Finset.card_le_card (fun c hc => (YoungDiagram.mem_col_iff.mp hc).1)
    have h4 : sigma.rowLen 0 ≤ sigma.card := by
      rw [YoungDiagram.rowLen_eq_card]
      exact Finset.card_le_card (fun c hc => (YoungDiagram.mem_row_iff.mp hc).1)
    simp only [Finset.mem_product, Finset.mem_range]
    omega
  refine Set.Finite.of_finite_image (f := YoungDiagram.cells)
    (Set.Finite.subset (Finset.finite_toSet ((Finset.range N ×ˢ Finset.range N).powerset)) ?_) ?_
  · rintro _ ⟨sigma, hs, rfl⟩
    exact hsub sigma hs
  · intro a _ b _ h
    exact YoungDiagram.ext h

theorem finite_ribbonAdds (rho : YoungDiagram) (m : ℕ) :
    {sigma : YoungDiagram | rho ≤ sigma ∧ IsRibbon (skewDiagram sigma rho) ∧
      (skewDiagram sigma rho).card = m}.Finite := by
  refine (finite_young_card (rho.card + m)).subset ?_
  rintro sigma ⟨h1, _, h3⟩
  have := card_skewDiagram h1
  simp only [Set.mem_ofPred_eq]
  omega

/-- The Young diagrams `σ ⊇ ρ` such that `σ / ρ` is a ribbon with `m` cells. -/
noncomputable def ribbonAdds (rho : YoungDiagram) (m : ℕ) : Finset YoungDiagram :=
  (finite_ribbonAdds rho m).toFinset

theorem mem_ribbonAdds {rho sigma : YoungDiagram} {m : ℕ} :
    sigma ∈ ribbonAdds rho m ↔
      rho ≤ sigma ∧ IsRibbon (skewDiagram sigma rho) ∧ (skewDiagram sigma rho).card = m := by
  unfold ribbonAdds
  rw [Set.Finite.mem_toFinset]
  rfl

theorem card_of_mem_ribbonAdds {rho sigma : YoungDiagram} {m : ℕ} (h : sigma ∈ ribbonAdds rho m) :
    sigma.card = rho.card + m := by
  obtain ⟨h1, _, h3⟩ := mem_ribbonAdds.mp h
  have := card_skewDiagram h1
  omega

/-- **Murnaghan–Nakayama, multiplication form, as a finite sum.** -/
theorem pPoly_mul_ferrersSchur (rho : YoungDiagram) {m : ℕ} (hm : 0 < m) :
    pPoly m * ferrersSchur rho =
      ∑ sigma ∈ ribbonAdds rho m,
        (ribbonSign (skewDiagram sigma rho) : Lambda) * ferrersSchur sigma := by
  classical
  have h := pPoly_mul_cellSchur_ferrers rho hm
  change pPoly m * cellSchur (skewDiagram rho ⊥) = _ at h
  unfold ferrersSchur
  rw [h]
  rw [finsum_eq_sum_of_support_subset (s := ribbonAdds rho m)]
  · refine Finset.sum_congr rfl fun sigma hs => ?_
    have := mem_ribbonAdds.mp hs
    simp [this]
  · intro sigma hs
    rw [Function.mem_support] at hs
    rw [Finset.mem_coe, mem_ribbonAdds]
    by_contra hn
    exact hs (by simp [hn])

end KernelAux

end Plan

end SkewGluing
