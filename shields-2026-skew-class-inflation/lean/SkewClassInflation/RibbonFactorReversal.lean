import SkewClassInflation.RibbonProductAlgebra
import SkewClassInflation.ReflectedCutTypes

/-!
# Actual ribbon factor-reversal constructions

The generation relation behind the construction in `thm:sharp-inflation` of
`shields-2026-skew-class-inflation.tex`.  Every step reverses an actual
ordinary-composition factor; equivalence and composition closure permit
arbitrary finite sequences of those operations.  All generated words have
equal near-power ribbon functions.  Necessity is established here only
when the original ribbon is reconstructible.  Sorry-free.
-/

namespace SkewClassInflation

/-- The equivalence congruence generated by reversing actual ordinary-composition factors. -/
inductive RibbonFactorReversal : {N : ℕ} → Composition N → Composition N → Prop
  | refl {N : ℕ} (α : Composition N) : RibbonFactorReversal α α
  | reverse {N : ℕ} (α : Composition N) : RibbonFactorReversal α α.reverse
  | symm {N : ℕ} {α β : Composition N} :
      RibbonFactorReversal α β → RibbonFactorReversal β α
  | trans {N : ℕ} {α β γ : Composition N} :
      RibbonFactorReversal α β → RibbonFactorReversal β γ → RibbonFactorReversal α γ
  | compose {M N : ℕ} (α α' : Composition M) (β β' : Composition N)
      (hM : 0 < M) (hN : 0 < N) :
      RibbonFactorReversal α α' → RibbonFactorReversal β β' →
        RibbonFactorReversal (compositionProduct α β) (compositionProduct α' β')

/-- Every actual finite factor-reversal construction preserves every ordinary near-power ribbon. -/
theorem factor_reversal_power_equiv {N : ℕ} {α β : Composition N}
    (he : RibbonFactorReversal α β) : ribbonPowerEquiv α.blocks β.blocks := by
  induction he with
  | refl α => exact ribbonPowerEquiv_refl α.blocks
  | reverse α =>
    intro m
    rw [Composition.reverse_blocks]
    exact (ribbonPowerEquiv_reverse α.blocks (fun a ha => α.blocks_pos ha) m).symm
  | symm he ih => exact fun m => (ih m).symm
  | trans h₁ h₂ ih₁ ih₂ => exact fun m => (ih₁ m).trans (ih₂ m)
  | compose α α' β β' _hM hN h₁ h₂ ih₁ ih₂ =>
    rw [compositionProduct_blocks α β hN, compositionProduct_blocks α' β' hN,
      ← wordCompose_eq_flatten, ← wordCompose_eq_flatten]
    exact ribbonPowerEquiv_compose β.blocks β'.blocks α.blocks α'.blocks
      (by rw [β.blocks_sum]; exact hN) (by rw [β'.blocks_sum]; exact hN)
      (fun a ha => α.blocks_pos ha) (fun a ha => α'.blocks_pos ha) ih₂ ih₁

/-- Every finite factor-reversal construction preserves the actual ribbon function. -/
theorem factor_reversal_ribbon_eq {N : ℕ} {α β : Composition N}
    (he : RibbonFactorReversal α β) : ribbonWord α.blocks = ribbonWord β.blocks := by
  have hh := factor_reversal_power_equiv he 1
  simpa only [wordNearPower, (wordNear_nil _).1] using hh

/-- The same actual constructions preserve every coarsening partition with multiplicity. -/
theorem factor_reversal_inventory_eq {N : ℕ} {α β : Composition N} (hN : 0 < N)
    (he : RibbonFactorReversal α β) : coarseningInventory α = coarseningInventory β :=
  (ribbon_eq_iff_coarseningInventory α β hN hN).mp (factor_reversal_ribbon_eq he)

/-- Necessity of factor-reversal generation holds for every actual reconstructible source. -/
theorem factor_reversal_of_reconstructible {N : ℕ} (α β : Composition N) (hN : 0 < N)
    (hr : ribbonReconstructible α) (he : ribbonWord α.blocks = ribbonWord β.blocks) :
    RibbonFactorReversal α β := by
  have hInv := (ribbon_eq_iff_coarseningInventory α β hN hN).mp he
  rcases hr β hInv.symm with h | h
  · rw [h]
    exact RibbonFactorReversal.refl α
  · rw [h]
    exact RibbonFactorReversal.reverse α

end SkewClassInflation
