import SkewClassInflation.ThinFactorReversal
import SkewRibbonCoarsenings.MainTheorems
import SkewRibbonCoarsenings.LocalAlternativeProof
import SkewRibbonCoarsenings.RibbonExpansion

/-!
# Exhaustive factor-reversal generation of ribbon classes

The classification cited in `thm:sharp-inflation` of
`shields-2026-skew-class-inflation.tex`: ribbon equality of two compositions of the same
positive weight is generated by finite sequences of ordinary-composition factor reversals.
The completeness direction is the classification of ribbon Schur equality of the copied
`SkewRibbonCoarsenings` tree (`G_eq_iff_factorWitness`, with the unconditional
`localAlternativeOmega`).  It is transported to the canonical compositions of this tree by
three bridges:

* the copied integral Jacobi–Trudi ribbon function and the rational `ribbonWord` of this tree
  satisfy the same first-column recursion, so they agree after the faithful coefficient
  extension;
* the copied list composition product is the literal composition product `compositionProduct`
  of this tree, block for block;
* a copied factor witness is a finite `RibbonFactorReversal` of this tree.

The first class of `thm:sharp-inflation` is then exactly the set generated from the
constructed presentation by factor reversals and global rotation
(`ThinParameters.inflation_class_generated`).  Sorry-free.
-/

namespace SkewClassInflation

open SkewJacobiNegative

/-! ### Bridge 1: the copied ribbon function is the ribbon polynomial of this tree -/

theorem integerLift_hgen {a : ℕ} (ha : 0 < a) :
    integerLift (SkewRibbonCoarsenings.hgen a) = complete (a : ℤ) := by
  let j : ℕ+ := ⟨a, ha⟩
  have h1 : SkewRibbonCoarsenings.hgen a = MvPolynomial.X j := by
    simp [SkewRibbonCoarsenings.hgen, ha, j]
  have h2 : complete ((a : ℕ) : ℤ) = MvPolynomial.X j := complete_nat j
  rw [h1, h2, integerLift, MvPolynomial.map_X]

/-- The copied determinant ribbon function maps to `ribbonWord` under the coefficient extension. -/
theorem integerLift_ribbonParts : ∀ (l : List ℕ) (a : ℕ),
    SkewRibbonCoarsenings.IsParts (a :: l) →
      integerLift (SkewRibbonCoarsenings.ribbonParts (a :: l)) = ribbonTail a l
  | [], a, h => by
    rw [SkewRibbonCoarsenings.ribbonParts_singleton (SkewRibbonCoarsenings.head_pos h),
      integerLift_hgen (SkewRibbonCoarsenings.head_pos h)]
    rfl
  | b :: l, a, h => by
    have hb : SkewRibbonCoarsenings.IsParts (b :: l) := SkewRibbonCoarsenings.isParts_tail h
    have hab : SkewRibbonCoarsenings.IsParts ((a + b) :: l) := by
      intro x hx
      rcases List.mem_cons.mp hx with rfl | hx
      · have := SkewRibbonCoarsenings.head_pos h
        have := SkewRibbonCoarsenings.head_pos hb
        omega
      · exact hb x (List.mem_cons_of_mem _ hx)
    rw [SkewRibbonCoarsenings.ribbonParts_cons_cons h, map_sub, map_mul,
      integerLift_hgen (SkewRibbonCoarsenings.head_pos h),
      integerLift_ribbonParts l b hb, integerLift_ribbonParts l (a + b) hab]
    rfl

theorem integerLift_ribbonParts_word {l : List ℕ} (hl : SkewRibbonCoarsenings.IsParts l) :
    integerLift (SkewRibbonCoarsenings.ribbonParts l) = ribbonWord l := by
  cases l with
  | nil => simp [ribbonWord]
  | cons a l => exact integerLift_ribbonParts l a hl

/-! ### Bridge 2: the copied composition product is the literal product of this tree -/

theorem nearConcat_eq_wordNear : ∀ (u v : List ℕ),
    SkewRibbonCoarsenings.nearConcat u v = wordNear u v
  | [], v => by simp [(wordNear_nil v).2]
  | [a], [] => by simp [SkewRibbonCoarsenings.nearConcat, (wordNear_nil _).1]
  | [a], b :: l => by
    have h := wordNear_append_cons [] a b l
    simpa [SkewRibbonCoarsenings.nearConcat] using h.symm
  | a :: c :: r, v => by
    rw [SkewRibbonCoarsenings.nearConcat_cons a (List.cons_ne_nil c r),
      nearConcat_eq_wordNear (c :: r) v, wordNear_cons a (c :: r) v (List.cons_ne_nil c r)]

theorem nearPow_eq_wordNearPower (ε : List ℕ) (m : ℕ) :
    SkewRibbonCoarsenings.nearPow ε m = wordNearPower ε m := by
  induction m with
  | zero => rfl
  | succ m ih =>
    have h1 : wordNearPower ε 1 = ε := by simp [wordNearPower, (wordNear_nil _).1]
    rw [SkewRibbonCoarsenings.nearPow, nearConcat_eq_wordNear, ih, wordNearPower_add ε m 1, h1]

theorem compose_eq_flatten (α ε : List ℕ) :
    SkewRibbonCoarsenings.compose α ε = (α.map (wordNearPower ε)).flatten := by
  have h : SkewRibbonCoarsenings.nearPow ε = wordNearPower ε :=
    funext (nearPow_eq_wordNearPower ε)
  simp only [SkewRibbonCoarsenings.compose, h]

/-! ### Bridge 3: copied factor witnesses are factor reversals -/

/-- A list of positive parts of total weight `N` as a canonical composition. -/
def listComposition (l : List ℕ) (N : ℕ) (hl : SkewRibbonCoarsenings.IsParts l)
    (hs : l.sum = N) : Composition N where
  blocks := l
  blocks_pos := fun {i} hi => hl i hi
  blocks_sum := hs

/-- Two part lists of weight `N` related by a finite actual factor-reversal construction. -/
def FactorRel (u v : List ℕ) (N : ℕ) : Prop :=
  ∃ (hu : SkewRibbonCoarsenings.IsParts u) (hv : SkewRibbonCoarsenings.IsParts v)
    (hsu : u.sum = N) (hsv : v.sum = N),
    RibbonFactorReversal (listComposition u N hu hsu) (listComposition v N hv hsv)

theorem FactorRel.compose {a a' b b' : List ℕ} {M K : ℕ} (hM : 0 < M) (hK : 0 < K)
    (ha : FactorRel a a' M) (hb : FactorRel b b' K) :
    FactorRel (SkewRibbonCoarsenings.compose a b) (SkewRibbonCoarsenings.compose a' b')
      (M * K) := by
  obtain ⟨hpa, hpa', hsa, hsa', h1⟩ := ha
  obtain ⟨hpb, hpb', hsb, hsb', h2⟩ := hb
  have hp := SkewRibbonCoarsenings.isParts_compose (α := a) hpb
  have hp' := SkewRibbonCoarsenings.isParts_compose (α := a') hpb'
  have hs : (SkewRibbonCoarsenings.compose a b).sum = M * K := by
    rw [SkewRibbonCoarsenings.sum_compose, hsa, hsb]
  have hs' : (SkewRibbonCoarsenings.compose a' b').sum = M * K := by
    rw [SkewRibbonCoarsenings.sum_compose, hsa', hsb']
  refine ⟨hp, hp', hs, hs', ?_⟩
  have key := RibbonFactorReversal.compose _ _ _ _ hM hK h1 h2
  have e1 : compositionProduct (listComposition a M hpa hsa) (listComposition b K hpb hsb) =
      listComposition (SkewRibbonCoarsenings.compose a b) (M * K) hp hs :=
    Composition.ext (by
      rw [compositionProduct_blocks _ _ hK]
      exact (compose_eq_flatten a b).symm)
  have e2 : compositionProduct (listComposition a' M hpa' hsa') (listComposition b' K hpb' hsb') =
      listComposition (SkewRibbonCoarsenings.compose a' b') (M * K) hp' hs' :=
    Composition.ext (by
      rw [compositionProduct_blocks _ _ hK]
      exact (compose_eq_flatten a' b').symm)
  rw [e1, e2] at key
  exact key

theorem FactorRel.revIf (c : Bool) {δ : List ℕ} {M : ℕ} (hδ : SkewRibbonCoarsenings.IsParts δ)
    (hs : δ.sum = M) : FactorRel δ (SkewRibbonCoarsenings.revIf c δ) M := by
  cases c
  · have e : SkewRibbonCoarsenings.revIf false δ = δ := by simp [SkewRibbonCoarsenings.revIf]
    rw [e]
    exact ⟨hδ, hδ, hs, hs, RibbonFactorReversal.refl _⟩
  · have e : SkewRibbonCoarsenings.revIf true δ = δ.reverse := by
      simp [SkewRibbonCoarsenings.revIf]
    rw [e]
    have hr : SkewRibbonCoarsenings.IsParts δ.reverse := fun x hx =>
      hδ x (List.mem_reverse.mp hx)
    have hsr : δ.reverse.sum = M := by rw [List.sum_reverse]; exact hs
    refine ⟨hδ, hr, hs, hsr, ?_⟩
    have key := RibbonFactorReversal.reverse (listComposition δ M hδ hs)
    have e2 : listComposition δ.reverse M hr hsr = (listComposition δ M hδ hs).reverse :=
      Composition.ext (by simp [listComposition])
    rw [e2]
    exact key

theorem factorRel_of_witness : ∀ (δs : List (List ℕ)) (fl : List Bool),
    (∀ δ ∈ δs, SkewRibbonCoarsenings.IsParts δ ∧ δ ≠ []) → fl.length = δs.length →
      FactorRel (SkewRibbonCoarsenings.compProd δs)
        (SkewRibbonCoarsenings.compProd (List.zipWith SkewRibbonCoarsenings.revIf fl δs))
        (SkewRibbonCoarsenings.compProd δs).sum
  | [], fl, _, hfl => by
    have hfl0 : fl = [] := List.length_eq_zero_iff.mp (by simpa using hfl)
    subst hfl0
    have hp : SkewRibbonCoarsenings.IsParts [1] := by intro x hx; simp at hx; omega
    change FactorRel [1] [1] 1
    exact ⟨hp, hp, rfl, rfl, RibbonFactorReversal.refl _⟩
  | δ :: δs, fl, h, hfl => by
    cases fl with
    | nil => simp at hfl
    | cons c fl =>
      have hfl' : fl.length = δs.length := by simpa using hfl
      have h' : ∀ x ∈ δs, SkewRibbonCoarsenings.IsParts x ∧ x ≠ [] :=
        fun x hx => h x (List.mem_cons_of_mem _ hx)
      obtain ⟨hδ, hδ0⟩ := h δ (by simp)
      obtain ⟨hC, hC0⟩ := SkewRibbonCoarsenings.isParts_compProd δs h'
      have hM : 0 < δ.sum := SkewRibbonCoarsenings.sum_pos_of_ne_nil hδ hδ0
      have hK : 0 < (SkewRibbonCoarsenings.compProd δs).sum :=
        SkewRibbonCoarsenings.sum_pos_of_ne_nil hC hC0
      have hc := FactorRel.compose hM hK (FactorRel.revIf c hδ rfl)
        (factorRel_of_witness δs fl h' hfl')
      rw [← SkewRibbonCoarsenings.sum_compose] at hc
      exact hc

/-- Every actual copied factor witness is a finite factor-reversal construction. -/
theorem factorReversal_of_witness {N : ℕ} (α β : Composition N)
    (hw : SkewRibbonCoarsenings.FactorWitness N (SkewRibbonCoarsenings.partsCuts α.blocks)
      (SkewRibbonCoarsenings.partsCuts β.blocks)) :
    RibbonFactorReversal α β := by
  obtain ⟨δs, fl, hδ, hfl, hs, hc, hc'⟩ := hw
  have hα : SkewRibbonCoarsenings.IsParts α.blocks := fun a ha => α.blocks_pos ha
  have hβ : SkewRibbonCoarsenings.IsParts β.blocks := fun a ha => β.blocks_pos ha
  obtain ⟨hP, hP0⟩ := SkewRibbonCoarsenings.isParts_compProd δs hδ
  have hz : ∀ x ∈ List.zipWith SkewRibbonCoarsenings.revIf fl δs,
      SkewRibbonCoarsenings.IsParts x ∧ x ≠ [] := by
    intro x hx
    obtain ⟨i, hi, rfl⟩ := List.mem_iff_getElem.mp hx
    simp only [List.getElem_zipWith]
    have := hδ (δs[i]'(by simpa [hfl] using hi)) (List.getElem_mem _)
    exact ⟨SkewRibbonCoarsenings.isParts_revIf this.1,
      SkewRibbonCoarsenings.revIf_ne_nil this.2⟩
  obtain ⟨hZ, _⟩ := SkewRibbonCoarsenings.isParts_compProd _ hz
  have hsz := SkewRibbonCoarsenings.sum_compProd_revIf fl δs hfl
  have hsN : (SkewRibbonCoarsenings.compProd δs).sum = N := hs
  have e1 : SkewRibbonCoarsenings.compProd δs = α.blocks :=
    SkewRibbonCoarsenings.partsCuts_injective hP hα (hs.trans α.blocks_sum.symm) hc
  have e2 : SkewRibbonCoarsenings.compProd (List.zipWith SkewRibbonCoarsenings.revIf fl δs) =
      β.blocks :=
    SkewRibbonCoarsenings.partsCuts_injective hZ hβ
      (hsz.trans (hs.trans β.blocks_sum.symm)) hc'
  have key : ∀ N' : ℕ, (SkewRibbonCoarsenings.compProd δs).sum = N' →
      FactorRel (SkewRibbonCoarsenings.compProd δs)
        (SkewRibbonCoarsenings.compProd (List.zipWith SkewRibbonCoarsenings.revIf fl δs)) N' := by
    intro N' hN'
    subst hN'
    exact factorRel_of_witness δs fl hδ hfl
  obtain ⟨h1, h2, h3, h4, hr⟩ := key N hsN
  have f1 : listComposition (SkewRibbonCoarsenings.compProd δs) N h1 h3 = α := Composition.ext e1
  have f2 : listComposition
      (SkewRibbonCoarsenings.compProd (List.zipWith SkewRibbonCoarsenings.revIf fl δs)) N h2 h4 =
      β := Composition.ext e2
  rw [f1, f2] at hr
  exact hr

/-! ### The classification -/

/-- Completeness: equal ribbon functions of the same positive weight are generated by finite
ordinary-composition factor reversals. -/
theorem factorReversal_of_ribbon_eq {N : ℕ} (α β : Composition N) (hN : 0 < N)
    (h : ribbonWord α.blocks = ribbonWord β.blocks) : RibbonFactorReversal α β := by
  have hα : SkewRibbonCoarsenings.IsParts α.blocks := fun a ha => α.blocks_pos ha
  have hβ : SkewRibbonCoarsenings.IsParts β.blocks := fun a ha => β.blocks_pos ha
  have hne : α.blocks ≠ [] := by
    intro e
    have := α.blocks_sum
    rw [e] at this
    simp at this
    omega
  have hsum : α.blocks.sum = β.blocks.sum := by rw [α.blocks_sum, β.blocks_sum]
  have hP : SkewRibbonCoarsenings.ribbonParts α.blocks =
      SkewRibbonCoarsenings.ribbonParts β.blocks :=
    integerLift_injective (by
      rw [integerLift_ribbonParts_word hα, integerLift_ribbonParts_word hβ]
      exact h)
  have hG := (SkewRibbonCoarsenings.ribbonParts_eq_iff hα hβ hne hsum).mp hP
  have hS : SkewRibbonCoarsenings.IsCutSet N (SkewRibbonCoarsenings.partsCuts α.blocks) := by
    have := SkewRibbonCoarsenings.partsCuts_isCutSet hα
    rwa [α.blocks_sum] at this
  have hS' : SkewRibbonCoarsenings.IsCutSet N (SkewRibbonCoarsenings.partsCuts β.blocks) := by
    have := SkewRibbonCoarsenings.partsCuts_isCutSet hβ
    rwa [β.blocks_sum] at this
  have hG' : SkewRibbonCoarsenings.G N (SkewRibbonCoarsenings.partsCuts α.blocks) =
      SkewRibbonCoarsenings.G N (SkewRibbonCoarsenings.partsCuts β.blocks) := by
    unfold SkewRibbonCoarsenings.Gparts at hG
    rwa [α.blocks_sum, β.blocks_sum] at hG
  exact factorReversal_of_witness α β
    ((SkewRibbonCoarsenings.G_eq_iff_factorWitness SkewRibbonCoarsenings.localAlternativeOmega
      (by omega) hS hS').mp hG')

/-- The ribbon class of a positive-weight composition is exactly its factor-reversal class.

**Differs from the paper's route.**  The paper cites the classification of ribbon Schur
equality by factor reversals; this tree reuses the copied proof of the companion and states
the exact set equality for every positive weight. -/
theorem ribbonClass_eq_factorReversal {M : ℕ} (α : Composition M) (hM : 0 < M) :
    ribbonClass α = {β | RibbonFactorReversal α β} := by
  ext β
  constructor
  · intro h
    exact factorReversal_of_ribbon_eq α β hM h.symm
  · intro h
    exact (factor_reversal_ribbon_eq h).symm

end SkewClassInflation
