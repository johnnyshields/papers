import SkewClassInflation.OverlapSignedPeriods
import SkewClassInflation.RibbonFactorInduction

/-!
# Actual factorization when the signed cut period determines all cuts

The cut-encoding seam in the ribbon factor-reversal classification cited after
`thm:sharp-inflation` of `shields-2026-skew-class-inflation.tex`.
A signed period identifies all nonmultiple single-type cuts.  The
remaining full-period obligation concerns zero-sign cuts of types zero
and two, which the signed function alone does not distinguish.
Sorry-free.
-/

namespace SkewClassInflation

/-- A bounded off-multiple period identifies every point with its actual nonzero residue. -/
theorem off_multiple_period_mod {N p : ℕ} (f : ℕ → ℤ) (hp : 0 < p)
    (hper : ∀ x, 0 < x → x + p < N → ¬ p ∣ x → f (x + p) = f x)
    (x : ℕ) (hxN : x < N) (hmod : x % p ≠ 0) : f x = f (x % p) := by
  induction x using Nat.strong_induction_on with
  | h x ih =>
    by_cases hx : x < p
    · rw [Nat.mod_eq_of_lt hx]
    · have hpx : p ≤ x := by omega
      have hy : 0 < x - p := by
        by_contra hn
        have he : x = p := by omega
        rw [he, Nat.mod_self] at hmod
        exact hmod rfl
      have he : x - p + p = x := Nat.sub_add_cancel hpx
      have hres : (x - p) % p = x % p := by
        have hh := congrArg (fun z => z % p) he
        simpa only [Nat.add_mod, Nat.mod_self, Nat.add_zero, Nat.mod_mod] using hh
      have hdiv : ¬ p ∣ x - p := by
        intro hd
        have hm := Nat.mod_eq_zero_of_dvd hd
        rw [hres] at hm
        exact hmod hm
      have hs := hper (x - p) hy (by omega) hdiv
      rw [he] at hs
      rw [hs, ih (x - p) (by omega) (by omega) (by rwa [hres]), hres]

/-- A nonzero signed cut value uniquely determines the actual unreflected membership. -/
theorem cut_membership_of_nonzero_sign_eq {N : ℕ} (α : Composition N) (x y : ℕ)
    (he : compositionCutSign α x = compositionCutSign α y)
    (hne : compositionCutSign α x ≠ 0) : (x ∈ properCuts α ↔ y ∈ properCuts α) := by
  classical
  unfold compositionCutSign at he hne
  split_ifs at he hne <;> simp_all

/-- Every single-type coordinate has a genuinely nonzero signed value. -/
theorem compositionCutSign_ne_zero_of_one {N : ℕ} (α : Composition N) (x : ℕ)
    (hx : compositionCutType α x = 1) : compositionCutSign α x ≠ 0 := by
  rw [compositionCutSign_of_one α x hx]
  split_ifs <;> decide

/-- At a nonzero-sign coordinate the actual signed period already gives full cut periodicity. -/
theorem signed_period_cut_membership {N p : ℕ} (α : Composition N) (hp : 0 < p)
    (hper : ∀ x, 0 < x → x + p < N → ¬ p ∣ x →
      compositionCutSign α (x + p) = compositionCutSign α x)
    (x : ℕ) (hxN : x < N) (hmod : x % p ≠ 0)
    (hne : compositionCutSign α x ≠ 0) :
    x ∈ properCuts α ↔ x % p ∈ properCuts α :=
  cut_membership_of_nonzero_sign_eq α x (x % p)
    (off_multiple_period_mod (compositionCutSign α) hp hper x hxN hmod) hne

/-- Prime total weight excludes every actual nonreconstructible ribbon. -/
theorem ribbonReconstructible_of_prime_weight {N : ℕ} (α : Composition N)
    (hN : N.Prime) : ribbonReconstructible α := by
  by_contra hn
  obtain ⟨p, _, hp, hpN, hd, _⟩ := nonreconstructible_signed_period_witness α hn
  rcases (Nat.dvd_prime hN).mp hd with he | he <;> omega

/-- All prime-weight ribbon mates are generated by an actual whole-word reversal. -/
theorem ribbonFactorComplete_of_prime_weight {N : ℕ} (α : Composition N)
    (hN : N.Prime) : ribbonFactorComplete α :=
  ribbonFactorComplete_of_reconstructible α (ribbonReconstructible_of_prime_weight α hN)

end SkewClassInflation
