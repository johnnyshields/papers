/-!
# Normalization

Formalizes `shields-2026-ribbon-coarsenings.tex`, section `sec:balance` (`prop:normalization`,
`eq:gcd-normalization`, `eq:w`, `eq:basic-periods`, `eq:mask`, `eq:mask-odd`).

`normalization` is `prop:normalization`: from equal two-block inventories and `eq:FE`, for
originals that are neither identical nor reversals, it produces `S'' ∈ {S', revCuts n S'}` and
`d, e` with `NormalizedSetting n S S'' d e`.  It takes **`thm:support` as the explicit hypothesis
`hsupp : SupportSeparation`**, proved by another module as `supportSeparation`; the final assembly
applies `normalization` to that theorem.  Everything else (the grid/subgroup arithmetic, the
shift lemma from `eq:FE`, the restriction to a subgroup, the least period of `w`, the mask
identity) is proved here.  Sorry-free.
-/

namespace SkewRibbonCoarsenings

open Finset

section Grid

variable {n : ℕ}

theorem dvd_supportGcd_iff (hn : 0 < n) (f : ZMod n → ℤ) (g : ℕ) :
    g ∣ supportGcd f ↔ g ∣ n ∧ ∀ x : ZMod n, f x ≠ 0 → g ∣ x.val := by
  have : NeZero n := ⟨hn.ne'⟩
  unfold supportGcd
  rw [Nat.dvd_gcd_iff, Finset.dvd_gcd_iff]
  refine and_congr Iff.rfl ⟨fun h x hx => ?_, fun h k hk => ?_⟩
  · have := h x.val (by simp [ZMod.val_lt x, hx])
    simpa using this
  · simp only [Finset.mem_filter, Finset.mem_range] at hk
    have := h (k : ZMod n) hk.2
    rwa [ZMod.val_natCast_of_lt hk.1] at this

theorem grid_iff [NeZero n] {g : ℕ} (hg : g ∣ n) (x : ZMod n) :
    g ∣ x.val ↔ ZMod.castHom hg (ZMod g) x = 0 := by
  rw [ZMod.castHom_apply, ← ZMod.natCast_val, ZMod.natCast_eq_zero_iff]

theorem grid_add [NeZero n] {g : ℕ} (hg : g ∣ n) {x y : ZMod n} (hx : g ∣ x.val)
    (hy : g ∣ y.val) : g ∣ (x + y).val := by
  rw [grid_iff hg] at *
  rw [map_add, hx, hy, add_zero]

theorem grid_neg [NeZero n] {g : ℕ} (hg : g ∣ n) (x : ZMod n) : g ∣ (-x).val ↔ g ∣ x.val := by
  rw [grid_iff hg, grid_iff hg, map_neg, neg_eq_zero]

theorem grid_sub [NeZero n] {g : ℕ} (hg : g ∣ n) {x y : ZMod n} (hx : g ∣ x.val)
    (hy : g ∣ y.val) : g ∣ (x - y).val := by
  rw [grid_iff hg] at *
  rw [map_sub, hx, hy, sub_zero]

theorem grid_add_iff_left [NeZero n] {g : ℕ} (hg : g ∣ n) {x y : ZMod n} (hy : g ∣ y.val) :
    g ∣ (x + y).val ↔ g ∣ x.val := by
  rw [grid_iff hg, grid_iff hg] at *
  rw [map_add, hy, add_zero]


theorem supportGcd_dvd (f : ZMod n → ℤ) : supportGcd f ∣ n := Nat.gcd_dvd_left _ _

theorem supportGcd_pos (hn : 0 < n) (f : ZMod n → ℤ) : 0 < supportGcd f :=
  Nat.pos_of_dvd_of_pos (supportGcd_dvd f) hn

theorem supportGcd_le (hn : 0 < n) (f : ZMod n → ℤ) : supportGcd f ≤ n :=
  Nat.le_of_dvd hn (supportGcd_dvd f)

theorem dvd_val_of_ne (hn : 0 < n) (f : ZMod n → ℤ) {x : ZMod n} (hx : f x ≠ 0) :
    supportGcd f ∣ x.val :=
  ((dvd_supportGcd_iff hn f _).mp dvd_rfl).2 x hx

/-- The grid of multiples of `supportGcd f` is the additive subgroup generated by the support. -/
theorem mem_closure_of_dvd (hn : 0 < n) (f : ZMod n → ℤ) (z : ZMod n)
    (hz : supportGcd f ∣ z.val) : z ∈ AddSubgroup.closure {x : ZMod n | f x ≠ 0} := by
  have : NeZero n := ⟨hn.ne'⟩
  set K := AddSubgroup.closure {x : ZMod n | f x ≠ 0} with hK
  set s : Finset ℕ := (Finset.range n).filter fun k : ℕ => f (k : ZMod n) ≠ 0 with hs
  have h1 : ∀ t : Finset ℕ, t ⊆ s → ((t.gcd id : ℕ) : ZMod n) ∈ K := by
    intro t
    induction t using Finset.induction with
    | empty => intro _; simp
    | insert a t ha ih =>
      intro hts
      have haS : a ∈ s := hts (Finset.mem_insert_self a t)
      have hat : (a : ZMod n) ∈ K := by
        apply AddSubgroup.subset_closure
        simp only [hs, Finset.mem_filter, Finset.mem_range] at haS
        exact haS.2
      have hg := ih (fun x hx => hts (Finset.mem_insert_of_mem hx))
      rw [Finset.gcd_insert]
      have hb := Nat.gcd_eq_gcd_ab a (t.gcd id)
      have : (((Nat.gcd a (t.gcd id)) : ℕ) : ZMod n) =
          (a.gcdA (t.gcd id)) • (a : ZMod n) + (a.gcdB (t.gcd id)) • ((t.gcd id : ℕ) : ZMod n) := by
        have := congrArg (fun z : ℤ => (z : ZMod n)) hb
        simpa [zsmul_eq_mul, mul_comm] using this
      show (((Nat.gcd a (t.gcd id)) : ℕ) : ZMod n) ∈ K
      rw [this]
      exact K.add_mem (K.zsmul_mem hat _) (K.zsmul_mem hg _)
  have hG := h1 s (Finset.Subset.refl s)
  have hd : ((supportGcd f : ℕ) : ZMod n) ∈ K := by
    unfold supportGcd
    have hb := Nat.gcd_eq_gcd_ab n (s.gcd id)
    have : (((Nat.gcd n (s.gcd id)) : ℕ) : ZMod n) =
        (n.gcdB (s.gcd id)) • ((s.gcd id : ℕ) : ZMod n) := by
      have := congrArg (fun z : ℤ => (z : ZMod n)) hb
      simpa [zsmul_eq_mul, mul_comm] using this
    rw [this]
    exact K.zsmul_mem hG _
  obtain ⟨q, hq⟩ := hz
  have : z = q • ((supportGcd f : ℕ) : ZMod n) := by
    rw [← ZMod.natCast_zmod_val z, hq, Nat.cast_mul, nsmul_eq_mul, mul_comm]
  rw [this]
  exact K.nsmul_mem hd q

end Grid

section Abstract

/-- The hypotheses of `thm:support` on a pair `u, v : ℤ/n → ℤ`, together with `eq:FE`: ternary,
odd, nonzero, with disjoint supports. -/
structure UVData {n : ℕ} (u v : ZMod n → ℤ) : Prop where
  tu : ∀ x, u x ∈ ({-1, 0, 1} : Set ℤ)
  tv : ∀ x, v x ∈ ({-1, 0, 1} : Set ℤ)
  uo : IsOdd u
  vo : IsOdd v
  uv : ∀ x, u x * v x = 0
  fe : FEq u v
  u_ne : u ≠ 0
  v_ne : v ≠ 0

variable {n : ℕ} {u v : ZMod n → ℤ}

theorem FEq.symm' (h : FEq u v) : FEq v u := by
  intro x y
  have := h x y
  linarith

theorem UVData.swap (D : UVData u v) : UVData v u :=
  ⟨D.tv, D.tu, D.vo, D.uo, fun x => by rw [mul_comm]; exact D.uv x, D.fe.symm', D.v_ne, D.u_ne⟩

theorem odd_zero' {f : ZMod n → ℤ} (hf : IsOdd f) : f 0 = 0 := by
  have := hf 0
  rw [neg_zero] at this
  omega

/-- The step "for `a ∈ supp v` and `x` outside the `supp v`-grid, `eq:FE` gives
`u(x + a) = u(x)`", extended to the whole grid generated by `supp v`. -/
theorem UVData.shift (D : UVData u v) (hn : 0 < n) {h : ZMod n}
    (hh : supportGcd v ∣ h.val) {x : ZMod n} (hx : ¬ supportGcd v ∣ x.val) : u (x + h) = u x := by
  have : NeZero n := ⟨hn.ne'⟩
  have hgn : supportGcd v ∣ n := supportGcd_dvd v
  have hmem := mem_closure_of_dvd hn v h hh
  have key : ∀ h, h ∈ AddSubgroup.closure {x : ZMod n | v x ≠ 0} →
      supportGcd v ∣ h.val ∧ ∀ x : ZMod n, ¬ supportGcd v ∣ x.val → u (x + h) = u x := by
    intro h hh
    refine AddSubgroup.closure_induction (p := fun h _ => supportGcd v ∣ h.val ∧
      ∀ x : ZMod n, ¬ supportGcd v ∣ x.val → u (x + h) = u x) ?_ ?_ ?_ ?_ hh
    · intro a ha
      have haS : v a ≠ 0 := ha
      have hga : supportGcd v ∣ a.val := dvd_val_of_ne hn v haS
      refine ⟨hga, fun x hx => ?_⟩
      have hvx : v x = 0 := by
        by_contra hne; exact hx (dvd_val_of_ne hn v hne)
      have hvxa : v (x + a) = 0 := by
        by_contra hne
        exact hx ((grid_add_iff_left hgn hga).mp (dvd_val_of_ne hn v hne))
      have hua : u a = 0 := by
        rcases mul_eq_zero.mp (D.uv a) with h | h
        · exact h
        · exact absurd h haS
      have := D.fe x a
      rw [hvx, hua, hvxa] at this
      have h2 : (u x - u (x + a)) * v a = 0 := by linarith
      rcases mul_eq_zero.mp h2 with h | h
      · linarith
      · exact absurd h haS
    · refine ⟨by simp, fun x _ => by simp⟩
    · rintro a b _ _ ⟨hga, ha⟩ ⟨hgb, hb⟩
      refine ⟨grid_add hgn hga hgb, fun x hx => ?_⟩
      rw [← add_assoc, hb _ ((grid_add_iff_left hgn hga).not.mpr hx |> fun h => by
        rwa [grid_add_iff_left hgn hga]), ha x hx]
    · rintro a _ ⟨hga, ha⟩
      refine ⟨(grid_neg hgn a).mpr hga, fun x hx => ?_⟩
      have hx' : ¬ supportGcd v ∣ (x + -a).val := by
        rw [grid_add_iff_left hgn ((grid_neg hgn a).mpr hga)]; exact hx
      have := ha (x + -a) hx'
      rw [neg_add_cancel_right] at this
      exact this.symm
  exact (key h hmem).2 x hx


/-- The nested part of `prop:normalization`, first half: the grids of `supp u` and `supp v` are
comparable under divisibility.  If some `x ∈ supp u` lies outside the grid of `supp v`, then
`eq:FE` shifts `u` by every element of `supp v`, so `supp v` lies in the group generated by
`supp u`; otherwise `supp u` lies in the grid of `supp v`. -/
theorem UVData.dvd_or_dvd (D : UVData u v) (hn : 0 < n) :
    supportGcd u ∣ supportGcd v ∨ supportGcd v ∣ supportGcd u := by
  have : NeZero n := ⟨hn.ne'⟩
  by_cases hex : ∃ x, u x ≠ 0 ∧ ¬ supportGcd v ∣ x.val
  · left
    obtain ⟨x, hx, hxg⟩ := hex
    rw [dvd_supportGcd_iff hn v]
    refine ⟨supportGcd_dvd u, fun a ha => ?_⟩
    have hga : supportGcd v ∣ a.val := dvd_val_of_ne hn v ha
    have hsh := D.shift hn hga hxg
    have h1 : supportGcd u ∣ x.val := dvd_val_of_ne hn u hx
    have h2 : supportGcd u ∣ (x + a).val := dvd_val_of_ne hn u (by rw [hsh]; exact hx)
    have := grid_sub (supportGcd_dvd u) h2 h1
    rwa [show x + a - x = a by ring] at this
  · right
    push_neg at hex
    rw [dvd_supportGcd_iff hn u]
    exact ⟨supportGcd_dvd v, hex⟩

end Abstract

section Restriction

variable {g m n : ℕ}

/-- The inclusion `ι : ℤ/m → ℤ/n`, `k ↦ g k`, of the subgroup `g ℤ/n` when `n = g m`. -/
def gridIncl [NeZero m] (h : n = g * m) : ZMod m →+ ZMod n :=
  AddMonoidHom.mk' (fun k => ((g * k.val : ℕ) : ZMod n)) (by
    intro k l
    rw [ZMod.val_add, ← Nat.cast_add, ← mul_add]
    rw [← ZMod.natCast_mod (g * (k.val + l.val)) n, h, Nat.mul_mod_mul_left, ← h]
)

theorem gridIncl_apply [NeZero m] (h : n = g * m) (k : ZMod m) : gridIncl h k = ((g * k.val : ℕ) : ZMod n) :=
  rfl

theorem gridIncl_val [NeZero m] (h : n = g * m) (hg : 0 < g) (k : ZMod m) :
    (gridIncl h k).val = g * k.val := by
  rw [gridIncl_apply, ZMod.val_natCast_of_lt]
  have := ZMod.val_lt k
  rw [h]
  exact Nat.mul_lt_mul_of_pos_left this hg

theorem gridIncl_surj [NeZero m] [NeZero n] (h : n = g * m) (x : ZMod n) (hx : g ∣ x.val) :
    ∃ k, gridIncl h k = x := by
  obtain ⟨q, hq⟩ := hx
  have hqm : q < m := by
    have := ZMod.val_lt x
    rw [hq, h] at this
    exact lt_of_mul_lt_mul_left this (Nat.zero_le _)
  refine ⟨(q : ZMod m), ?_⟩
  rw [gridIncl_apply, ZMod.val_natCast_of_lt hqm, ← hq, ZMod.natCast_zmod_val]


theorem supportGcd_restrict_eq_one [NeZero m] [NeZero n] (h : n = g * m) (f : ZMod n → ℤ)
    (hg : g = supportGcd f) : supportGcd (fun k : ZMod m => f (gridIncl h k)) = 1 := by
  have hn : 0 < n := Nat.pos_of_ne_zero (NeZero.ne n)
  have hm : 0 < m := Nat.pos_of_ne_zero (NeZero.ne m)
  have hgpos : 0 < g := hg ▸ supportGcd_pos hn f
  set t := supportGcd (fun k : ZMod m => f (gridIncl h k)) with ht
  have htm : t ∣ m := supportGcd_dvd _
  have htk : ∀ k : ZMod m, f (gridIncl h k) ≠ 0 → t ∣ k.val :=
    fun k hk => dvd_val_of_ne hm (fun k : ZMod m => f (gridIncl h k)) hk
  have : g * t ∣ supportGcd f := by
    rw [dvd_supportGcd_iff hn f]
    refine ⟨by rw [h]; exact mul_dvd_mul_left g htm, fun x hx => ?_⟩
    have hgx : g ∣ x.val := hg ▸ dvd_val_of_ne hn f hx
    obtain ⟨k, rfl⟩ := gridIncl_surj h x hgx
    rw [gridIncl_val h hgpos]
    exact mul_dvd_mul_left g (htk k hx)
  rw [← hg] at this
  have h1 : t ∣ 1 := Nat.dvd_of_mul_dvd_mul_left hgpos (by simpa using this)
  exact Nat.dvd_one.mp h1

end Restriction

section Strict

variable {n : ℕ} {u v : ZMod n → ℤ}

/-- The strictness half of the nested-subgroup assertion of `prop:normalization`: the subgroups
generated by `supp u` and `supp v` are different.  If both had the same `gcd(n, ·) = g`, the
restriction of `u, v` to the subgroup `g ℤ/n ≅ ℤ/(n/g)` would satisfy the hypotheses of
`thm:support` and both restricted supports would generate the whole group. -/
theorem UVData.gcd_ne (hsupp : SupportSeparation) (D : UVData u v) (hn : 0 < n) :
    supportGcd u ≠ supportGcd v := by
  intro heq
  have : NeZero n := ⟨hn.ne'⟩
  set g := supportGcd u with hg
  have hgn : g ∣ n := supportGcd_dvd u
  obtain ⟨m, hm⟩ := hgn
  have hgpos : 0 < g := supportGcd_pos hn u
  have hmpos : 0 < m := by
    rcases Nat.eq_zero_or_pos m with h0 | h0
    · subst h0; simp at hm; omega
    · exact h0
  have : NeZero m := ⟨hmpos.ne'⟩
  obtain ⟨x0, hx0⟩ : ∃ x, u x ≠ 0 := by
    by_contra hcon; push_neg at hcon; exact D.u_ne (funext hcon)
  obtain ⟨y0, hy0⟩ : ∃ x, v x ≠ 0 := by
    by_contra hcon; push_neg at hcon; exact D.v_ne (funext hcon)
  obtain ⟨k0, hk0⟩ := gridIncl_surj hm x0 (dvd_val_of_ne hn u hx0)
  obtain ⟨l0, hl0⟩ := gridIncl_surj hm y0 (heq ▸ dvd_val_of_ne hn v hy0)
  set ι := gridIncl (g := g) (m := m) (n := n) hm with hι
  have hu1 := supportGcd_restrict_eq_one hm u rfl
  have hv1 := supportGcd_restrict_eq_one hm v heq
  have hm2 : 2 ≤ m := by
    by_contra hlt
    have h1 : m = 1 := by omega
    subst h1
    have hk : k0 = 0 := Subsingleton.elim _ _
    have : u (ι 0) = 0 := by
      rw [map_zero]; exact odd_zero' D.uo
    rw [hk] at hk0
    rw [hk0] at this
    exact hx0 this
  refine (hsupp m (fun k => u (ι k)) (fun k => v (ι k)) hm2 (fun k => D.tu _) (fun k => D.tv _)
    ?_ ?_ ?_ ?_ ?_ ?_).elim (fun h => h hu1) (fun h => h hv1)
  · intro hz; apply hx0; rw [← hk0]; exact congrFun hz k0
  · intro hz; apply hy0; rw [← hl0]; exact congrFun hz l0
  · intro k; show u (ι (-k)) = -u (ι k); rw [map_neg]; exact D.uo _
  · intro k; show v (ι (-k)) = -v (ι k); rw [map_neg]; exact D.vo _
  · intro k; exact D.uv _
  · intro x y
    have := D.fe (ι x) (ι y)
    rw [← map_add] at this
    exact this


/-- `x ∈ ⟨supp f⟩` exactly when `supportGcd f` divides the representative of `x`: the subgroup
generated by the support of `f` is the grid of multiples of `gcd(n, supp f)`. -/
theorem mem_closure_iff (hn : 0 < n) (f : ZMod n → ℤ) (z : ZMod n) :
    z ∈ AddSubgroup.closure {x : ZMod n | f x ≠ 0} ↔ supportGcd f ∣ z.val := by
  have : NeZero n := ⟨hn.ne'⟩
  refine ⟨fun hz => ?_, mem_closure_of_dvd hn f z⟩
  have hgn : supportGcd f ∣ n := supportGcd_dvd f
  refine AddSubgroup.closure_induction (p := fun z _ => supportGcd f ∣ z.val) ?_ ?_ ?_ ?_ hz
  · intro x hx; exact dvd_val_of_ne hn f hx
  · simp
  · intro x y _ _ hx hy; exact grid_add hgn hx hy
  · intro x _ hx; exact (grid_neg hgn x).mpr hx

/-- `prop:normalization`, nested subgroups: the subgroups generated by `supp u` and `supp v` are
strictly nested (one is a proper subgroup of the other), given `thm:support`
(`hsupp : SupportSeparation`, proved elsewhere). -/
theorem UVData.strictly_nested (hsupp : SupportSeparation) (D : UVData u v) (hn : 0 < n) :
    AddSubgroup.closure {x : ZMod n | u x ≠ 0} < AddSubgroup.closure {x : ZMod n | v x ≠ 0} ∨
    AddSubgroup.closure {x : ZMod n | v x ≠ 0} < AddSubgroup.closure {x : ZMod n | u x ≠ 0} := by
  have hne := D.gcd_ne hsupp hn
  have hlt : ∀ f f' : ZMod n → ℤ, supportGcd f ∣ supportGcd f' → supportGcd f ≠ supportGcd f' →
      AddSubgroup.closure {x : ZMod n | f' x ≠ 0} < AddSubgroup.closure {x : ZMod n | f x ≠ 0} := by
    intro f f' hd hne'
    refine lt_of_le_of_ne ?_ ?_
    · intro z hz
      rw [mem_closure_iff hn] at hz ⊢
      exact hd.trans hz
    · intro heq
      have : NeZero n := ⟨hn.ne'⟩
      have hmem : ((supportGcd f : ℕ) : ZMod n) ∈ AddSubgroup.closure {x : ZMod n | f x ≠ 0} := by
        rw [mem_closure_iff hn, ZMod.val_natCast]
        exact (Nat.dvd_mod_iff (supportGcd_dvd f)).mpr dvd_rfl
      rw [← heq, mem_closure_iff hn, ZMod.val_natCast,
        Nat.dvd_mod_iff (supportGcd_dvd f')] at hmem
      exact hne' (Nat.dvd_antisymm hd hmem)
  rcases D.dvd_or_dvd hn with h | h
  · right; exact hlt u v h hne
  · left; exact hlt v u h hne.symm

end Strict

section Periods

variable {n : ℕ}

/-- The subgroup of periods of `f : ℤ/n → ℤ`. -/
def periodSubgroup (f : ZMod n → ℤ) : AddSubgroup (ZMod n) where
  carrier := {z | ∀ x, f (x + z) = f x}
  zero_mem' := fun x => by simp
  add_mem' := by
    intro a b ha hb x
    rw [← add_assoc, hb, ha]
  neg_mem' := by
    intro a ha x
    have := ha (x + -a)
    rw [neg_add_cancel_right] at this
    exact this.symm

theorem isPeriod_iff_mem (f : ZMod n → ℤ) (p : ℕ) :
    IsPeriod f p ↔ (p : ZMod n) ∈ periodSubgroup f := Iff.rfl

theorem isPeriod_gcd {f : ZMod n → ℤ} {p q : ℕ} (hp : IsPeriod f p) (hq : IsPeriod f q) :
    IsPeriod f (Nat.gcd p q) := by
  rw [isPeriod_iff_mem] at *
  have hb := Nat.gcd_eq_gcd_ab p q
  have : (((Nat.gcd p q) : ℕ) : ZMod n) = (p.gcdA q) • (p : ZMod n) + (p.gcdB q) • (q : ZMod n) := by
    have := congrArg (fun z : ℤ => (z : ZMod n)) hb
    simpa [zsmul_eq_mul, mul_comm] using this
  rw [this]
  exact (periodSubgroup f).add_mem ((periodSubgroup f).zsmul_mem hp _) ((periodSubgroup f).zsmul_mem hq _)

theorem period_mul {f : ZMod n → ℤ} {p : ℕ} (hp : IsPeriod f p) (k : ℕ) (x : ZMod n) :
    f (x + ((k * p : ℕ) : ZMod n)) = f x := by
  have : ((k * p : ℕ) : ZMod n) ∈ periodSubgroup f := by
    rw [Nat.cast_mul, ← nsmul_eq_mul]
    exact (periodSubgroup f).nsmul_mem hp k
  exact this x

/-- A function of period dividing `n` is constant on grids: if `p ∣ x.val` then `f x = f 0`. -/
theorem period_grid [NeZero n] {f : ZMod n → ℤ} {p : ℕ} (hp : IsPeriod f p) {x : ZMod n}
    (hx : p ∣ x.val) : f x = f 0 := by
  obtain ⟨k, hk⟩ := hx
  have := period_mul hp k 0
  rw [zero_add, ← mul_comm, ← hk, ZMod.natCast_zmod_val] at this
  exact this

/-- An odd function with period `1` or `2` (a period dividing `n`) vanishes. -/
theorem odd_period_small [NeZero n] {f : ZMod n → ℤ} (ho : IsOdd f) {p : ℕ} (hp : IsPeriod f p)
    (hp2 : p ≤ 2) (hp0 : 0 < p) : f = 0 := by
  funext x
  have h0 : f 0 = 0 := odd_zero' ho
  interval_cases p
  · have := period_grid hp (one_dvd x.val)
    simp only [Pi.zero_apply]; rw [this, h0]
  · rcases Nat.even_or_odd x.val with he | hodd
    · have := period_grid hp (even_iff_two_dvd.mp he)
      simp only [Pi.zero_apply]; rw [this, h0]
    · have h1 : f 1 = 0 := by
        -- `1 + 2 · (-1) = -1`, so `f (-1) = f 1`; oddness gives `f 1 = - f 1`
        have hm := hp
        have a := hm (-1 : ZMod n)
        have b : (-1 : ZMod n) + (2 : ℕ) = 1 := by push_cast; ring
        rw [b] at a
        have c := ho 1
        omega
      obtain ⟨k, hk⟩ := hodd
      have := period_mul hp k 1
      have e : x = 1 + ((k * 2 : ℕ) : ZMod n) := by
        rw [← ZMod.natCast_zmod_val x, hk]; push_cast; ring
      simp only [Pi.zero_apply]
      rw [e, this, h1]

end Periods

section Reversal

variable {n : ℕ}

theorem isCutSet_revCuts {S : Finset ℕ} (hS : IsCutSet n S) : IsCutSet n (revCuts n S) := by
  intro x hx
  obtain ⟨s, hs, rfl⟩ := Finset.mem_image.mp hx
  have := Finset.mem_Ioo.mp (hS hs)
  exact Finset.mem_Ioo.mpr ⟨by omega, by omega⟩

theorem revCuts_involutive {S : Finset ℕ} (hS : IsCutSet n S) : revCuts n (revCuts n S) = S := by
  unfold revCuts
  rw [Finset.image_image]
  conv_rhs => rw [← Finset.image_id (s := S)]
  apply Finset.image_congr
  intro s hs
  have := Finset.mem_Ioo.mp (hS hs)
  simp only [Function.comp, id]
  omega

/-- The cut indicator of the reversal is the reflected cut indicator: `cutInd (β*) x = b(-x)`. -/
theorem cutInd_revCuts (hn : 0 < n) {S : Finset ℕ} (hS : IsCutSet n S) (x : ZMod n) :
    cutInd n (revCuts n S) x = cutInd n S (-x) := by
  have : NeZero n := ⟨hn.ne'⟩
  unfold cutInd
  rw [ZMod.neg_val]
  by_cases hx : x = 0
  · subst hx
    have : (0 : ℕ) ∉ revCuts n S := by
      intro h
      have := Finset.mem_Ioo.mp (isCutSet_revCuts hS h); omega
    have h0 : (0 : ℕ) ∉ S := fun h => by have := Finset.mem_Ioo.mp (hS h); omega
    simp [this, h0]
  · rw [if_neg hx]
    have hxv : 0 < x.val := Nat.pos_of_ne_zero (fun h => hx ((ZMod.val_eq_zero x).mp h))
    have hxl := ZMod.val_lt x
    have : x.val ∈ revCuts n S ↔ n - x.val ∈ S := by
      unfold revCuts
      rw [Finset.mem_image]
      constructor
      · rintro ⟨s, hs, hsx⟩
        have := Finset.mem_Ioo.mp (hS hs)
        have e : s = n - x.val := by omega
        rwa [← e]
      · intro h
        refine ⟨n - x.val, h, ?_⟩
        omega
    simp only [this]

theorem cutInd_ext {S S' : Finset ℕ} (hS : IsCutSet n S) (hS' : IsCutSet n S')
    (h : ∀ x : ZMod n, cutInd n S x = cutInd n S' x) : S = S' := by
  ext t
  by_cases ht : t ∈ Finset.Ioo 0 n
  · have htn := (Finset.mem_Ioo.mp ht).2
    have := h (t : ZMod n)
    rw [cutInd_natCast htn, cutInd_natCast htn] at this
    by_cases h1 : t ∈ S <;> by_cases h2 : t ∈ S' <;> simp_all
  · have h1 : t ∉ S := fun h => ht (hS h)
    have h2 : t ∉ S' := fun h => ht (hS' h)
    simp [h1, h2]

theorem uFun_rev (hn : 0 < n) {S S' : Finset ℕ} (hS' : IsCutSet n S') :
    uFun n S (revCuts n S') = vFun n S S' := by
  funext x
  unfold uFun vFun
  rw [cutInd_revCuts hn hS', neg_neg]

theorem vFun_rev (hn : 0 < n) {S S' : Finset ℕ} (hS' : IsCutSet n S') :
    vFun n S (revCuts n S') = uFun n S S' := by
  funext x
  unfold uFun vFun
  rw [cutInd_revCuts hn hS']

theorem vFun_eq_zero_iff {S S' : Finset ℕ} (hS : IsCutSet n S) (hS' : IsCutSet n S') :
    vFun n S S' = 0 ↔ S = S' := by
  constructor
  · intro h
    apply cutInd_ext hS hS'
    intro x
    have := congrFun h x
    unfold vFun at this
    simp only [Pi.zero_apply] at this
    omega
  · rintro rfl
    funext x; simp [vFun]

theorem uFun_eq_zero_iff (hn : 0 < n) {S S' : Finset ℕ} (hS : IsCutSet n S)
    (hS' : IsCutSet n S') : uFun n S S' = 0 ↔ S' = revCuts n S := by
  have := vFun_eq_zero_iff hS (isCutSet_revCuts hS')
  rw [← vFun_rev hn hS', this]
  constructor
  · intro h
    rw [h, revCuts_involutive hS']
  · intro h
    rw [h, revCuts_involutive hS]

end Reversal

section Core

variable {n : ℕ} {u v : ZMod n → ℤ}

/-- The function `w` of `eq:w` for the pair `u, v` and the divisor `d`. -/
def wOf (u : ZMod n → ℤ) (d : ℕ) (x : ZMod n) : ℤ := if d ∣ x.val then 0 else u x

theorem UVData.d_lt (D : UVData u v) (hn : 0 < n) : supportGcd v < n := by
  have : NeZero n := ⟨hn.ne'⟩
  refine lt_of_le_of_ne (supportGcd_le hn v) (fun h => ?_)
  apply D.v_ne
  funext x
  by_contra hx
  have h1 := dvd_val_of_ne hn v hx
  rw [h] at h1
  have : x.val = 0 := Nat.eq_zero_of_dvd_of_lt h1 (ZMod.val_lt x)
  have : x = 0 := (ZMod.val_eq_zero x).mp this
  subst this
  exact hx (odd_zero' D.vo)

theorem UVData.ratio (D : UVData u v) (hn : 0 < n) : 3 ≤ n / supportGcd v := by
  have : NeZero n := ⟨hn.ne'⟩
  set d := supportGcd v with hd
  have hdn : d ∣ n := supportGcd_dvd v
  have hdpos : 0 < d := supportGcd_pos hn v
  have hlt := D.d_lt hn
  obtain ⟨m, hm⟩ := hdn
  have hm' : n / d = m := by rw [hm]; exact Nat.mul_div_cancel_left m hdpos
  rw [hm']
  have hm2 : 2 ≤ m := by
    by_contra hcon
    have : m ≤ 1 := by omega
    have : d * m ≤ d * 1 := Nat.mul_le_mul_left d this
    omega
  by_contra hcon
  have hm2' : m = 2 := by omega
  rw [hm2'] at hm
  apply D.v_ne
  funext x
  show v x = 0
  by_contra hx
  have h1 := dvd_val_of_ne hn v hx
  obtain ⟨k, hk⟩ := h1
  have hk : x.val = d * k := hk
  have hxl := ZMod.val_lt x
  have hk2 : k < 2 := by
    have h3 : d * k < d * 2 := by omega
    exact lt_of_mul_lt_mul_left h3 (Nat.zero_le _)
  interval_cases k
  · have : x = 0 := (ZMod.val_eq_zero x).mp (by simpa using hk)
    subst this
    exact hx (odd_zero' D.vo)
  · have hxd : x = (d : ZMod n) := by
      rw [← ZMod.natCast_zmod_val x, hk, mul_one]
    have h2d : ((d : ℕ) : ZMod n) * 2 = 0 := by
      have : ((d * 2 : ℕ) : ZMod n) = 0 := by rw [← hm]; exact ZMod.natCast_self n
      push_cast at this
      exact this
    have hneg : -x = x := by
      rw [hxd]
      linear_combination (-1 : ZMod n) * h2d
    have := D.vo x
    rw [hneg] at this
    exact hx (by omega)

theorem wOf_ne (hn : 0 < n) (hgd : supportGcd u ∣ supportGcd v)
    (hne : supportGcd u ≠ supportGcd v) : wOf u (supportGcd v) ≠ 0 := by
  intro hw
  apply hne
  apply Nat.dvd_antisymm hgd
  rw [dvd_supportGcd_iff hn u]
  refine ⟨supportGcd_dvd v, fun x hx => ?_⟩
  by_contra hxg
  have := congrFun hw x
  simp only [wOf, if_neg hxg, Pi.zero_apply] at this
  exact hx this

end Core

section Normalize

variable {n : ℕ} {u v : ZMod n → ℤ} {S S' : Finset ℕ}

theorem wOf_odd (D : UVData u v) (hn : 0 < n) (d : ℕ) (hd : d ∣ n) : IsOdd (wOf u d) := by
  have : NeZero n := ⟨hn.ne'⟩
  intro x
  unfold wOf
  by_cases h : d ∣ x.val
  · have : d ∣ (-x).val := (grid_neg hd x).mpr h
    simp [h, this]
  · have : ¬ d ∣ (-x).val := fun h' => h ((grid_neg hd x).mp h')
    simp [h, this, D.uo x]

theorem wOf_period (D : UVData u v) (hn : 0 < n) : IsPeriod (wOf u (supportGcd v)) (supportGcd v) := by
  have : NeZero n := ⟨hn.ne'⟩
  set d := supportGcd v with hd
  have hdn : d ∣ n := supportGcd_dvd v
  have hdl : d < n := D.d_lt hn
  have hval : ((d : ℕ) : ZMod n).val = d := ZMod.val_natCast_of_lt hdl
  intro x
  unfold wOf
  have hiff : d ∣ (x + (d : ZMod n)).val ↔ d ∣ x.val :=
    grid_add_iff_left hdn (by rw [hval])
  by_cases h : d ∣ x.val
  · simp [h, hiff.mpr h]
  · have h' : ¬ d ∣ (x + (d : ZMod n)).val := fun h' => h (hiff.mp h')
    simp only [h, h', if_false]
    exact D.shift hn (h := (d : ZMod n)) (by rw [hval]) h


/-- The least period of `w = wOf u d` (`d` its `d`-periodicity) exists and satisfies
`eq:basic-periods`: `3 ≤ e`, `e ∣ d`. -/
theorem exists_least_period (D : UVData u v) (hn : 0 < n) (hgd : supportGcd u ∣ supportGcd v)
    (hne : supportGcd u ≠ supportGcd v) :
    ∃ e, IsLeastPeriod (wOf u (supportGcd v)) e ∧ 3 ≤ e ∧ e ∣ supportGcd v := by
  classical
  have : NeZero n := ⟨hn.ne'⟩
  set d := supportGcd v with hd
  have hdn : d ∣ n := supportGcd_dvd v
  have hdpos : 0 < d := supportGcd_pos hn v
  have hper := wOf_period D hn
  have hex : ∃ p, 0 < p ∧ p ∣ n ∧ IsPeriod (wOf u d) p := ⟨d, hdpos, hdn, hper⟩
  set e := Nat.find hex with he
  obtain ⟨he0, hen, hep⟩ := Nat.find_spec hex
  have hmin : ∀ p, 0 < p → p ∣ n → IsPeriod (wOf u d) p → e ≤ p :=
    fun p h1 h2 h3 => Nat.find_min' hex ⟨h1, h2, h3⟩
  have hleast : IsLeastPeriod (wOf u d) e := ⟨he0, hen, hep, hmin⟩
  refine ⟨e, hleast, ?_, ?_⟩
  · by_contra hlt
    push_neg at hlt
    exact wOf_ne hn hgd hne (odd_period_small (wOf_odd D hn d hdn) hep (by omega) he0)
  · have hg := isPeriod_gcd hep hper
    have hgpos : 0 < Nat.gcd e d := Nat.gcd_pos_of_pos_left _ he0
    have hgn : Nat.gcd e d ∣ n := (Nat.gcd_dvd_left e d).trans hen
    have := hmin _ hgpos hgn hg
    have hle : Nat.gcd e d ≤ e := Nat.le_of_dvd he0 (Nat.gcd_dvd_left e d)
    have heq : Nat.gcd e d = e := le_antisymm hle this
    rw [← heq]
    exact Nat.gcd_dvd_right e d


/-- `eq:mask-odd`: for `e ∣ p ∣ d` the mask `𝓑_p` of `eq:mask` has odd part `w`.  Off the
`p`-grid one is off the `d`-grid, where `v = 0`, so `b(x) - b(-x) = u(x) = w(x)`; on the `p`-grid
`w = 0` because `e ∣ p` and `w` is `e`-periodic and odd. -/
theorem mask_odd_of (D : UVData (uFun n S S') (vFun n S S')) (hn : 0 < n)
    (htau : ∀ x : ZMod n, cutInd n S x + cutInd n S (-x) = cutInd n S' x + cutInd n S' (-x))
    {e : ℕ} (he : IsLeastPeriod (wFun n S S' (supportGcd (vFun n S S'))) e)
    {p : ℕ} (hep : e ∣ p) (hpd : p ∣ supportGcd (vFun n S S')) (x : ZMod n) :
    maskFun n S p x - maskFun n S p (-x) = wFun n S S' (supportGcd (vFun n S S')) x := by
  have : NeZero n := ⟨hn.ne'⟩
  set d := supportGcd (vFun n S S') with hd
  have hdn : d ∣ n := supportGcd_dvd _
  have hpn : p ∣ n := hpd.trans hdn
  unfold maskFun
  by_cases hp : p ∣ x.val
  · have hp' : p ∣ (-x).val := (grid_neg hpn x).mpr hp
    rw [if_pos hp, if_pos hp', sub_zero]
    -- `w` vanishes on the `p`-grid
    have hw : wFun n S S' d x = 0 := by
      have hper : IsPeriod (wFun n S S' d) p := by
        intro y
        obtain ⟨k, hk⟩ := hep
        have := period_mul he.2.2.1 k y
        rw [hk] at *
        simpa [mul_comm] using this
      rw [period_grid hper hp]
      exact odd_zero' (wOf_odd D hn d hdn) |> fun h => by
        simpa [wFun, wOf] using h
    rw [hw]
  · have hp' : ¬ p ∣ (-x).val := fun h => hp ((grid_neg hpn x).mp h)
    rw [if_neg hp, if_neg hp']
    have hdx : ¬ d ∣ x.val := fun h => hp ((hpd.trans h))
    have hv : vFun n S S' x = 0 := by
      by_contra hne
      exact hdx (dvd_val_of_ne hn _ hne)
    unfold wFun
    rw [if_neg hdx]
    unfold uFun
    unfold vFun at hv
    have := htau x
    omega


theorem wFun_eq_wOf (n : ℕ) (S S' : Finset ℕ) (d : ℕ) :
    wFun n S S' d = wOf (uFun n S S') d := rfl

/-- The conclusions of `prop:normalization` for a pair that is already oriented (the subgroup of
`supp u` is properly inside that of `supp v`), as a `NormalizedSetting`. -/
theorem normalizedSetting_of_oriented (hn : 0 < n) (hS : IsCutSet n S) (hS' : IsCutSet n S')
    (htau : ∀ x : ZMod n, cutInd n S x + cutInd n S (-x) = cutInd n S' x + cutInd n S' (-x))
    (D : UVData (uFun n S S') (vFun n S S'))
    (hgd : supportGcd (uFun n S S') ∣ supportGcd (vFun n S S'))
    (hne : supportGcd (uFun n S S') ≠ supportGcd (vFun n S S')) :
    ∃ e, NormalizedSetting n S S' (supportGcd (vFun n S S')) e := by
  obtain ⟨e, he, he3, hed⟩ := exists_least_period D hn hgd hne
  refine ⟨e, ?_⟩
  exact
  { cuts := hS
    cuts' := hS'
    tau_eq := htau
    u_ne := D.u_ne
    v_ne := D.v_ne
    fe := D.fe
    d_eq := rfl
    gu_dvd := hgd
    gu_ne := hne
    w_ne := wOf_ne hn hgd hne
    w_odd := wOf_odd D hn _ (supportGcd_dvd _)
    w_period := wOf_period D hn
    e_least := he
    three_le_e := he3
    e_dvd_d := hed
    d_lt := D.d_lt hn
    three_le_ratio := D.ratio hn
    mask_odd := fun p hep hpd x => mask_odd_of D hn htau he hep hpd x }


end Normalize

section Main

variable {n : ℕ} {S S' : Finset ℕ}

/-- The pair `u, v` of `eq:uv` satisfies the hypotheses of `thm:support` and `eq:FE`, given
`τ_b = τ_c`, `eq:FE`, and that the originals are neither identical nor reversals. -/
theorem uvData_of (hn : 0 < n) (hS : IsCutSet n S) (hS' : IsCutSet n S')
    (htau : ∀ x : ZMod n, cutInd n S x + cutInd n S (-x) = cutInd n S' x + cutInd n S' (-x))
    (hfe : FEq (uFun n S S') (vFun n S S')) (hid : S ≠ S') (hrev : S' ≠ revCuts n S) :
    UVData (uFun n S S') (vFun n S S') :=
  { tu := uFun_ternary S S'
    tv := vFun_ternary S S'
    uo := uFun_odd htau
    vo := vFun_odd htau
    uv := uFun_mul_vFun htau
    fe := hfe
    u_ne := fun h => hrev ((uFun_eq_zero_iff hn hS hS').mp h)
    v_ne := fun h => hid ((vFun_eq_zero_iff hS hS').mp h) }

/-- `prop:normalization`.  Let `S, S'` be the cut sets of two compositions of weight `n` with equal
two-block inventories (`TwoBlockEq`) satisfying `eq:FE` for the functions `u, v` of `eq:uv`, which
are neither identical (`S ≠ S'`) nor reversals of one another (`S' ≠ revCuts n S`; "if `v = 0` the
originals are identical, if `u = 0` they are literal reversals").  Then, after replacing `γ` by
`γ*` if necessary (`S'' ∈ {S', revCuts n S'}`), the setting of `prop:normalization` holds:
`NormalizedSetting n S S'' d e` collects `eq:gcd-normalization` (`g_u` properly divides
`d = gcd(n, supp v)`), the nonvanishing, oddness and `d`-periodicity of `w` of `eq:w`, the
least period `e` with `eq:basic-periods` (`3 ≤ e ∣ d < n`, `n / d ≥ 3`), and the mask identity
`eq:mask-odd` for every `e ∣ p ∣ d`.  The strict nesting of the two support subgroups is
`UVData.strictly_nested`.

**Uses `thm:support` as the hypothesis `hsupp : SupportSeparation`**: the statement of
`thm:support`, proved in the support-separation module as `supportSeparation`.  The final assembly
applies this theorem to that one. -/
theorem normalization (hsupp : SupportSeparation) (hS : IsCutSet n S) (hS' : IsCutSet n S')
    (h2 : TwoBlockEq n S S') (hfe : FEq (uFun n S S') (vFun n S S'))
    (hid : S ≠ S') (hrev : S' ≠ revCuts n S) :
    ∃ S'' : Finset ℕ, (S'' = S' ∨ S'' = revCuts n S') ∧ ∃ d e : ℕ, NormalizedSetting n S S'' d e := by
  have hn : 0 < n := by
    rcases Nat.eq_zero_or_pos n with h0 | h0
    · subst h0
      exfalso; apply hid
      have e1 : S = ∅ := Finset.subset_empty.mp (by simpa [IsCutSet] using hS)
      have e2 : S' = ∅ := Finset.subset_empty.mp (by simpa [IsCutSet] using hS')
      rw [e1, e2]
    · exact h0
  have htau := tau_eq_of_twoBlockEq hn hS hS' h2
  have htau' : ∀ x : ZMod n, cutInd n S x + cutInd n S (-x) =
      cutInd n S' x + cutInd n S' (-x) := htau
  have D := uvData_of hn hS hS' htau' hfe hid hrev
  rcases D.dvd_or_dvd hn with hd | hd
  · refine ⟨S', Or.inl rfl, supportGcd (vFun n S S'), normalizedSetting_of_oriented hn hS hS' htau' D hd (D.gcd_ne hsupp hn)⟩
  · have hS'r := isCutSet_revCuts hS'
    have htaur : ∀ x : ZMod n, cutInd n S x + cutInd n S (-x) =
        cutInd n (revCuts n S') x + cutInd n (revCuts n S') (-x) := by
      intro x
      rw [cutInd_revCuts hn hS', cutInd_revCuts hn hS', neg_neg, htau' x]
      ring
    have hu := uFun_rev hn (S := S) hS'
    have hv := vFun_rev hn (S := S) hS'
    have D' : UVData (uFun n S (revCuts n S')) (vFun n S (revCuts n S')) := by
      rw [hu, hv]; exact D.swap
    refine ⟨revCuts n S', Or.inr rfl, supportGcd (vFun n S (revCuts n S')), normalizedSetting_of_oriented hn hS hS'r htaur D' ?_ ?_⟩
    · rw [hu, hv]; exact hd
    · rw [hu, hv]; exact (D.gcd_ne hsupp hn).symm

end Main

end SkewRibbonCoarsenings
