import SkewCoframeRigidity.FixedCap.LetterField
import SkewCoframeRigidity.Stationary.Deriv
import SkewCoframeRigidity.Stationary.Transcendence
import SkewCoframeRigidity.Stationary.LowerField

/-!
# An element of a letter field with vanishing derivative lies in the lower letter field

If `f` lies in the field generated by the letters `h_0, …, h_L` and `∂f/∂h_L = 0`, then `f` lies
in the field generated by `h_0, …, h_{L-1}`.  Over the lower field `K₀`, the top letter is
transcendental and `f` is a rational function of it; the derivative is the formal derivative, and
a rational function over a field of characteristic zero with zero derivative is constant.
Sorry-free.
-/

namespace SkewCoframeRigidity.UnitRestoration

open Polynomial

section RatFun

variable {K : Type*} [Field K] [CharZero K]

theorem coeff_derivative_mul_top (p q : K[X]) (hn : 1 ≤ p.natDegree + q.natDegree) :
    (derivative p * q).coeff (p.natDegree + q.natDegree - 1) =
      p.natDegree * p.leadingCoeff * q.leadingCoeff := by
  rcases Nat.eq_zero_or_pos p.natDegree with h0 | hpos
  · have : derivative p = 0 := by
      rw [Polynomial.eq_C_of_natDegree_eq_zero h0]; simp
    rw [this, zero_mul, h0]; simp
  · obtain ⟨n, hn'⟩ : ∃ n, p.natDegree = n + 1 := ⟨p.natDegree - 1, by omega⟩
    have hd : (derivative p).natDegree ≤ n := by
      have := Polynomial.natDegree_derivative_le p
      omega
    have := Polynomial.coeff_mul_add_eq_of_natDegree_le hd (le_refl q.natDegree)
    have e : p.natDegree + q.natDegree - 1 = n + q.natDegree := by omega
    rw [e, this, Polynomial.coeff_derivative, hn']
    simp only [Polynomial.leadingCoeff, hn']
    push_cast
    ring

/-- `a' b = a b'` with `b ≠ 0` forces `a` to be a constant multiple of `b`. -/
theorem eq_const_mul_of_derivative (a b : K[X]) (hb : b ≠ 0)
    (h : derivative a * b = a * derivative b) : ∃ c : K, a = Polynomial.C c * b := by
  induction' hd : a.natDegree using Nat.strong_induction_on with d ih generalizing a
  by_cases ha : a = 0
  · exact ⟨0, by simp [ha]⟩
  have hα0 : a.leadingCoeff ≠ 0 := leadingCoeff_ne_zero.mpr ha
  have hβ0 : b.leadingCoeff ≠ 0 := leadingCoeff_ne_zero.mpr hb
  have hde : d = b.natDegree := by
    by_contra hne
    have hn : 1 ≤ a.natDegree + b.natDegree := by omega
    have h1 := coeff_derivative_mul_top a b hn
    have h2 := coeff_derivative_mul_top b a (by omega)
    rw [h, mul_comm a (derivative b)] at h1
    rw [add_comm b.natDegree a.natDegree] at h2
    have h3 : ((a.natDegree : K) - b.natDegree) * (a.leadingCoeff * b.leadingCoeff) = 0 := by
      linear_combination h2 - h1
    rcases mul_eq_zero.mp h3 with h4 | h4
    · have h5 : (a.natDegree : K) = b.natDegree := sub_eq_zero.mp h4
      exact hne (hd ▸ Nat.cast_injective h5)
    · exact mul_ne_zero hα0 hβ0 h4
  set c : K := a.leadingCoeff / b.leadingCoeff with hc
  set r : K[X] := a - Polynomial.C c * b with hr
  have hrder : derivative r * b = r * derivative b := by
    simp only [hr, derivative_sub, derivative_mul, derivative_C, zero_mul, zero_add, sub_mul,
      mul_sub]
    linear_combination h
  by_cases hr0 : r = 0
  · exact ⟨c, by rw [hr] at hr0; exact sub_eq_zero.mp hr0⟩
  · have hrd : r.natDegree < d := by
      have hle : r.natDegree ≤ d := by
        refine (natDegree_sub_le _ _).trans (max_le (le_of_eq hd) ?_)
        exact (natDegree_C_mul_le _ _).trans (le_of_eq hde.symm)
      rcases lt_or_eq_of_le hle with h' | h'
      · exact h'
      · exfalso
        have : r.coeff d = 0 := by
          rw [hr, Polynomial.coeff_sub, Polynomial.coeff_C_mul]
          have h5 : a.coeff d = a.leadingCoeff := by rw [← hd]; rfl
          have h6 : b.coeff d = b.leadingCoeff := by rw [hde]; rfl
          rw [h5, h6, hc]; field_simp; ring
        have h7 : r.leadingCoeff = 0 := by
          rw [Polynomial.leadingCoeff, h']; exact this
        exact hr0 (leadingCoeff_eq_zero.mp h7)
    obtain ⟨c', hc'⟩ := ih r.natDegree hrd r hrder rfl
    exact ⟨c + c', by
      have : a = r + Polynomial.C c * b := by rw [hr]; ring
      rw [this, hc', Polynomial.C_add]; ring⟩

end RatFun


section Letters

open SkewCoframeRigidity.Coframe SkewCoframeRigidity.FixedCap

theorem letterField_eq_lowerField (L : ℕ) : letterField L = (lowerField L).toSubfield := by
  apply le_antisymm
  · exact Subfield.closure_le.mpr (by
      rintro _ ⟨k, hk, rfl⟩
      exact letter_mem_lowerField hk)
  · intro z hz
    let F : IntermediateField ℚ CohField :=
      (letterField L).toIntermediateField (fun q => by
        rw [eq_ratCast]; exact SubfieldClass.ratCast_mem _ _)
    have : lowerField L ≤ F := by
      refine IntermediateField.adjoin_le_iff.mpr ?_
      rintro _ ⟨k, hk, rfl⟩
      exact cohLetters_mem_letterField hk
    exact this hz

theorem transcendental_letter (L : ℕ) : Transcendental (lowerField L) (cohLetters L) := by
  have hs : L ∉ Set.Iio L := by simp
  have ht := cohLetters_algebraicIndependent.transcendental_adjoin (R := ℚ) hs
  exact (IntermediateField.transcendental_adjoin_iff).2 ht

theorem dRaw_eq_zero_of_mem_letterField (L : ℕ) {z : CohField} (hz : z ∈ letterField L) :
    dRaw L z = 0 := by
  induction hz using Subfield.closure_induction with
  | mem x hx =>
    obtain ⟨k, hk, rfl⟩ := hx
    rw [dRaw_letter, if_neg (by simpa using hk.ne)]
  | one => exact dRaw_one L
  | add x y _ _ hx hy => rw [dRaw_add, hx, hy, add_zero]
  | neg x _ hx => rw [dRaw_neg, hx, neg_zero]
  | mul x y _ _ hx hy => rw [dRaw_mul, hx, hy]; ring
  | inv x _ hx =>
    by_cases h0 : x = 0
    · rw [h0, inv_zero, dRaw_zero]
    · rw [dRaw_inv L x h0, hx]; ring

theorem dRaw_aeval (L : ℕ) (a : (lowerField L)[X]) :
    dRaw L (Polynomial.aeval (cohLetters L) a) =
      Polynomial.aeval (cohLetters L) (derivative a) := by
  induction a using Polynomial.induction_on' with
  | add p q hp hq => rw [map_add, dRaw_add, hp, hq, derivative_add, map_add]
  | monomial n c =>
    have hc : dRaw L (algebraMap (lowerField L) CohField c) = 0 := by
      apply dRaw_eq_zero_of_mem_letterField
      rw [letterField_eq_lowerField]; exact c.2
    simp only [Polynomial.aeval_monomial, derivative_monomial, map_mul, map_natCast]
    rw [dRaw_mul, hc, dRaw_pow, dRaw_letter, if_pos rfl]
    simp only [zero_mul, zero_add, mul_one]
    rcases n with _ | n
    · simp
    · simp only [Nat.add_sub_cancel]
      push_cast
      ring


theorem letterField_succ_le (L : ℕ) :
    letterField (L + 1) ≤ (IntermediateField.adjoin (lowerField L) {cohLetters L}).toSubfield := by
  refine Subfield.closure_le.mpr ?_
  rintro _ ⟨k, hk, rfl⟩
  have hk' : k < L + 1 := hk
  rcases lt_or_eq_of_le (Nat.lt_succ_iff.mp hk') with h | h
  · exact IntermediateField.algebraMap_mem _ (⟨cohLetters k, letter_mem_lowerField h⟩ :
      lowerField L)
  · subst h
    exact IntermediateField.mem_adjoin_simple_self _ _

/-- **Field descent in one letter.**  An element of `ℚ(h_0, …, h_L)` with `∂f/∂h_L = 0` lies in
`ℚ(h_0, …, h_{L-1})`. -/
theorem mem_letterField_of_dRaw_eq_zero (L : ℕ) {f : CohField} (hf : f ∈ letterField (L + 1))
    (hd : dRaw L f = 0) : f ∈ letterField L := by
  have hmem := letterField_succ_le L hf
  obtain ⟨r, s, hrs⟩ := (IntermediateField.mem_adjoin_simple_iff _ _).mp hmem
  set x := cohLetters L with hx
  have hinj : Function.Injective (Polynomial.aeval x : (lowerField L)[X] →ₐ[lowerField L] CohField) :=
    transcendental_iff_injective.mp (transcendental_letter L)
  by_cases hB : Polynomial.aeval x s = 0
  · have : f = 0 := by rw [hrs, hB, div_zero]
    rw [this]; exact Subfield.zero_mem _
  · have hs0 : s ≠ 0 := fun h => hB (by rw [h, map_zero])
    have hfB : f * Polynomial.aeval x s = Polynomial.aeval x r := by
      rw [hrs]; field_simp
    have h1 := congrArg (dRaw L) hfB
    rw [dRaw_mul, hd, zero_mul, zero_add, dRaw_aeval, dRaw_aeval] at h1
    -- `f B' = A'`, hence `A B' = A' B`
    have h2 : Polynomial.aeval x r * Polynomial.aeval x (derivative s) =
        Polynomial.aeval x (derivative r) * Polynomial.aeval x s := by
      rw [← hfB, ← h1]; ring
    have h3 : r * derivative s = derivative r * s := by
      apply hinj
      simp only [map_mul]
      exact h2
    obtain ⟨c, hc⟩ := eq_const_mul_of_derivative r s hs0 h3.symm
    have : f = (c : CohField) := by
      have : Polynomial.aeval x r = (c : CohField) * Polynomial.aeval x s := by
        rw [hc]; simp
      rw [hrs, this]; field_simp
    rw [this, letterField_eq_lowerField]
    exact c.2

end Letters

end SkewCoframeRigidity.UnitRestoration
