import SkewCoframeRigidity.Coframe.Algebra
import Mathlib.FieldTheory.IntermediateField.Adjoin.Basic

/-!
# The coframe lives over the letters of lower index

Formalizes the independence of `g`, `P = [Hg]_{<L}` and the lower remainders from the top
letter in `shields-2026-skew-coframe-rigidity.tex`, `sc:component-remainder`.  Let `F` be a
subfield of the raw field containing the letters `H_k` with `k < span D`.  Then every native
coefficient of the complete coframe of `D`, the coframe polynomial, its power series inverse and
the numerator `[HG]_{<M}` have coefficients in `F`.  Sorry-free.
-/

namespace SkewCoframeRigidity.Coframe

open SkewCofactorIndependence Polynomial
open scoped Polynomial Matrix

/-- The subfield generated by the letters of index below `L`. -/
noncomputable def lowerField (L : ℕ) : IntermediateField ℚ CohField :=
  IntermediateField.adjoin ℚ (cohLetters '' Set.Iio L)

theorem letter_mem_lowerField {L k : ℕ} (hk : k < L) : cohLetters k ∈ lowerField L :=
  IntermediateField.subset_adjoin ℚ _ ⟨k, hk, rfl⟩

theorem lowerField_mono {L L' : ℕ} (h : L ≤ L') : lowerField L ≤ lowerField L' :=
  IntermediateField.adjoin.mono ℚ _ _ (Set.image_mono (Set.Iio_subset_Iio h))

section Matrix

variable {K : Type*} [Field K] (F : Subfield K) {m : ℕ}

/-- The entries of the inverse of a matrix with entries in a subfield lie in the subfield. -/
theorem inv_entry_mem (M : Matrix (Fin m) (Fin m) K) (hM : ∀ i j, M i j ∈ F) (i j : Fin m) :
    M⁻¹ i j ∈ F := by
  let MF : Matrix (Fin m) (Fin m) F := Matrix.of fun i j => ⟨M i j, hM i j⟩
  have hMF : F.subtype.mapMatrix MF = M := by
    ext i j; rfl
  have hdet : M.det = F.subtype (MF.det) := by
    rw [← hMF, RingHom.map_det]
  have hadj : M.adjugate = F.subtype.mapMatrix MF.adjugate := by
    rw [RingHom.map_adjugate, hMF]
  rw [Matrix.inv_def, Matrix.smul_apply, hadj, Ring.inverse_eq_inv', hdet, smul_eq_mul]
  refine F.mul_mem ?_ ?_
  · exact F.inv_mem (MF.det).2
  · exact (MF.adjugate i j).2

end Matrix

section Coframe

variable {n : ℕ} (D : BetaDiagram (n + 1)) (F : IntermediateField ℚ CohField)

theorem letterOf_mem (hF : ∀ k < span D, cohLetters k ∈ F) {m : ℤ} (hm : m < span D) :
    letterOf cohLetters m ∈ F := by
  unfold letterOf
  split_ifs with h
  · exact F.zero_mem
  · exact hF _ (by omega)

theorem properMatrix_entry_mem (hF : ∀ k < span D, cohLetters k ∈ F) (i j : Fin n) :
    properMatrixOf cohLetters D i j ∈ F := by
  simp only [properMatrixOf, Matrix.of_apply]
  rw [← rowPos_sub_colPos D]
  have := rowPos_lt_span D i
  have := colPos_pos D j
  exact letterOf_mem D F hF (by omega)

theorem topVec_mem (hF : ∀ k < span D, cohLetters k ∈ F) (i : Fin n) :
    topVecOf cohLetters D i ∈ F := by
  simp only [topVecOf]
  rw [← rowPos_cast D i]
  have := rowPos_lt_span D i
  exact letterOf_mem D F hF (by omega)

/-- The native coefficients of the complete coframe lie in any subfield containing the lower
letters. -/
theorem coframeVec_mem (hF : ∀ k < span D, cohLetters k ∈ F) (j : Fin n) :
    coframeVec D j ∈ F := by
  unfold coframeVec coframeVecOf
  simp only [Pi.neg_apply, Matrix.mulVec, dotProduct]
  refine F.neg_mem (F.sum_mem fun k _ => F.mul_mem ?_ (topVec_mem D F hF k))
  exact inv_entry_mem F.toSubfield _ (properMatrix_entry_mem D F hF) j k

theorem coframe_coeff_mem (hF : ∀ k < span D, cohLetters k ∈ F) (s : ℕ) :
    (coframe D).coeff s ∈ F := by
  unfold coframe coframeOf
  rw [Polynomial.coeff_add, Polynomial.finsetSum_coeff]
  refine F.add_mem ?_ (F.sum_mem fun j _ => ?_)
  · rw [Polynomial.coeff_one]; split_ifs
    exacts [F.one_mem, F.zero_mem]
  · rw [Polynomial.coeff_C_mul, Polynomial.coeff_X_pow]
    split_ifs
    · rw [mul_one]; exact coframeVec_mem D F hF j
    · rw [mul_zero]; exact F.zero_mem

theorem numerator_coeff_mem (hF : ∀ k < span D, cohLetters k ∈ F) (i : ℕ) :
    (numerator D).coeff i ∈ F := by
  unfold numerator numeratorOf
  rw [PowerSeries.coeff_trunc]
  split_ifs with hi
  · rw [PowerSeries.coeff_mul]
    refine F.sum_mem fun x hx => F.mul_mem ?_ ?_
    · rw [Finset.HasAntidiagonal.mem_antidiagonal] at hx
      simp only [seriesOf, PowerSeries.coeff_mk]
      exact hF _ (by omega)
    · rw [Polynomial.coeff_coe]
      exact coframe_coeff_mem D F hF _
  · exact F.zero_mem

end Coframe

end SkewCoframeRigidity.Coframe
