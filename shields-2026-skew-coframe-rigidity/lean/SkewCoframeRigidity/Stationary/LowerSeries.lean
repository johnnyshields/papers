import SkewCoframeRigidity.Stationary.ComponentRemainder
import SkewCoframeRigidity.Stationary.Transcendence

/-!
# Coefficients of powers of the letter series against lower series

Formalizes the decomposition used in `shields-2026-skew-coframe-rigidity.tex`, `sc:top-matching`
(the comparison of the coefficient of `H_L`): for a series `Q` whose coefficients lie in the field
`lowerField L` generated by the letters below `L`,
`[H^p Q]_L = p ϑ^{p-1} H_L Q_0 + w` with `w` in `lowerField L`.
-/

namespace SkewCoframeRigidity.Coframe

open SkewCofactorIndependence

theorem trunc_letterSeries_mem (L : ℕ) :
    ((PowerSeries.trunc L letterSeries : Polynomial CohField) : PowerSeries CohField) ∈
      seriesOverRange (lowerField L) := by
  rw [mem_seriesOverRange_iff]
  intro m
  rw [Polynomial.coeff_coe, PowerSeries.coeff_trunc]
  split_ifs with h
  · simp only [letterSeries, seriesOf, PowerSeries.coeff_mk]
    exact letter_mem_lowerField h
  · exact (lowerField L).zero_mem

theorem coeff_pow_mul_decomp (L : ℕ) (hL : 1 ≤ L) (p : ℕ) (Q : PowerSeries CohField)
    (hQ : Q ∈ seriesOverRange (lowerField L)) :
    ∃ w ∈ lowerField L, PowerSeries.coeff L (letterSeries ^ p * Q) =
      w + p * cohLetters 0 ^ (p - 1) * cohLetters L * PowerSeries.constantCoeff Q := by
  have hWe := eq_trunc_add_X_pow_mul L letterSeries
  set A : PowerSeries CohField := (PowerSeries.trunc L letterSeries : PowerSeries CohField)
  set E : PowerSeries CohField := PowerSeries.mk fun i => PowerSeries.coeff (L + i) letterSeries
  have hA0 : PowerSeries.constantCoeff A = cohLetters 0 := by
    rw [← PowerSeries.coeff_zero_eq_constantCoeff_apply, Polynomial.coeff_coe,
      PowerSeries.coeff_trunc, if_pos (by omega)]
    simp [letterSeries, seriesOf]
  have hE0 : PowerSeries.constantCoeff E = cohLetters L := by
    rw [← PowerSeries.coeff_zero_eq_constantCoeff_apply]
    simp [E, letterSeries, seriesOf]
  have key := coeff_add_X_pow_mul_pow L hL A E Q p
  rw [← hWe, hA0, hE0] at key
  refine ⟨PowerSeries.coeff L (A ^ p * Q), ?_, key⟩
  have := (seriesOverRange (lowerField L)).mul_mem
    ((seriesOverRange (lowerField L)).pow_mem (trunc_letterSeries_mem L) p) hQ
  exact (mem_seriesOverRange_iff _).1 this _

end SkewCoframeRigidity.Coframe
