import SkewCoframeRigidity.Coframe.CoequalData
import SkewCoframeRigidity.Stationary.LowerField
import SkewCoframeRigidity.Stationary.ClippedMem
import SkewCoframeRigidity.Stationary.FieldIntersection
import SkewCoframeRigidity.Stationary.PositivePowerFinal

/-!
# The whole moving potential

Formalizes `cor:stationary-field-descent` of `shields-2026-skew-coframe-rigidity.tex`
(«The whole moving potential»), over the base field `K = ℚ`.

The neutral field is a subfield `F` of an extension `E` of the raw field containing `ϑ`, over
which the positive letters `H_i`, `0 < i < M`, are algebraically independent
(`mem_thetaField_of_mem`: `F ∩ ℚ(ϑ, H₁, …, H_{M-1}) = ℚ(ϑ)`).  The whole moving homomorphism is
a ring map `F → E⟦z⟧ / (z^{2M})` that reduces to the identity modulo `z` and sends `ϑ` to the
letter series `H`.  If `c ∈ ℚˣ`, `p ≥ 2` and `ψ₀ ∈ F` satisfy the finite equation
`c 𝒯_{G,C}(z H^p) + z D R(ψ₀) ≡ 0`, then the diagrams coincide (`stationary_field_descent`).
The only input beyond the coframe development is `positive_power`, the one-power stationary
separation of `PositivePower`.
-/

namespace SkewCoframeRigidity.Coframe

open SkewCofactorIndependence Polynomial
open scoped Polynomial Matrix

/-- The field `ℚ(ϑ)` inside the raw field. -/
noncomputable def thetaField : IntermediateField ℚ CohField :=
  IntermediateField.adjoin ℚ {cohLetters 0}

/-- The field `ℚ(ϑ, H₁, …, H_{M-1})` inside the raw field, presented as `ℚ(ϑ)` adjoined with the
positive letters of index below `M`. -/
noncomputable def lowerLetterField (M : ℕ) : IntermediateField ℚ CohField :=
  (IntermediateField.adjoin thetaField
    (Set.range (fun i : Set.Ioo 0 M => cohLetters i))).restrictScalars ℚ

theorem letter_mem_lowerLetterField {M k : ℕ} (hk : k < M) : cohLetters k ∈ lowerLetterField M := by
  rcases Nat.eq_zero_or_pos k with rfl | h0
  · refine IntermediateField.mem_restrictScalars _ |>.mpr ?_
    exact IntermediateField.algebraMap_mem (IntermediateField.adjoin thetaField _)
      (⟨cohLetters 0, IntermediateField.subset_adjoin ℚ _ rfl⟩ : thetaField)
  · refine (IntermediateField.mem_restrictScalars _).mpr
      (IntermediateField.subset_adjoin _ _ ⟨⟨k, h0, hk⟩, rfl⟩)

section Intersection

variable {E : Type*} [Field E] [Algebra CohField E]

/-- Intersection with the field generated by the letters, over a field in which they are
independent: an element of the subfield `F` lying in `ℚ(ϑ, H₁, …, H_{M-1})` lies in `ℚ(ϑ)`. -/
theorem mem_thetaField_of_mem {M : ℕ} (F : Subfield E)
    (hϑ : algebraMap CohField E (cohLetters 0) ∈ F)
    (hind : AlgebraicIndependent F
      (fun i : Set.Ioo 0 M => algebraMap CohField E (cohLetters i)))
    {y : CohField} (hy : y ∈ lowerLetterField M) (hF : algebraMap CohField E y ∈ F) :
    y ∈ thetaField := by
  set φ := algebraMap CohField E with hφ
  have hinj : Function.Injective φ := (algebraMap CohField E).injective
  have hθF : ∀ a ∈ thetaField, φ a ∈ F := by
    have : thetaField.toSubfield ≤ F.comap φ := by
      rw [thetaField, IntermediateField.adjoin_toSubfield, Subfield.closure_le]
      rintro _ (⟨q, rfl⟩ | h)
      · simp only [SetLike.mem_coe, Subfield.mem_comap, eq_ratCast, map_ratCast]
        exact SubfieldClass.ratCast_mem _ _
      · rw [Set.mem_singleton_iff] at h
        subst h
        exact hϑ
    exact fun a ha => this ha
  let g : thetaField →+* F :=
    { toFun := fun a => ⟨φ a, hθF a a.2⟩
      map_one' := by ext; simp
      map_mul' := by intro a b; ext; simp
      map_zero' := by ext; simp
      map_add' := by intro a b; ext; simp }
  have hg : ∀ a, ((g a : F) : E) = φ a := fun a => rfl
  rw [lowerLetterField, IntermediateField.mem_restrictScalars,
    IntermediateField.mem_adjoin_range_iff] at hy
  obtain ⟨r, s, hrs⟩ := hy
  set xC : Set.Ioo 0 M → CohField := fun i => cohLetters i with hxC
  by_cases hs : MvPolynomial.aeval xC s = 0
  · rw [hrs, hs, div_zero]; exact zero_mem _
  have hmap : ∀ t : MvPolynomial (Set.Ioo 0 M) thetaField,
      MvPolynomial.aeval (fun i : Set.Ioo 0 M => φ (cohLetters i)) (MvPolynomial.map g t) =
        φ (MvPolynomial.aeval xC t) := by
    intro t
    have := congrArg (fun f : MvPolynomial (Set.Ioo 0 M) thetaField →+* E => f t)
      (show ((MvPolynomial.aeval (R := F) (fun i : Set.Ioo 0 M => φ (cohLetters i))).toRingHom.comp
          (MvPolynomial.map g)) =
        φ.comp (MvPolynomial.aeval (R := thetaField) xC).toRingHom from by
        apply MvPolynomial.ringHom_ext
        · intro a; simp; rfl
        · intro i; simp [hxC])
    simpa using this
  let k₀ : Subfield F := (⊤ : Subfield thetaField).map g
  have hz := mem_of_mul_aeval_eq hind k₀ (MvPolynomial.map g r) (MvPolynomial.map g s)
    (fun m => by rw [MvPolynomial.coeff_map]; exact Subfield.mem_map.mpr ⟨_, trivial, rfl⟩)
    (fun m => by rw [MvPolynomial.coeff_map]; exact Subfield.mem_map.mpr ⟨_, trivial, rfl⟩)
    (by rw [hmap]; exact fun h => hs (hinj (by simpa using h))) ⟨φ y, hF⟩
    (by
      rw [hmap, hmap]
      change φ y * _ = _
      rw [hrs, map_div₀, div_mul_cancel₀]
      exact fun h => hs (hinj (by simpa using h)))
  obtain ⟨a, ha, hga⟩ := Subfield.mem_map.mp hz
  have : y = a := hinj (by simpa [hg] using (congrArg (fun w : F => (w : E)) hga).symm)
  rw [this]; exact a.2

end Intersection

section Series

theorem map_coe_poly {R S : Type*} [CommRing R] [CommRing S] (f : R →+* S) (p : R[X]) :
    PowerSeries.map f (p : PowerSeries R) = ((p.map f : S[X]) : PowerSeries S) := by
  ext k
  simp [PowerSeries.coeff_map, Polynomial.coeff_coe]

theorem ratHom_eval₂ {S S' : Type*} [CommRing S] [CommRing S'] (f : S →+* S') (g : ℚ →+* S)
    (g' : ℚ →+* S') (s : S) (P : ℚ[X]) : f (P.eval₂ g s) = P.eval₂ g' (f s) := by
  rw [Polynomial.hom_eval₂]
  congr 1
  exact Subsingleton.elim _ _

theorem coeff_X_mul_poly_mul {E : Type*} [Field E] (D : E[X]) (ℓ : ℕ)
    (hD : ∀ k < ℓ, D.coeff k = 0) (f : PowerSeries E) :
    PowerSeries.coeff (ℓ + 1) (PowerSeries.X * (D : PowerSeries E) * f) =
      D.coeff ℓ * PowerSeries.coeff 0 f := by
  rw [mul_assoc, PowerSeries.coeff_succ_X_mul, PowerSeries.coeff_mul,
    Finset.sum_eq_single (ℓ, 0)]
  · simp [Polynomial.coeff_coe]
  · rintro ⟨i, j⟩ hij hne
    rw [Finset.HasAntidiagonal.mem_antidiagonal] at hij
    by_cases hi : i < ℓ
    · simp [Polynomial.coeff_coe, hD i hi]
    · exfalso; apply hne
      simp only [Prod.mk.injEq]
      constructor <;> omega
  · intro h; simp at h

end Series

/-- The truncated series ring `E⟦z⟧ / (z^N)`. -/
abbrev TruncSeries (E : Type*) [Field E] (N : ℕ) : Type _ :=
  PowerSeries E ⧸ Ideal.span {(PowerSeries.X : PowerSeries E) ^ N}

/-- Reduction modulo `z^N`. -/
noncomputable def truncMk (E : Type*) [Field E] (N : ℕ) : PowerSeries E →+* TruncSeries E N :=
  Ideal.Quotient.mk _

theorem truncMk_eq_zero_iff {E : Type*} [Field E] {N : ℕ} {f : PowerSeries E} :
    truncMk E N f = 0 ↔ ∀ k < N, PowerSeries.coeff k f = 0 := by
  rw [truncMk, Ideal.Quotient.eq_zero_iff_mem, Ideal.mem_span_singleton, PowerSeries.X_pow_dvd_iff]

section Main

variable {E : Type*} [Field E] [Algebra CohField E]

local notation "φ" => algebraMap CohField E

theorem stationary_field_descent {n : ℕ} {A B : BetaDiagram (n + 1)} (hA : A.Connected)
    (hAn : A.col (Fin.last n) = 0) (hBn : B.col (Fin.last n) = 0) (h : A.schur = B.schur)
    (F : Subfield E) (hϑ : algebraMap CohField E (cohLetters 0) ∈ F)
    (hind : AlgebraicIndependent F
      (fun i : Set.Ioo 0 (span A) => algebraMap CohField E (cohLetters i)))
    (R : F →+* TruncSeries E (2 * span A))
    (hRc : ∀ (a : F) (f : PowerSeries E), R a = truncMk E _ f →
      PowerSeries.constantCoeff f = (a : E))
    (hRϑ : R ⟨algebraMap CohField E (cohLetters 0), hϑ⟩ =
      truncMk E _ (PowerSeries.map (algebraMap CohField E) letterSeries))
    {c : ℚ} (hc : c ≠ 0) {p : ℕ} (hp : 2 ≤ p) (ψ₀ : F)
    (heq : truncMk E _ (PowerSeries.C (c : E) *
        (((clippedOp (span A) (coframe A) (coframe B) (PowerSeries.X * letterSeries ^ p)).map
          (algebraMap CohField E) : E[X]) : PowerSeries E)) +
      truncMk E _ (PowerSeries.X * (((defect A B).map (algebraMap CohField E) : E[X]) :
        PowerSeries E)) * R ψ₀ = 0) :
    A = B := by
  by_contra hne
  have hinj : Function.Injective φ := (algebraMap CohField E).injective
  have hB : B.Connected := A.connected_of_schur_eq B hA h
  obtain ⟨-, -, hs, -, hord, hdeg⟩ := coequal_data hA h
  obtain ⟨hM3, -, -, -, -, -, hD0⟩ := coequal_distinct hA hAn hBn h hne
  set T := clippedOp (span A) (coframe A) (coframe B) (PowerSeries.X * letterSeries ^ p) with hT
  set D := defect A B with hD
  have : CharZero E := charZero_of_injective_algebraMap hinj
  -- the first coefficient of the defect
  set ℓ := D.natTrailingDegree with hℓ
  have hDℓ : D.coeff ℓ ≠ 0 := Polynomial.trailingCoeff_nonzero_iff_nonzero.mpr hD0
  have hDlow : ∀ k < ℓ, D.coeff k = 0 := fun k hk =>
    Polynomial.coeff_eq_zero_of_lt_natTrailingDegree hk
  have hℓle : ℓ ≤ 2 * span A - 2 := (Polynomial.natTrailingDegree_le_natDegree D).trans hdeg
  obtain ⟨f, hf⟩ := Ideal.Quotient.mk_surjective (R ψ₀)
  have hf' : truncMk E (2 * span A) f = R ψ₀ := hf
  have hf0 : PowerSeries.coeff 0 f = (ψ₀ : E) := by
    rw [PowerSeries.coeff_zero_eq_constantCoeff_apply]; exact hRc ψ₀ f hf'.symm
  have heq0 := heq
  rw [← hf', ← map_mul, ← map_add, truncMk_eq_zero_iff] at heq
  have hco := heq (ℓ + 1) (by omega)
  have hD' : ∀ k < ℓ, (D.map φ).coeff k = 0 := fun k hk => by
    rw [Polynomial.coeff_map, hDlow k hk, map_zero]
  rw [map_add, PowerSeries.coeff_C_mul, coeff_X_mul_poly_mul _ ℓ hD', Polynomial.coeff_coe,
    Polynomial.coeff_map, Polynomial.coeff_map, hf0] at hco
  have hc' : (c : E) ≠ 0 := Rat.cast_ne_zero.mpr hc
  have hφD : φ (D.coeff ℓ) ≠ 0 := (map_ne_zero_iff _ hinj).mpr hDℓ
  -- the quotient of retained coefficients lies in the field of the letters
  have hSmem : ∀ k < span A, cohLetters k ∈ (lowerLetterField (span A)).toSubfield :=
    fun k hk => letter_mem_lowerLetterField hk
  have hGA : ∀ k, (coframe A).coeff k ∈ (lowerLetterField (span A)).toSubfield :=
    coframe_coeff_mem A (lowerLetterField (span A)) hSmem
  have hGB : ∀ k, (coframe B).coeff k ∈ (lowerLetterField (span A)).toSubfield :=
    coframe_coeff_mem B (lowerLetterField (span A)) fun k hk => hSmem k (by omega)
  have hu : ∀ k < span A, (letterSeries.coeff k) ∈ (lowerLetterField (span A)).toSubfield := by
    intro k hk
    simpa [letterSeries, seriesOf, PowerSeries.coeff_mk] using hSmem k hk
  have hTmem : ∀ k, T.coeff k ∈ (lowerLetterField (span A)).toSubfield :=
    clippedOp_coeff_mem' _ _ _ _ _ hGA hGB (lowMem_X_mul _ _ (lowMem_pow _ _ hu p))
  have hDmem : ∀ k, D.coeff k ∈ (lowerLetterField (span A)).toSubfield :=
    clippedOp_coeff_mem' _ _ _ _ _ hGA hGB hu
  set y : CohField := -(T.coeff (ℓ + 1)) / D.coeff ℓ with hy
  have hyS : y ∈ lowerLetterField (span A) :=
    (lowerLetterField (span A)).toSubfield.div_mem
      ((lowerLetterField (span A)).toSubfield.neg_mem (hTmem _)) (hDmem _)
  have hφy : φ y * (c : E) = (ψ₀ : E) := by
    rw [hy, map_div₀, map_neg]
    field_simp
    linear_combination (-1 : E) * hco
  have hφyF : φ y ∈ F := by
    have : φ y = (ψ₀ : E) * ((c : E))⁻¹ := by
      rw [← hφy]; field_simp
    rw [this]
    exact F.mul_mem ψ₀.2 (F.inv_mem (SubfieldClass.ratCast_mem _ _))
  have hyθ : y ∈ thetaField := mem_thetaField_of_mem F hϑ hind hyS hφyF
  -- `y = P(ϑ) / Q(ϑ)` with rational coefficients
  obtain ⟨P, Q, hQ0, hyPQ⟩ : ∃ P Q : ℚ[X], Polynomial.aeval (cohLetters 0) Q ≠ 0 ∧
      y * Polynomial.aeval (cohLetters 0) Q = Polynomial.aeval (cohLetters 0) P := by
    obtain ⟨P, Q, hPQ⟩ := (IntermediateField.mem_adjoin_simple_iff ℚ y).1 hyθ
    by_cases hQ : Polynomial.aeval (cohLetters 0) Q = 0
    · refine ⟨0, 1, by simp, ?_⟩
      rw [hPQ, hQ, div_zero]; simp
    · exact ⟨P, Q, hQ, by rw [hPQ, div_mul_cancel₀ _ hQ]⟩
  have hQne : Q ≠ 0 := fun h0 => hQ0 (by simp [h0])
  -- the relation in `E`
  have hEid : (ψ₀ : E) * φ (Polynomial.aeval (cohLetters 0) Q) =
      (c : E) * φ (Polynomial.aeval (cohLetters 0) P) := by
    have := congrArg φ hyPQ
    rw [map_mul] at this
    rw [← hφy]
    linear_combination (c : E) * this
  let ϑF : F := ⟨φ (cohLetters 0), hϑ⟩
  have hevalF : ∀ X : ℚ[X], (((X.eval₂ (algebraMap ℚ F) ϑF : F)) : E) =
      φ (Polynomial.aeval (cohLetters 0) X) := by
    intro X
    have h1 := ratHom_eval₂ F.subtype (algebraMap ℚ F) (algebraMap ℚ E) ϑF X
    have h2 := ratHom_eval₂ φ (algebraMap ℚ CohField) (algebraMap ℚ E) (cohLetters 0) X
    rw [Polynomial.aeval_def, h2]
    exact h1
  have hFid : ψ₀ * Q.eval₂ (algebraMap ℚ F) ϑF =
      algebraMap ℚ F c * P.eval₂ (algebraMap ℚ F) ϑF := by
    apply Subtype.ext
    push_cast
    rw [hevalF, hevalF]
    simpa using hEid
  -- apply the moving homomorphism
  let gS : ℚ →+* TruncSeries E (2 * span A) :=
    (truncMk E (2 * span A)).comp (algebraMap ℚ (PowerSeries E))
  have hRev : ∀ X : ℚ[X], R (X.eval₂ (algebraMap ℚ F) ϑF) =
      truncMk E (2 * span A) (Polynomial.aeval (PowerSeries.map φ letterSeries) X) := by
    intro X
    rw [ratHom_eval₂ R (algebraMap ℚ F) gS ϑF X, hRϑ, Polynomial.aeval_def,
      ratHom_eval₂ (truncMk E (2 * span A)) (algebraMap ℚ (PowerSeries E)) gS]
  have hRc' : R (algebraMap ℚ F c) = truncMk E (2 * span A) (PowerSeries.C (c : E)) := by
    have := RingHom.congr_fun (Subsingleton.elim (R.comp (algebraMap ℚ F)) gS) c
    simp only [RingHom.comp_apply] at this
    rw [this]
    simp [gS, PowerSeries.algebraMap_apply]
  have h1 := congrArg R hFid
  rw [map_mul, map_mul, hRev, hRev, hRc'] at h1
  -- the inverse of the denominator
  have hmapev : ∀ X : ℚ[X], PowerSeries.map φ (Polynomial.aeval letterSeries X) =
      Polynomial.aeval (PowerSeries.map φ letterSeries) X := by
    intro X
    rw [Polynomial.aeval_def, Polynomial.aeval_def]
    exact ratHom_eval₂ (PowerSeries.map φ) (algebraMap ℚ _) (algebraMap ℚ _) _ X
  have hq0 : PowerSeries.constantCoeff (Polynomial.aeval letterSeries Q) ≠ 0 := by
    have : PowerSeries.constantCoeff (Polynomial.aeval letterSeries Q) =
        Polynomial.aeval (cohLetters 0) Q := by
      rw [Polynomial.aeval_def, Polynomial.aeval_def,
        ratHom_eval₂ PowerSeries.constantCoeff (algebraMap ℚ _) (algebraMap ℚ CohField)]
      simp [letterSeries, seriesOf]
    rw [this]; exact hQ0
  have hqW := PowerSeries.inv_mul_cancel _ hq0
  have hone : truncMk E (2 * span A) (PowerSeries.map φ (Polynomial.aeval letterSeries Q) *
      PowerSeries.map φ (Polynomial.aeval letterSeries Q)⁻¹) = 1 := by
    rw [← map_mul, mul_comm (Polynomial.aeval letterSeries Q) _, hqW, map_one, map_one]
  have hRψ : R ψ₀ = truncMk E (2 * span A) (PowerSeries.C (c : E) *
      PowerSeries.map φ (ratSeries P Q letterSeries)) := by
    rw [← hmapev, ← hmapev] at h1
    calc R ψ₀ = R ψ₀ * truncMk E (2 * span A) (PowerSeries.map φ (Polynomial.aeval letterSeries Q) *
          PowerSeries.map φ (Polynomial.aeval letterSeries Q)⁻¹) := by rw [hone, mul_one]
      _ = (R ψ₀ * truncMk E (2 * span A) (PowerSeries.map φ (Polynomial.aeval letterSeries Q))) *
          truncMk E (2 * span A) (PowerSeries.map φ (Polynomial.aeval letterSeries Q)⁻¹) := by
          rw [map_mul, mul_assoc]
      _ = _ := by
          rw [h1]
          simp only [ratSeries, map_mul]
          ring
  -- the finite equation over the raw field
  have hmain : truncMk E (2 * span A) (PowerSeries.C (c : E) *
      (PowerSeries.map φ T : PowerSeries E) +
      PowerSeries.X * ((D.map φ : E[X]) : PowerSeries E) *
        (PowerSeries.C (c : E) * PowerSeries.map φ (ratSeries P Q letterSeries))) = 0 := by
    rw [map_add, map_mul, map_mul, ← hRψ, map_mul]
    rw [map_mul] at heq0
    rw [map_coe_poly]
    exact heq0
  have hbad : A = B := by
    refine positive_power hA hAn hBn h hp P Q hQne fun k hk => ?_
    apply hinj
    have hk' := (truncMk_eq_zero_iff.mp hmain) k hk
    have hc'' : (c : E) ≠ 0 := hc'
    have e : PowerSeries.C (c : E) * (PowerSeries.map φ T : PowerSeries E) +
        PowerSeries.X * ((D.map φ : E[X]) : PowerSeries E) *
          (PowerSeries.C (c : E) * PowerSeries.map φ (ratSeries P Q letterSeries)) =
        PowerSeries.C (c : E) * PowerSeries.map φ ((T : PowerSeries CohField) +
          PowerSeries.X * (D : PowerSeries CohField) * ratSeries P Q letterSeries) := by
      simp only [map_add, map_mul, PowerSeries.map_X, map_coe_poly]
      ring
    rw [e, PowerSeries.coeff_C_mul] at hk'
    rw [PowerSeries.coeff_map] at hk'
    simpa [hc''] using hk'
  exact hne hbad

end Main

end SkewCoframeRigidity.Coframe
