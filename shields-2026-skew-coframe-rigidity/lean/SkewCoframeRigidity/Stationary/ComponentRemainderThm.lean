import SkewCoframeRigidity.Stationary.ComponentNonzero

/-!
# `sc:component-remainder`

Formalizes `shields-2026-skew-coframe-rigidity.tex`, `sc:component-remainder`.  For a connected
diagram of span `L ≥ 2`, with right coframe `g`, top quotient `k = [Hg]_L` and any integer
`p ≥ 2`,
\[
  [H^p g]_L = p ϑ^{p-1} k + α,\qquad k = H_L + k_0,
\]
where `k₀` and `α` lie in the field generated by the letters of index below `L` (they are
independent of the top letter `H_L`) and `α ≠ 0`.  The nonvanishing rests on the algebraic
independence of the atlas coordinates (`atlasCoords_algebraicIndependent`).  Sorry-free apart
from the atlas inputs.
-/

namespace SkewCoframeRigidity.Coframe

open SkewCofactorIndependence

variable {n : ℕ}

/-- `sc:component-remainder`. -/
theorem component_remainder {D : BetaDiagram (n + 1)} (hD : D.Connected) (hL : 2 ≤ span D)
    {p : ℕ} (hp : 2 ≤ p) :
    ∃ k₀ α : CohField, k₀ ∈ lowerField (span D) ∧ α ∈ lowerField (span D) ∧ α ≠ 0 ∧
      topQuotient D = cohLetters (span D) + k₀ ∧
      PowerSeries.coeff (span D) (letterSeries ^ p * (coframe D : PowerSeries CohField)) =
        p * cohLetters 0 ^ (p - 1) * topQuotient D + α := by
  refine ⟨topQuotient D - cohLetters (span D), _, topQuotient_sub_mem D, remainder_mem D p,
    ?_, by ring, ?_⟩
  · rcases n with _ | m
    · exact remainder_ne_zero_row hD rfl hL hp
    · exact remainder_ne_zero_cols hD hp
  · rw [coeff_pow_letterSeries_mul_coframe D p (by omega), add_comm]

end SkewCoframeRigidity.Coframe
