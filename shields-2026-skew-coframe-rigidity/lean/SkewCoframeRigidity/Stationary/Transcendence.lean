import SkewCoframeRigidity.Stationary.LowerField
import Mathlib.RingTheory.AlgebraicIndependent.AlgebraicClosure
import Mathlib.RingTheory.AlgebraicIndependent.Transcendental

/-!
# The letter `H_L` is transcendental over the lower letters

The raw letters are algebraically independent over `ℚ`.  In particular `H_L` does not lie in the
field `lowerField L` generated by the letters of index below `L`, which is what the phrase
"independent of `H_L`" means in `shields-2026-skew-coframe-rigidity.tex`.
-/

namespace SkewCoframeRigidity.Coframe

open SkewCofactorIndependence

theorem cohLetters_algebraicIndependent : AlgebraicIndependent ℚ cohLetters := by
  have h := MvPolynomial.algebraicIndependent_X ℕ ℚ
  have := h.map' (f := (IsScalarTower.toAlgHom ℚ CohRing CohField))
    (IsFractionRing.injective CohRing CohField)
  exact this

theorem letter_notMem_lowerField (L : ℕ) : cohLetters L ∉ lowerField L := by
  intro hmem
  have hs : L ∉ Set.Iio L := by simp
  have ht := cohLetters_algebraicIndependent.transcendental_adjoin (R := ℚ) hs
  have ht' : Transcendental (lowerField L) (cohLetters L) :=
    (IntermediateField.transcendental_adjoin_iff).2 ht
  exact ht' (isAlgebraic_algebraMap (⟨_, hmem⟩ : lowerField L))

/-- A relation `u x + w = 0` with `u, w` in a subfield not containing `x` forces `u = w = 0`. -/
theorem eq_zero_of_mul_add_eq_zero {K : Type*} [Field K] {F : Subfield K} {x u w : K}
    (hx : x ∉ F) (hu : u ∈ F) (hw : w ∈ F) (h : u * x + w = 0) : u = 0 ∧ w = 0 := by
  by_cases hu0 : u = 0
  · subst hu0; simp at h; exact ⟨rfl, h⟩
  · exfalso
    apply hx
    have : x = -w / u := by field_simp; linear_combination h
    rw [this]
    exact F.div_mem (F.neg_mem hw) hu

end SkewCoframeRigidity.Coframe
