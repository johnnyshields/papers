import SkewCoframeRigidity.Coframe.Defs
import Mathlib.Algebra.MvPolynomial.PDeriv

/-!
# Letters above a ceiling are independent over the letters below it

Formalizes the independence step in the proof of `sc:fixed-cap` in
`shields-2026-skew-coframe-rigidity.tex` («Rigidity with the same literal cap»): if every
coefficient of a polynomial lies in the subfield `letterField m` generated by the letters
`h_0, …, h_{m-1}`, then the letters `h_j` with `j ≥ m` are linearly independent over it.  Sorry-free.
-/

namespace SkewCoframeRigidity.FixedCap

open SkewCoframeRigidity.Coframe MvPolynomial

/-- The subfield of the raw field generated by the letters `h_j`, `j < m`. -/
noncomputable def letterField (m : ℕ) : Subfield CohField :=
  Subfield.closure (cohLetters '' Set.Iio m)

theorem cohLetters_mem_letterField {m j : ℕ} (hj : j < m) : cohLetters j ∈ letterField m :=
  Subfield.subset_closure ⟨j, hj, rfl⟩

private noncomputable abbrev emb : CohRing →+* CohField := algebraMap CohRing CohField

private theorem emb_injective : Function.Injective emb := IsFractionRing.injective CohRing CohField

/-- Every element of `letterField m` is a quotient of polynomials in the letters below `m`. -/
theorem exists_frac_of_mem_letterField {m : ℕ} {x : CohField} (hx : x ∈ letterField m) :
    ∃ p q : CohRing, p.vars ⊆ Finset.range m ∧ q.vars ⊆ Finset.range m ∧ q ≠ 0 ∧
      x = emb p / emb q := by
  induction hx using Subfield.closure_induction with
  | mem x hx =>
    obtain ⟨j, hj, rfl⟩ := hx
    refine ⟨X j, 1, ?_, by simp, one_ne_zero, ?_⟩
    · intro i hi
      simp [vars_X] at hi
      simpa [hi] using hj
    · simp [cohLetters]
  | one => exact ⟨1, 1, by simp, by simp, one_ne_zero, by simp⟩
  | add x y _ _ hx hy =>
    obtain ⟨p, q, hp, hq, hq0, rfl⟩ := hx
    obtain ⟨p', q', hp', hq', hq0', rfl⟩ := hy
    refine ⟨p * q' + p' * q, q * q', ?_, ?_, mul_ne_zero hq0 hq0', ?_⟩
    · refine (vars_add_subset _ _).trans (Finset.union_subset ?_ ?_)
      · exact (vars_mul _ _).trans (Finset.union_subset hp hq')
      · exact (vars_mul _ _).trans (Finset.union_subset hp' hq)
    · exact (vars_mul _ _).trans (Finset.union_subset hq hq')
    · have h1 : emb q ≠ 0 := (map_ne_zero_iff _ emb_injective).2 hq0
      have h2 : emb q' ≠ 0 := (map_ne_zero_iff _ emb_injective).2 hq0'
      simp only [map_add, map_mul]
      field_simp
  | neg x _ hx =>
    obtain ⟨p, q, hp, hq, hq0, rfl⟩ := hx
    exact ⟨-p, q, by simpa using hp, hq, hq0, by simp [neg_div]⟩
  | mul x y _ _ hx hy =>
    obtain ⟨p, q, hp, hq, hq0, rfl⟩ := hx
    obtain ⟨p', q', hp', hq', hq0', rfl⟩ := hy
    refine ⟨p * p', q * q', ?_, ?_, mul_ne_zero hq0 hq0', ?_⟩
    · exact (vars_mul _ _).trans (Finset.union_subset hp hp')
    · exact (vars_mul _ _).trans (Finset.union_subset hq hq')
    · simp [map_mul, div_mul_div_comm]
  | inv x _ hx =>
    obtain ⟨p, q, hp, hq, hq0, rfl⟩ := hx
    by_cases hp0 : p = 0
    · exact ⟨0, 1, by simp, by simp, one_ne_zero, by simp [hp0]⟩
    · exact ⟨q, p, hq, hp, hp0, by simp [inv_div]⟩

/-- **Independence of the letters above a ceiling.**  If `y₀, y_j ∈ letterField m`, then a
relation `y₀ + ∑_{m ≤ j ≤ N} h_j y_j = 0` forces every `y_j` (and `y₀`) to vanish. -/
theorem tail_letters_independent (m N : ℕ) (y : ℕ → CohField) (y0 : CohField)
    (hy : ∀ j, y j ∈ letterField m) (hy0 : y0 ∈ letterField m)
    (h : y0 + ∑ j ∈ Finset.Icc m N, cohLetters j * y j = 0) :
    y0 = 0 ∧ ∀ j ∈ Finset.Icc m N, y j = 0 := by
  classical
  choose p q hp hq hq0 hyq using fun j => exists_frac_of_mem_letterField (hy j)
  obtain ⟨p0, q0, hp0, hq00, hq0ne, hy0q⟩ := exists_frac_of_mem_letterField hy0
  set J := Finset.Icc m N with hJ
  set D : CohRing := q0 * ∏ k ∈ J, q k with hD
  have hDne : D ≠ 0 := mul_ne_zero hq0ne (Finset.prod_ne_zero_iff.2 fun k _ => hq0 k)
  have hDe : emb D ≠ 0 := (map_ne_zero_iff _ emb_injective).2 hDne
  let P : ℕ → CohRing := fun j => p j * (q0 * ∏ k ∈ J.erase j, q k)
  let P0 : CohRing := p0 * ∏ k ∈ J, q k
  have hPy : ∀ j ∈ J, emb (P j) = emb D * y j := by
    intro j hj
    have hqj : emb (q j) ≠ 0 := (map_ne_zero_iff _ emb_injective).2 (hq0 j)
    have hprod : ∏ k ∈ J, q k = q j * ∏ k ∈ J.erase j, q k := (Finset.mul_prod_erase J q hj).symm
    simp only [P, hD, hprod, map_mul, hyq j]
    field_simp
  have hP0y : emb P0 = emb D * y0 := by
    have hq0e : emb q0 ≠ 0 := (map_ne_zero_iff _ emb_injective).2 hq0ne
    simp only [P0, hD, map_mul, hy0q]
    field_simp
  have hrel : P0 + ∑ j ∈ J, X j * P j = 0 := by
    apply emb_injective
    rw [map_add, map_sum, map_zero, hP0y]
    have : ∀ j ∈ J, emb (X j * P j) = cohLetters j * (emb D * y j) := by
      intro j hj
      rw [map_mul, hPy j hj]
      rfl
    rw [Finset.sum_congr rfl this]
    have e : emb D * y0 + ∑ j ∈ J, cohLetters j * (emb D * y j) =
        emb D * (y0 + ∑ j ∈ J, cohLetters j * y j) := by
      rw [mul_add, Finset.mul_sum]
      congr 1
      exact Finset.sum_congr rfl fun j _ => by ring
    rw [e, h, mul_zero]
  have hvarsP : ∀ j, (P j).vars ⊆ Finset.range m := by
    intro j
    refine (vars_mul _ _).trans (Finset.union_subset (hp j) ?_)
    refine (vars_mul _ _).trans (Finset.union_subset hq00 ?_)
    refine (vars_prod _).trans ?_
    intro i hi
    obtain ⟨k, -, hk⟩ := Finset.mem_biUnion.1 hi
    exact hq k hk
  have hvarsP0 : P0.vars ⊆ Finset.range m := by
    refine (vars_mul _ _).trans (Finset.union_subset hp0 ?_)
    refine (vars_prod _).trans ?_
    intro i hi
    obtain ⟨k, -, hk⟩ := Finset.mem_biUnion.1 hi
    exact hq k hk
  have hzero : ∀ j ∈ J, P j = 0 := by
    intro j₀ hj₀
    have hj₀m : m ≤ j₀ := (Finset.mem_Icc.1 hj₀).1
    have hnot : ∀ k, j₀ ∉ (P k).vars := fun k hk => by
      have := hvarsP k hk
      simp at this
      omega
    have := congrArg (pderiv j₀) hrel
    rw [map_add, map_sum, map_zero, pderiv_eq_zero_of_notMem_vars (fun hk => by
      have := hvarsP0 hk; simp at this; omega), zero_add] at this
    have h2 : ∀ j ∈ J, pderiv j₀ (X j * P j) = if j = j₀ then P j else 0 := by
      intro j hj
      rw [Derivation.leibniz, pderiv_eq_zero_of_notMem_vars (hnot j)]
      simp [pderiv_X, Pi.single_apply, eq_comm]
    rw [Finset.sum_congr rfl h2, Finset.sum_ite_eq' J j₀ (fun j => P j)] at this
    simpa [hj₀] using this
  have hyz : ∀ j ∈ J, y j = 0 := by
    intro j hj
    have := hPy j hj
    rw [hzero j hj, map_zero] at this
    exact (mul_eq_zero.1 this.symm).resolve_left hDe
  refine ⟨?_, hyz⟩
  rw [Finset.sum_eq_zero (fun j hj => by rw [hyz j hj, mul_zero]), add_zero] at h
  exact h
end SkewCoframeRigidity.FixedCap
