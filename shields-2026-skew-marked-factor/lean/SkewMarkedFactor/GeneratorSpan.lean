import SkewMarkedFactor.WeightedOperator
import SkewMarkedFactor.OrdinaryAction

/-!
# Generator span of a Schur function

«The algebra map and the weighted operator» (`sec:weighted-action`) of
`shields-2026-skew-marked-factor.tex`: the Schur function of a skew diagram involves only the
generators `h_j` with `j` at most the span of the diagram, so every weighted derivation `V_r`
with `r` at least the span annihilates it.  In particular `V_{kp}` kills `A`, `B`, `C`.
-/

noncomputable section
namespace SkewMarkedFactor
open Gluing Gluing.Plan MvPolynomial

/-- The subalgebra generated by `h_1, …, h_N`. -/
def smallGens (N : ℕ) : Subalgebra ℚ Lambda := supported ℚ {k : ℕ+ | (k : ℕ) ≤ N}

theorem hh_mem_smallGens {j : ℤ} {N : ℕ} (hj : j ≤ N) : hh j ∈ smallGens N := by
  by_cases hneg : j < 0
  · rw [hh_of_neg hneg]; exact Subalgebra.zero_mem _
  · by_cases h0 : j = 0
    · subst h0; rw [hh_zero]; exact Subalgebra.one_mem _
    · obtain ⟨p, hp⟩ : ∃ p : ℕ+, (p : ℤ) = j := ⟨⟨j.toNat, by omega⟩, by simp; omega⟩
      rw [← hp, hh_pnat]
      exact (X_mem_supported (R := ℚ)).2 (by show (p : ℕ) ≤ N; omega)

theorem smallGens_mono {N N' : ℕ} (h : N ≤ N') : smallGens N ≤ smallGens N' :=
  supported_mono fun k hk => le_trans hk h

/-- A Jacobi–Trudi determinant whose entries have index at most `N` lies in `smallGens N`. -/
theorem det_mem_smallGens {M N : ℕ} (A : Matrix (Fin M) (Fin M) Lambda)
    (h : ∀ i j, A i j ∈ smallGens N) : A.det ∈ smallGens N := by
  rw [Matrix.det_apply]
  refine Subalgebra.sum_mem _ fun σ _ => ?_
  refine Subalgebra.smul_mem _ ?_ _
  exact Subalgebra.prod_mem _ fun i _ => h _ _

theorem profile_schur_mem {n : ℕ} (P : Profile n) : P.schur ∈ smallGens (P.xi 0).toNat := by
  unfold Profile.schur
  refine det_mem_smallGens _ fun i j => hh_mem_smallGens ?_
  have h1 : P.xi i ≤ P.xi 0 := P.xi_strictAnti.antitone (Fin.zero_le i)
  have h2 := P.zeta_nonneg j
  have : (0 : ℤ) < P.xi 0 := P.xi_pos 0
  omega

theorem cellSchur_mem_smallGens {D : Diagram} (hD : IsSkew D) :
    cellSchur D ∈ smallGens (span D) := by
  rw [cellSchur_eq_prod hD]
  refine Subalgebra.prod_mem _ fun C hC => ?_
  have hCc := isConnectedSkew_component hD hC
  have hsub := component_subset hC
  have hspan : span C ≤ span D :=
    Finset.card_le_card (Finset.image_subset_image hsub)
  obtain ⟨v, hv⟩ := hCc.exists_translate_cells
  have hx : (span C : ℤ) = (cellProfile C).2.xi 0 := by
    have e := congrArg span hv
    rw [span_translate] at e
    rw [e]; exact (cellProfile C).2.span_cells
  refine smallGens_mono (N := ((cellProfile C).2.xi 0).toNat) ?_ (profile_schur_mem _)
  omega

/-- Every weighted derivation `V_r` with `r` at least the span kills the Schur function. -/
theorem wDeriv_cellSchur_of_span_le {D : Diagram} (hD : IsSkew D) {r : ℕ} (hr : span D ≤ r) :
    wDeriv r (cellSchur D) = 0 := by
  have key : ∀ f ∈ smallGens r, wDeriv r f = 0 := by
    intro f hf
    rw [smallGens, supported_eq_adjoin_X] at hf
    induction hf using Algebra.adjoin_induction with
    | mem x hx =>
      obtain ⟨k, hk, rfl⟩ := hx
      rw [wDeriv_X]
      have : hh ((k : ℤ) - r) = 0 ∨ ((k : ℕ) : ℚ) - r = 0 := by
        rcases lt_or_eq_of_le (show (k : ℕ) ≤ r from hk) with h | h
        · left; exact hh_of_neg (by omega)
        · right; rw [h]; simp
      rcases this with h | h
      · rw [h, mul_zero]
      · rw [h]; simp
    | algebraMap a =>
      exact Derivation.map_algebraMap _ _
    | add x y _ _ hx hy => rw [map_add, hx, hy, add_zero]
    | mul x y _ _ hx hy => rw [Derivation.leibniz, hx, hy]; simp
  exact key _ (smallGens_mono hr (cellSchur_mem_smallGens hD))

/-- `V_{kp}` annihilates the three normalization functions `A = s_W`, `B = s_{Ŵ}`, `C = s_{Ô}`
of a legal mark, for every `k ≥ 1`. -/
theorem wDeriv_normalizers_eq_zero {η : MarkedInner} (hη : η.IsLegal) {k : ℕ} (hk : 0 < k) :
    wDeriv (k * η.period.toNat) (normalizerRow η) = 0 ∧
    wDeriv (k * η.period.toNat) (normalizerColumn η) = 0 ∧
    wDeriv (k * η.period.toNat) (normalizerDiagonal η) = 0 := by
  have hp := hη.period_pos
  have hw := hη.2.2.1.2
  have hmul : η.period.toNat ≤ k * η.period.toNat := Nat.le_mul_of_pos_left _ hk
  have hW : span η.W ≤ k * η.period.toNat := by change η.width ≤ _; omega
  have hhat := Gluing.MarkedInner.span_hatMarkFin_le η
  have hB : span (hatMarkFin η) ≤ k * η.period.toNat := by omega
  have hmid := hη.span_hatMiddleFin_lt
  have hC : span (hatMiddleFin η) ≤ k * η.period.toNat := by omega
  exact ⟨wDeriv_cellSchur_of_span_le hη.isSkew_W hW,
    wDeriv_cellSchur_of_span_le hη.isSkew_hatMarkFin hB,
    wDeriv_cellSchur_of_span_le hη.isSkew_hatMiddleFin hC⟩

end SkewMarkedFactor
